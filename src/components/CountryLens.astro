---
// "What can my country take?" — one control that works on any table whose
// entities carry a compiled gate (privileges, laws, reforms, urban rights).
//
// The gate is the same boolean-over-static-country-facts expression the
// advance planner uses (scripts/lib/triggers.py). Evaluation is three-valued
// on purpose: TRUE = yours, FALSE = another country's, null = depends on
// something you could acquire (an institution, a reform, an event). Only a
// definite FALSE is hidden, so nothing reachable is ever silently dropped.
interface Props {
  placeholder?: string;
}
const { placeholder = 'Filter by country…' } = Astro.props;
---
<div class="clens" data-clens>
  <div class="pl-picker">
    <input type="search" placeholder={placeholder} autocomplete="off" data-clens-input />
    <div class="hdr-search__results" hidden data-clens-results></div>
  </div>
  <span class="clens__state" data-clens-state></span>
  <button type="button" class="clens__clear" hidden data-clens-clear>clear</button>
</div>

<script>
  import { evalGate, baseFacts } from '../lib/facts';
  import { activeSeat, saveFacts, seatLabel, onSaveChange } from '../lib/save-store';
  type Country = { t: string; n: string; f: Record<string, any> };

  for (const lens of document.querySelectorAll<HTMLElement>('[data-clens]')) {
    const scope = lens.closest('[data-filter-scope]') || document;
    const input = lens.querySelector('input') as HTMLInputElement;
    const results = lens.querySelector('[data-clens-results]') as HTMLElement;
    const state = lens.querySelector('[data-clens-state]') as HTMLElement;
    const clear = lens.querySelector('[data-clens-clear]') as HTMLElement;
    const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;

    let data: { countries: Country[]; formables: Record<string, any> } | null = null;
    let picked: Country | null = null;
    let loading = false;

    async function load() {
      if (data || loading) return;
      loading = true;
      try {
        const res = await fetch(`${baseUrl}country-facts.json`);
        data = await res.json();
      } catch { /* offline: the picker just stays empty */ }
      loading = false;
    }

    /** Hide rows this country can never take; mark the conditional ones. */
    function apply() {
      const rows = scope.querySelectorAll<HTMLElement>('[data-row]');
      let hidden = 0, cond = 0;
      for (const row of rows) {
        row.classList.remove('row--cond');
        const raw = row.dataset.gate;
        if (!picked) { row.dataset.clensHide = ''; delete row.dataset.clensHide; continue; }
        let v: boolean | null = true;
        if (raw) {
          try { v = evalGate(JSON.parse(raw), baseFacts(saveFacts(picked.t) || picked.f), data!.formables); } catch { v = null; }
        }
        if (v === false) { row.dataset.clensHide = '1'; hidden++; }
        else { delete row.dataset.clensHide; if (v === null) { row.classList.add('row--cond'); cond++; } }
      }
      const seat = picked && activeSeat();
      state.textContent = picked
        ? `${picked.n}${seat && seat.tag === picked.t ? ` (save · ${seatLabel(seat)})` : ''}: ${rows.length - hidden} of ${rows.length}` +
          (cond ? `, ${cond} conditional` : '')
        : '';
      clear.hidden = !picked;
      // re-run the facet/search filter so the two compose
      scope.dispatchEvent(new CustomEvent('filter:refresh', { bubbles: true }));
    }

    function render() {
      const q = input.value.trim().toLowerCase();
      if (!q || !data) { results.hidden = true; return; }
      const hits = data.countries.filter((c) => c.n.toLowerCase().startsWith(q)).slice(0, 10);
      results.innerHTML = hits.map((c) =>
        `<a href="#" data-tag="${c.t}"><span>${c.n}</span><small>${c.t}</small></a>`).join('');
      results.hidden = hits.length === 0;
    }

    input.addEventListener('focus', () => { load().then(render); });
    input.addEventListener('input', () => { load().then(render); });
    results.addEventListener('click', (ev) => {
      const a = (ev.target as HTMLElement).closest('a');
      if (!a) return;
      ev.preventDefault();
      picked = data!.countries.find((c) => c.t === a.dataset.tag) || null;
      input.value = picked?.n || '';
      results.hidden = true;
      apply();
    });
    clear.addEventListener('click', () => {
      picked = null; input.value = ''; apply();
    });
    document.addEventListener('click', (ev) => {
      if (!lens.contains(ev.target as Node)) results.hidden = true;
    });

    // An imported save picks its seat by default — the lens follows it
    // until you pick something else, and follows the save toggle live.
    let seededTag: string | null = null;
    function seed() {
      const seat = activeSeat();
      if (seat && (!picked || picked.t === seededTag)) {
        load().then(() => {
          picked = data?.countries.find((c) => c.t === seat.tag) || null;
          seededTag = picked?.t || null;
          input.value = picked?.n || '';
          apply();
        });
      } else if (!seat && picked && picked.t === seededTag) {
        picked = null; seededTag = null; input.value = ''; apply();
      }
    }
    onSaveChange(seed);
    seed();
  }
</script>
