---
// Schema-driven entity table — the workhorse for every list page. Pages
// declare columns instead of hand-building <table> markup:
//
//   kind 'name'  → entity name linked to its detail page, with color swatch
//   kind 'text'  → entity.data[key] as plain text
//   kind 'num'   → entity.data[key] right-aligned mono
//   kind 'chips' → entity.data[key] (string[] or facet value) as chip row
//   kind 'facet' → entity.facets[key] prettified as a chip
//   kind 'mods'  → entity.mods (or entity.data[key]) via <Mods>
//   kind 'rich'  → entity.desc (or entity.data[key]) via <Rich>
//   kind 'pairs' → entity.data[key] = [{...label-ish, value}] as k/v list
//
// Rows emit data-search plus data-f-<facet> attributes so FilterBar works
// with zero page-specific wiring.
import Mods from './Mods.astro';
import Rich from './Rich.astro';
import Term from './Term.astro';
import { richToPlain } from '../lib/entities';

export interface Column {
  key: string;
  label: string;
  kind: 'name' | 'namePlain' | 'text' | 'num' | 'chips' | 'facet' | 'mods' | 'rich' | 'pairs' | 'refs';
}
interface Props {
  entities: any[];
  columns: Column[];
  pagePrefix: string; // route prefix for kind 'name' links, e.g. 'goods'
  csvName?: string;   // download filename (default: eu5ref-<pagePrefix>)
}
const { entities, columns, pagePrefix, csvName = `eu5ref-${pagePrefix}` } = Astro.props;
const base = import.meta.env.BASE_URL;

const pretty = (v: string) => String(v).replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

function searchText(e: any): string {
  const parts = [e.name];
  for (const v of Object.values(e.facets || {})) parts.push(String(v));
  for (const m of e.mods || []) parts.push(m.label);
  return parts.join(' ').toLowerCase();
}
function facetAttrs(e: any): Record<string, string> {
  const attrs: Record<string, string> = {};
  for (const [k, v] of Object.entries(e.facets || {})) {
    if (v != null) attrs[`data-f-${k}`] = String(v);
  }
  return attrs;
}
const cellValue = (e: any, c: Column) =>
  c.kind === 'mods' ? (e.data?.[c.key] ?? e.mods)
  : c.kind === 'rich' ? (e.data?.[c.key] ?? e.desc)
  : c.kind === 'facet' ? e.facets?.[c.key]
  : e.data?.[c.key];

// CSV projection — same column schema, flattened to plain text at build
// time (the client script only quotes, joins, and downloads).
function csvCellValue(e: any, c: Column): string {
  if (c.kind === 'name' || c.kind === 'namePlain') return e.name;
  const v = cellValue(e, c);
  if (v == null || v === '' || (Array.isArray(v) && v.length === 0)) return '';
  switch (c.kind) {
    case 'mods':
      return v.map((m: any) => `${m.value} ${m.label}`).join('; ');
    case 'rich':
      return richToPlain(v);
    case 'pairs':
      return v.map((p: any) => `${p.pop ?? p.label ?? p.k}: ${p.value}`).join('; ');
    case 'refs':
      return v.map((r: any) => r.label).join('; ');
    case 'chips':
    case 'facet':
      return (Array.isArray(v) ? v : [v]).map(pretty).join('; ');
    default:
      return String(v);
  }
}
const csvData = {
  name: csvName,
  header: columns.map((c) => c.label),
  rows: entities.map((e) => columns.map((c) => csvCellValue(e, c))),
};
---
<div class="etbl-wrap" data-etbl>
  <div class="etbl-tools">
    <button type="button" class="csv-btn" data-csv-btn title="Download the rows currently shown as CSV">⤓ CSV</button>
  </div>
  <script type="application/json" data-csv-data set:html={JSON.stringify(csvData)} />
  <div class="etbl-scroll">
  <table class="etbl">
    <thead>
      <tr>{columns.map((c) => <th>{c.label}</th>)}</tr>
    </thead>
    <tbody>
      {entities.map((e) => (
        <tr data-row data-search={searchText(e)} {...facetAttrs(e)}>
          {columns.map((c) => {
            const v = cellValue(e, c);
            const empty = v == null || (Array.isArray(v) && v.length === 0) || v === '';
            return (
              <td class={c.kind === 'num' ? 'num' : undefined}>
                {c.kind === 'name' || c.kind === 'namePlain' ? (
                  <Fragment>
                    {c.kind === 'name' ? (
                      <a class="ename" href={`${base}${pagePrefix}/${e.slug}`}>
                        {e.icon ? (
                          <img class="eicon" src={`${base}${e.icon}`} alt="" loading="lazy" width="20" height="20" />
                        ) : (
                          e.color && <span class="swatch" style={`background:${e.color}`} />
                        )}
                        {e.name}
                      </a>
                    ) : (
                      <span class="ename">
                        {e.icon ? (
                          <img class="eicon" src={`${base}${e.icon}`} alt="" loading="lazy" width="20" height="20" />
                        ) : (
                          e.color && <span class="swatch" style={`background:${e.color}`} />
                        )}
                        {e.name}
                      </span>
                    )}
                  </Fragment>
                ) : empty ? (
                  <span class="is-empty">—</span>
                ) : c.kind === 'mods' ? (
                  <Mods mods={v} />
                ) : c.kind === 'rich' ? (
                  <Rich tokens={v} />
                ) : c.kind === 'refs' ? (
                  <span class="refs">
                    {v.map((r: any, i: number) => <Fragment>{i > 0 && ', '}<Term id={r.id} label={r.label} /></Fragment>)}
                  </span>
                ) : c.kind === 'pairs' ? (
                  <ul class="pairs">
                    {v.map((p: any) => (
                      <li><span class="k">{p.pop ?? p.label ?? p.k}</span> <span class="v">{p.value}</span></li>
                    ))}
                  </ul>
                ) : c.kind === 'chips' || c.kind === 'facet' ? (
                  <span class="chips">
                    {(Array.isArray(v) ? v : [v]).map((x: any) => <span class="chip">{pretty(x)}</span>)}
                  </span>
                ) : (
                  String(v)
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
  </div>
</div>

<script>
  // CSV export: data was flattened at build time; here we only respect the
  // current filter (skip hidden rows), quote, and download. BOM so Excel
  // opens UTF-8 correctly.
  const csvCell = (v: string) =>
    /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;

  for (const wrap of document.querySelectorAll('[data-etbl]')) {
    const btn = wrap.querySelector('[data-csv-btn]');
    const dataEl = wrap.querySelector('[data-csv-data]');
    if (!btn || !dataEl) continue;
    btn.addEventListener('click', () => {
      const { name, header, rows } = JSON.parse(dataEl.textContent || '{}');
      const domRows = wrap.querySelectorAll<HTMLElement>('[data-row]');
      const visible = rows.filter((_: string[], i: number) => !domRows[i]?.hidden);
      if (!visible.length) return;
      const csv = '﻿' + [header, ...visible]
        .map((r: string[]) => r.map(csvCell).join(',')).join('\r\n');
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  }
</script>
