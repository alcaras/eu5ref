---
// Schema-driven entity table — the workhorse for every list page. Pages
// declare columns instead of hand-building <table> markup:
//
//   kind 'name'  → entity name linked to its detail page, with color swatch
//   kind 'text'  → entity.data[key] as plain text
//   kind 'num'   → entity.data[key] right-aligned mono
//   kind 'chips' → entity.data[key] (string[] or facet value) as chip row
//   kind 'facet' → entity.facets[key] prettified as a chip
//   kind 'mods'  → entity.mods (or entity.data[key]) via <Mods>
//   kind 'rich'  → entity.desc (or entity.data[key]) via <Rich>
//   kind 'pairs' → entity.data[key] = [{...label-ish, value}] as k/v list
//   kind 'refs'  → entity.data[key] = [{id,label}] as linked <Term>s
//
// Rows emit data-f-<facet> attributes so FilterBar works with zero
// page-specific wiring; free-text search reads the row's own text (a
// data-search attribute would duplicate every cell into the HTML, which on
// the 7,500-row events page cost megabytes).
import Mods from './Mods.astro';
import Rich from './Rich.astro';
import Term from './Term.astro';

export interface Column {
  key: string;
  label: string;
  kind: 'name' | 'namePlain' | 'text' | 'num' | 'chips' | 'facet' | 'mods' | 'rich' | 'pairs' | 'refs';
}
interface Props {
  entities: any[];
  columns: Column[];
  pagePrefix: string; // route prefix for kind 'name' links, e.g. 'goods'
  csvName?: string;   // download filename (default: eu5ref-<pagePrefix>)
  // Column to sort by on load, e.g. {key:'age', dir:'asc'}
  defaultSort?: { key: string; dir?: 'asc' | 'desc' };
  // Columns whose values have a meaningful order that is not alphabetical
  // (ages run Traditions → Revolutions, not Absolutism → Revolutions).
  // key → values in order; cells get a numeric data-sort from it.
  sortOrder?: Record<string, string[]>;
}
const { entities, columns, pagePrefix, csvName = `eu5ref-${pagePrefix}`,
        defaultSort, sortOrder = {} } = Astro.props;
const base = import.meta.env.BASE_URL;

const pretty = (v: string) => String(v).replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

function facetAttrs(e: any): Record<string, string> {
  const attrs: Record<string, string> = {};
  for (const [k, v] of Object.entries(e.facets || {})) {
    if (v != null) attrs[`data-f-${k}`] = String(v);
  }
  return attrs;
}
const cellValue = (e: any, c: Column) =>
  c.kind === 'mods' ? (e.data?.[c.key] ?? e.mods)
  : c.kind === 'rich' ? (e.data?.[c.key] ?? e.desc)
  : c.kind === 'facet' ? e.facets?.[c.key]
  : e.data?.[c.key];

/** Explicit sort rank for a cell whose column declares a custom order. */
function sortRank(e: any, c: Column): number | undefined {
  const order = sortOrder[c.key];
  if (!order) return undefined;
  const v = cellValue(e, c);
  const i = order.indexOf(Array.isArray(v) ? v[0] : (v as string));
  return i === -1 ? order.length : i;
}
const defaultSortIx = defaultSort
  ? columns.findIndex((c) => c.key === defaultSort.key)
  : -1;

---
<div class="etbl-wrap" data-etbl data-default-sort={defaultSortIx >= 0 ? String(defaultSortIx) : undefined} data-default-dir={defaultSort?.dir || 'asc'}>
  <div class="etbl-tools">
    <button type="button" class="csv-btn" data-csv-btn data-csv-name={csvName}
            title="Download the rows currently shown as CSV">⤓ CSV</button>
  </div>
  <div class="etbl-scroll">
  <table class="etbl">
    <thead>
      <tr>{columns.map((c, i) => (
        <th data-sort-col={i} tabindex="0" role="button"
            class={i === defaultSortIx ? `sorted-${defaultSort?.dir || 'asc'}` : undefined}>
          {c.label}<span class="sort-caret"></span>
        </th>
      ))}</tr>
    </thead>
    <tbody>
      {entities.map((e) => (
        <tr data-row {...facetAttrs(e)}>
          {columns.map((c) => {
            const v = cellValue(e, c);
            const empty = v == null || (Array.isArray(v) && v.length === 0) || v === '';
            const rank = sortRank(e, c);
            return (
              <td class={c.kind === 'num' ? 'num' : undefined}
                  data-sort={rank === undefined ? undefined : String(rank)}>
                {c.kind === 'name' || c.kind === 'namePlain' ? (
                  <Fragment>
                    {c.kind === 'name' ? (
                      <a class="ename" href={`${base}${pagePrefix}/${e.slug}`}>
                        {e.icon ? (
                          <img class="eicon" src={`${base}${e.icon}`} alt="" loading="lazy" width="20" height="20" />
                        ) : (
                          e.color && <span class="swatch" style={`background:${e.color}`} />
                        )}
                        {e.name}
                      </a>
                    ) : (
                      <span class="ename">
                        {e.icon ? (
                          <img class="eicon" src={`${base}${e.icon}`} alt="" loading="lazy" width="20" height="20" />
                        ) : (
                          e.color && <span class="swatch" style={`background:${e.color}`} />
                        )}
                        {e.name}
                      </span>
                    )}
                  </Fragment>
                ) : empty ? (
                  <span class="is-empty">—</span>
                ) : c.kind === 'mods' ? (
                  <Mods mods={v} />
                ) : c.kind === 'rich' ? (
                  <Rich tokens={v} />
                ) : c.kind === 'refs' ? (
                  <span class="refs">
                    {v.map((r: any, i: number) => <Fragment>{i > 0 && ', '}<Term id={r.id} label={r.label} /></Fragment>)}
                  </span>
                ) : c.kind === 'pairs' ? (
                  <ul class="pairs">
                    {v.map((p: any) => (
                      <li><span class="k">{p.pop ?? p.label ?? p.k}</span> <span class="v">{p.value}</span></li>
                    ))}
                  </ul>
                ) : c.kind === 'chips' || c.kind === 'facet' ? (
                  <span class="chips">
                    {(Array.isArray(v) ? v : [v]).map((x: any) => <span class="chip">{pretty(x)}</span>)}
                  </span>
                ) : (
                  String(v)
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
  </div>
</div>

<script>
  // Click any header to sort. Cells may carry an explicit data-sort rank for
  // columns whose order is not alphabetical (ages); otherwise we sort
  // numerically when the whole column parses as numbers, else by text.
  // Blanks always sink, in both directions — an empty cell is never what
  // someone is sorting toward.
  function wireSort(wrap: Element) {
    const table = wrap.querySelector('table.etbl') as HTMLElement | null;
    const body = wrap.querySelector('tbody') as HTMLElement | null;
    if (!table || !body) return;
    const heads = [...wrap.querySelectorAll<HTMLElement>('th[data-sort-col]')];
    const txt = (el: Element) => (el.textContent || '').replace(/\s+/g, ' ').trim();

    const sortBy = (ix: number, dir: 'asc' | 'desc') => {
      const rows = [...body.querySelectorAll<HTMLElement>('tr')];
      const keyed = rows.map((tr, i) => {
        const td = tr.children[ix] as HTMLElement | undefined;
        const explicit = td?.dataset.sort;
        const raw = td ? txt(td) : '';
        const blank = raw === '' || raw === '—';
        let k: number | string;
        if (explicit !== undefined) k = Number(explicit);
        else {
          const n = Number(raw.replace(/[, ]/g, ''));
          k = raw !== '' && !Number.isNaN(n) ? n : raw.toLowerCase();
        }
        return { tr, k, blank, i };
      });
      const mul = dir === 'asc' ? 1 : -1;
      keyed.sort((a, b) => {
        if (a.blank && b.blank) return a.i - b.i;
        if (a.blank) return 1;
        if (b.blank) return -1;
        if (typeof a.k === 'number' && typeof b.k === 'number') {
          return (a.k - b.k) * mul || a.i - b.i;
        }
        return String(a.k).localeCompare(String(b.k), undefined,
          { numeric: true, sensitivity: 'base' }) * mul || a.i - b.i;
      });
      const frag = document.createDocumentFragment();
      for (const r of keyed) frag.appendChild(r.tr);
      body.appendChild(frag);
      for (const h of heads) h.classList.remove('sorted-asc', 'sorted-desc');
      heads[ix]?.classList.add(`sorted-${dir}`);
    };

    heads.forEach((th, ix) => {
      const run = () => {
        const dir = th.classList.contains('sorted-asc') ? 'desc' : 'asc';
        sortBy(ix, dir);
      };
      th.addEventListener('click', run);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); run(); }
      });
    });

    const ds = (wrap as HTMLElement).dataset.defaultSort;
    if (ds !== undefined) {
      sortBy(Number(ds), ((wrap as HTMLElement).dataset.defaultDir as 'asc' | 'desc') || 'asc');
    }
  }
  for (const wrap of document.querySelectorAll('[data-etbl]')) wireSort(wrap);

  // CSV export reads the rendered table rather than a duplicate JSON copy —
  // on a 7,500-row page that copy doubled the HTML. Cell text is what the
  // reader sees; hidden (filtered-out) rows are skipped. BOM so Excel opens
  // UTF-8 correctly.
  const csvCell = (v: string) =>
    /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
  const cellText = (el: Element) =>
    (el.textContent || '').replace(/\s+/g, ' ').trim();

  for (const wrap of document.querySelectorAll('[data-etbl]')) {
    const btn = wrap.querySelector('[data-csv-btn]') as HTMLElement | null;
    if (!btn) continue;
    btn.addEventListener('click', () => {
      const name = btn.dataset.csvName || 'eu5ref';
      const header = [...wrap.querySelectorAll('thead th')].map(cellText);
      const visible = [...wrap.querySelectorAll<HTMLElement>('[data-row]')]
        .filter((tr) => !tr.hidden)
        .map((tr) => [...tr.children].map((td) => {
          const t = cellText(td);
          return t === '—' ? '' : t;
        }));
      if (!visible.length) return;
      const csv = '﻿' + [header, ...visible]
        .map((r: string[]) => r.map(csvCell).join(',')).join('\r\n');
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  }
</script>
