---
import '../styles/theme.css';
import patch from '../../data/patch.json';
import { TABS, SECTIONS } from '../data/tabs';

interface Props {
  title: string;
  active?: string;
  eyebrow?: string;
  pageMark?: string;
  iconSrc?: string;   // web-relative game icon (img/...) shown before the title
  pageStats?: { label: string; value: string | number }[];
  description?: string;
}
const { title, active, eyebrow, pageMark, iconSrc, pageStats, description } = Astro.props;
const base = import.meta.env.BASE_URL;

const SITE_NAME = 'EU5 Reference';
const DEFAULT_DESC =
  "Reference for Paradox's Europa Universalis V — goods, advances, laws, buildings, countries, and game concepts, generated from the game's own data files each patch.";
const pageDesc = description || DEFAULT_DESC;
const fullTitle = `${title} · ${SITE_NAME}`;

const siteOrigin = Astro.site?.origin || 'https://alcaras.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;

// Nav = built tabs grouped into section dropdowns; single-tab sections
// render as plain links (same source of truth as the home catalog).
const navSections = SECTIONS
  .map((section) => ({
    section,
    items: TABS.filter((t) => t.section === section && t.status === 'built'),
  }))
  .filter((s) => s.items.length > 0);
const activeSection = navSections.find((s) => s.items.some((t) => t.slug === active))?.section;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌍</text></svg>`} />
    <meta name="theme-color" content="#141822" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <span class="site-title"><a href={base}>EU5 Reference</a></span>
        <nav class="site-nav">
          {navSections.map((s) =>
            s.items.length === 1 ? (
              <a href={`${base}${s.items[0].slug}`} class={active === s.items[0].slug ? 'active' : undefined}>
                {s.items[0].label}
              </a>
            ) : (
              <div class={`navsec ${activeSection === s.section ? 'navsec--active' : ''}`}>
                <span class="navsec__label">{s.section} ▾</span>
                <div class="navdrop">
                  {s.items.map((t) => (
                    <a href={`${base}${t.slug}`} class={active === t.slug ? 'active' : undefined}>
                      {t.icon} {t.label}
                    </a>
                  ))}
                </div>
              </div>
            )
          )}
        </nav>
        <div class="hdr-search" data-hdr-search>
          <input type="search" placeholder="Search… ( / )" autocomplete="off" />
          <div class="hdr-search__results" hidden></div>
        </div>
      </div>
    </header>

    <script>
      // Global entity search: lazy-fetch the index on first focus, filter,
      // navigate on click/Enter. "/" focuses from anywhere.
      const wrap = document.querySelector('[data-hdr-search]');
      if (wrap) {
        const input = wrap.querySelector('input')!;
        const results = wrap.querySelector('.hdr-search__results') as HTMLElement;
        const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;
        let index: [string, string, string][] | null = null;
        let loading = false;

        async function load() {
          if (index || loading) return;
          loading = true;
          try {
            const res = await fetch(`${baseUrl}search.json`);
            index = await res.json();
          } catch { loading = false; }
        }
        function render() {
          const q = input.value.trim().toLowerCase();
          if (!q || !index) { results.hidden = true; return; }
          const starts: any[] = [], contains: any[] = [];
          for (const row of index) {
            const n = row[0].toLowerCase();
            if (n.startsWith(q)) starts.push(row);
            else if (n.includes(q)) contains.push(row);
            if (starts.length > 12) break;
          }
          const hits = starts.concat(contains).slice(0, 12);
          results.innerHTML = hits.map((r) =>
            `<a href="${baseUrl}${r[1]}"><span>${r[0]}</span><small>${r[2]}</small></a>`).join('');
          results.hidden = hits.length === 0;
        }
        input.addEventListener('focus', () => { load().then(render); });
        input.addEventListener('input', render);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const first = results.querySelector('a');
            if (first) (first as HTMLAnchorElement).click();
          }
          if (e.key === 'Escape') { results.hidden = true; input.blur(); }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input &&
              !(document.activeElement instanceof HTMLInputElement)) {
            e.preventDefault();
            input.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target as Node)) results.hidden = true;
        });
      }
    </script>

    <main class="wrap">
      {(title || pageStats) && (
        <div class="page-meta">
          {eyebrow && <div class="eyebrow">{eyebrow}</div>}
          <h1 class="page-title">{iconSrc ? <img class="eicon eicon--title" src={`${base}${iconSrc}`} alt="" /> : pageMark && `${pageMark} `}{title}</h1>
          {pageStats && (
            <div class="page-stats">
              {pageStats.map((s) => (
                <span class="stat-pill"><b>{s.value}</b> {s.label}</span>
              ))}
            </div>
          )}
        </div>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="mono">EU5 {patch.version}</span>
        <span>data generated from the game's own files</span>
        <a href="https://github.com/alcaras/eu5ref">github.com/alcaras/eu5ref</a>
      </div>
    </footer>
  </body>
</html>
