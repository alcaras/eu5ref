---
import '../styles/theme.css';
import patch from '../../data/patch.json';
import { TABS, SECTIONS } from '../data/tabs';

interface Props {
  title: string;
  active?: string;
  eyebrow?: string;
  pageMark?: string;
  iconSrc?: string;   // web-relative game icon (img/...) shown before the title
  pageStats?: { label: string; value: string | number }[];
  description?: string;
  wide?: boolean;     // tools that want the whole viewport (the planner's trees)
}
const { title, active, eyebrow, pageMark, iconSrc, pageStats, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const SITE_NAME = 'EU5 Reference';
const DEFAULT_DESC =
  "Reference for Paradox's Europa Universalis V — goods, advances, laws, buildings, countries, and game concepts, generated from the game's own data files each patch.";
const pageDesc = description || DEFAULT_DESC;
const fullTitle = `${title} · ${SITE_NAME}`;

const siteOrigin = Astro.site?.origin || 'https://alcaras.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;

// Nav = built tabs grouped into section dropdowns; single-tab sections
// render as plain links (same source of truth as the home catalog).
const navSections = SECTIONS
  .map((section) => ({
    section,
    items: TABS.filter((t) => t.section === section && t.status === 'built'),
  }))
  .filter((s) => s.items.length > 0);
const activeSection = navSections.find((s) => s.items.some((t) => t.slug === active))?.section;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌍</text></svg>`} />
    <meta name="theme-color" content="#141822" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <span class="site-title"><a href={base}>EU5 Reference</a></span>
        <button type="button" class="nav-toggle" data-nav-toggle
                aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
        <nav class="site-nav" id="site-nav">
          {navSections.map((s) =>
            s.items.length === 1 ? (
              <a href={`${base}${s.items[0].slug}`} class={active === s.items[0].slug ? 'active' : undefined}>
                {s.items[0].label}
              </a>
            ) : (
              <div class={`navsec ${activeSection === s.section ? 'navsec--active' : ''}`}>
                <button type="button" class="navsec__label" aria-expanded="false">{s.section} ▾</button>
                <div class="navdrop">
                  {s.items.map((t) => (
                    <a href={`${base}${t.slug}`} class={active === t.slug ? 'active' : undefined}>
                      {t.icon} {t.label}
                    </a>
                  ))}
                </div>
              </div>
            )
          )}
        </nav>
        <div class="hdr-search" data-hdr-search>
          <input type="search" placeholder="Search… ( / )" autocomplete="off" />
          <div class="hdr-search__results" hidden></div>
        </div>
        <div class="hdr-save" data-hdr-save>
          <button type="button" class="hdr-save__btn" data-save-btn aria-expanded="false"
                  title="Your save: import a melted .eu5 and the planners start from it">
            <span class="hdr-save__icon">▤</span><span class="hdr-save__label" data-save-label>Save</span>
          </button>
          <div class="hdr-save__panel" data-save-panel hidden>
            <div class="hdr-save__status" data-save-status></div>
            <div class="hdr-save__seat" data-save-seat hidden>
              <label>Playing as <select data-save-seat-select></select></label>
              <label class="hdr-save__use"><input type="checkbox" data-save-enabled /> Use as my default</label>
              <button type="button" class="hdr-save__forget" data-save-forget>Forget this save</button>
            </div>
            <label class="hdr-save__file">
              <input type="file" accept=".eu5,.txt" data-save-file />
              <span data-save-file-label>Import a melted save…</span>
            </label>
            <div class="hdr-save__hint">
              Melt the <code>.eu5</code> first (pdx.tools → Melt) — the game's own saves are
              compressed. It is read here in your browser; nothing is uploaded, and the
              snapshot stays in this browser only. Links you share never carry it.
            </div>
            <div class="hdr-save__err" data-save-err hidden></div>
          </div>
        </div>
      </div>
    </header>

    <script>
      // The save rail: import a melted .eu5, keep a compact snapshot in
      // localStorage, and let every planner start from it (src/lib/save-store).
      import { scanFile, resolve } from '../lib/save-import';
      import { loadSnapshot, loadPref, storeSnapshot, clearSnapshot, setPref, onSaveChange } from '../lib/save-store';
      const rail = document.querySelector('[data-hdr-save]') as HTMLElement | null;
      if (rail) {
        const q = (s: string) => rail.querySelector(s) as HTMLElement;
        const btn = q('[data-save-btn]'), panel = q('[data-save-panel]');
        const status = q('[data-save-status]'), seatBox = q('[data-save-seat]');
        const seatSel = q('[data-save-seat-select]') as HTMLSelectElement;
        const enabled = q('[data-save-enabled]') as HTMLInputElement;
        const fileIn = q('[data-save-file]') as HTMLInputElement;
        const fileLabel = q('[data-save-file-label]'), err = q('[data-save-err]');
        const label = q('[data-save-label]');
        const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;
        const esc = (t: string) => String(t).replace(/[&<>"]/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);

        function render() {
          const snap = loadSnapshot(), pref = loadPref();
          err.hidden = true;
          if (!snap) {
            status.textContent = 'No save imported. Planners start from the 1337 setup.';
            seatBox.hidden = true;
            label.textContent = 'Save';
            rail.classList.remove('on', 'off');
            return;
          }
          const seats = Object.values(snap.seats);
          const tag = pref.seat && snap.seats[pref.seat] ? pref.seat : seats[0]?.tag;
          const year = (snap.date || '').split('.')[0];
          status.innerHTML = `<b>${esc(snap.file)}</b> — ${esc(snap.date || '?')} · v${esc(snap.version || '?')}` +
            ` · ${snap.counts.countries} countries` +
            (snap.version && !/^1\.3\./.test(snap.version) ? ` <span class="warn">(site data is 1.3.11)</span>` : '');
          seatSel.innerHTML = seats.map((s) =>
            `<option value="${esc(s.tag)}"${s.tag === tag ? ' selected' : ''}>${esc(s.name)}${s.player ? ` (${esc(s.player)})` : ''}</option>`).join('');
          enabled.checked = pref.enabled;
          seatBox.hidden = false;
          const seat = tag ? snap.seats[tag] : null;
          label.textContent = seat ? `${seat.name}${year ? ' · ' + year : ''}` : 'Save';
          rail.classList.toggle('on', pref.enabled);
          rail.classList.toggle('off', !pref.enabled);
        }

        btn.addEventListener('click', () => {
          panel.hidden = !panel.hidden;
          btn.setAttribute('aria-expanded', String(!panel.hidden));
        });
        document.addEventListener('click', (e) => {
          if (!rail.contains(e.target as Node)) { panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
        });
        seatSel.addEventListener('change', () => setPref({ seat: seatSel.value }));
        enabled.addEventListener('change', () => setPref({ enabled: enabled.checked }));
        q('[data-save-forget]').addEventListener('click', () => { clearSnapshot(); });

        fileIn.addEventListener('change', async () => {
          const file = fileIn.files?.[0];
          if (!file) return;
          err.hidden = true;
          fileLabel.textContent = 'Reading…';
          try {
            const [planner, geo] = await Promise.all([
              fetch(`${baseUrl}planner.json`).then((r) => r.json()),
              fetch(`${baseUrl}geo.json`).then((r) => r.json()).catch(() => null),
            ]);
            const raw = await scanFile(file, (f) => { fileLabel.textContent = `Reading… ${Math.round(f * 100)}%`; });
            if (!raw.countries.size) throw new Error('No countries found — is this a melted EU5 save?');
            const names: Record<string, string> = {};
            for (const c of planner.countries || []) names[c.t] = c.n;
            const snap = resolve(raw, file.name.replace(/_melted|\.eu5$|\.txt$/g, ''), planner.kinds || [], geo, names);
            if (!Object.keys(snap.seats).length) throw new Error('No played country found in the save.');
            storeSnapshot(snap);
          } catch (e: any) {
            err.textContent = /quota/i.test(String(e?.name || e?.message)) ?
              'The browser refused to store the snapshot (storage quota).' : `Import failed: ${e?.message || e}`;
            err.hidden = false;
          } finally {
            fileLabel.textContent = 'Import a melted save…';
            fileIn.value = '';
          }
        });

        onSaveChange(render);
        render();
      }
    </script>

    <script>
      // Nav on touch/narrow screens: the dropdowns are hover-only in CSS,
      // which leaves a phone with every section expanded and no way to
      // collapse them. The hamburger opens the nav; tapping a section
      // heading opens just that section.
      {
        const toggle = document.querySelector('[data-nav-toggle]');
        const nav = document.getElementById('site-nav');
        toggle?.addEventListener('click', () => {
          const open = nav!.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        for (const label of document.querySelectorAll<HTMLElement>('.navsec__label')) {
          label.addEventListener('click', () => {
            const sec = label.parentElement!;
            const open = !sec.classList.contains('open');
            for (const other of document.querySelectorAll('.navsec.open')) {
              other.classList.remove('open');
              other.querySelector('.navsec__label')?.setAttribute('aria-expanded', 'false');
            }
            sec.classList.toggle('open', open);
            label.setAttribute('aria-expanded', String(open));
          });
        }
        document.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('.navsec')) {
            for (const other of document.querySelectorAll('.navsec.open')) {
              other.classList.remove('open');
              other.querySelector('.navsec__label')?.setAttribute('aria-expanded', 'false');
            }
          }
        });
      }

      // Global entity search: lazy-fetch the index on first focus, filter,
      // navigate on click/Enter. "/" focuses from anywhere.
      const wrap = document.querySelector('[data-hdr-search]');
      if (wrap) {
        const input = wrap.querySelector('input')!;
        const results = wrap.querySelector('.hdr-search__results') as HTMLElement;
        const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;
        let index: [string, string, string][] | null = null;
        let loading = false;

        async function load() {
          if (index || loading) return;
          loading = true;
          try {
            const res = await fetch(`${baseUrl}search.json`);
            index = await res.json();
          } catch { loading = false; }
        }
        function render() {
          const q = input.value.trim().toLowerCase();
          if (!q || !index) { results.hidden = true; return; }
          const starts: any[] = [], contains: any[] = [];
          for (const row of index) {
            const n = row[0].toLowerCase();
            if (n.startsWith(q)) starts.push(row);
            else if (n.includes(q)) contains.push(row);
            if (starts.length > 12) break;
          }
          const hits = starts.concat(contains).slice(0, 12);
          results.innerHTML = hits.map((r) =>
            `<a href="${baseUrl}${r[1]}" data-kind="${r[2]}"><span>${r[0]}</span><small>${r[2]}</small></a>`).join('');
          results.hidden = hits.length === 0;
        }
        input.addEventListener('focus', () => { load().then(render); });
        input.addEventListener('input', render);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const first = results.querySelector('a');
            if (first) (first as HTMLAnchorElement).click();
          }
          if (e.key === 'Escape') { results.hidden = true; input.blur(); }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input &&
              !(document.activeElement instanceof HTMLInputElement)) {
            e.preventDefault();
            input.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target as Node)) results.hidden = true;
        });
      }
    </script>

    <main class:list={["wrap", { wide }]}>
      {(title || pageStats) && (
        <div class="page-meta">
          {eyebrow && <div class="eyebrow">{eyebrow}</div>}
          <h1 class="page-title">{iconSrc ? <img class="eicon eicon--title" src={`${base}${iconSrc}`} alt="" /> : pageMark && `${pageMark} `}{title}</h1>
          {pageStats && (
            <div class="page-stats">
              {pageStats.map((s) => (
                <span class="stat-pill"><b>{s.value}</b> {s.label}</span>
              ))}
            </div>
          )}
        </div>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="mono">EU5 {patch.version}</span>
        <span>data generated from the game's own files</span>
        <a href="https://github.com/alcaras/eu5ref">github.com/alcaras/eu5ref</a>
      </div>
    </footer>
  </body>
</html>
