---
import Base from '../layouts/Base.astro';
---
<Base title="Value Path" active="value-path" pageMark="🧗" eyebrow="Tools"
  description="Your societal-value targets as an age-by-age checklist: what to enact, grant and research in each age, with every axis drifting at once.">

  <p style="max-width: 820px; color: var(--text-soft);">
    A societal value drifts toward an equilibrium set by what pushes it:
    <b>it stalls at 100 × your net monthly push</b>
    (<code>SOCIETAL_VALUE_INERTIA_SCALE</code>, confirmed by player testing) —
    0.4/month carries you to ±40 and no further, and the pole needs a full
    1.0/month, held the whole way. Every axis drifts <em>at the same time</em>
    under whatever you run, so this plans one running setup per age: list the
    positions you want (the order is their priority when tools conflict) and
    read the result the way you play it — age by age, "do these things now",
    then the next age opens and the list grows.
  </p>
  <p style="max-width: 820px; color: var(--text-dim); font-size: 13px;">
    <b>What banks and what doesn't.</b> A reform whose requirement is a
    <code>societal_values</code> focus block needs the value at
    <b>50 toward its pole and is removed when that stops being true</b> —
    keeping it costs 0.5/month on that axis forever. Only reforms whose value
    requirement sits in <code>allow</code> appear to survive drifting back
    (verify in game). Laws and privileges push only while you run them — and
    since granting <em>and</em> revoking privileges both burn estate
    satisfaction, this plan grants once and avoids swapping them back and
    forth; a revoke it cannot avoid is flagged as the cost it is.
  </p>

  <div class="vp-controls">
    <div class="pl-picker" data-pp-country>
      <input type="search" placeholder="Pick a country…" autocomplete="off" />
      <div class="hdr-search__results" hidden></div>
    </div>
    <label class="pl-toggle">government
      <select data-pp-gov></select>
    </label>
    <label class="pl-toggle" title="How efficient the cabinet member you put on Encourage Societal Value is — base push is 1.0/month × this. Skill, crown power and council reforms drive it; 0.3–0.6 is typical.">
      cabinet eff. <input type="number" data-pp-eff value="0.4" min="0" max="1" step="0.05" style="width:56px;" />
    </label>
    <label class="pl-toggle" title="How many NEW estate privileges to grant per age. The real bound is estate satisfaction (−3 per grant), which the files cannot price.">
      new privs/age <input type="number" data-pp-pb value="4" min="0" max="12" step="1" style="width:48px;" />
    </label>
    <label class="pl-toggle" title="How many NEW government reforms to take per age. Reforms are permanent and implement over years — pace them honestly.">
      new reforms/age <input type="number" data-pp-rb value="3" min="0" max="10" step="1" style="width:48px;" />
    </label>
    <span class="chips" data-pp-context></span>
    <span class="pl-spacer"></span>
    <button type="button" class="csv-btn" data-pp-example>⤵ Load example path</button>
    <button type="button" class="csv-btn" data-pp-order>✦ Best order</button>
    <button type="button" class="csv-btn" data-pp-copy>⧉ Copy link</button>
    <button type="button" class="csv-btn" data-pp-clear>✕ Clear</button>
  </div>

  <div class="pp-add vp-controls">
    <select data-pp-axis></select>
    <select data-pp-goal>
      <option value="right">→ push right</option>
      <option value="left">← push left</option>
      <option value="auto">⇄ hold at a value</option>
    </select>
    <label style="font-size:12.5px; color:var(--text-dim);">
      until <input type="number" data-pp-at value="" placeholder="max" step="5" min="-100" max="100"
        style="width:64px;" /> <span style="color:var(--text-faint);">blank = as far as the push can carry it · 50 is what focus reforms need</span>
    </label>
    <button type="button" class="csv-btn" data-pp-push>+ Add target</button>
  </div>

  <div data-pp-path></div>
  <div data-pp-out></div>

  <script>
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;
    const esc = (t: any) => String(t).replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);

    const START_YEAR = 1337;
    const END_YEAR = 1837;          // the campaign's own horizon
    const GOVS = [['monarchy', 'Monarchy'], ['republic', 'Republic'],
                  ['theocracy', 'Theocracy'], ['tribe', 'Tribe'],
                  ['steppe_horde', 'Steppe Horde']];
    /** Holding "at N" tolerates the value settling this far off N. */
    const HOLD_BAND = 5;

    let D: any = null;
    let STARTS: any = {};
    let country: any = null;
    let govOverride: string | null = null;
    let cabEff = 0.4;               // Encourage push = 1.0 × this
    let privBudget = 4;             // new privileges per AGE
    let reformBudget = 3;           // new (permanent!) reforms per AGE
    /** Unverified movers the player confirmed in game ("I have this"). */
    let promoted = new Set<string>();
    /** Each target: which axis, which way, how far. Order = priority when
     *  tools conflict (the cabinet slot, a law group, collateral effects). */
    let path: { pair: string; dir: 'left' | 'right' | 'auto'; at: number | null;
                after: number | null; last: boolean; keep: boolean;
                lock: boolean }[] = [];

    const EXAMPLE: any[] = [
      ['individualism_vs_communalism', 'right', null],
      ['aristocracy_vs_plutocracy', 'auto', 0],
      ['land_vs_naval', 'right', 50],
      ['centralization_vs_decentralization', 'right', null],
      ['traditionalist_vs_innovative', 'right', null],
      ['spiritualist_vs_humanist', 'left', null],
      ['serfdom_vs_free_subjects', 'left', null],
      ['belligerent_vs_conciliatory', 'right', null],
      ['quality_vs_quantity', 'right', null],
      ['offensive_vs_defensive', 'left', null],
      ['capital_economy_vs_traditional_economy', 'right', null],
      ['centralization_vs_decentralization', 'left', null, null, true],
    ];

    const sign = (d: string) => (d === 'right' ? 1 : -1);
    const uid = (m: any) => `${m.folder}:${m.group ? m.group + '/' : ''}${m.key}`;
    const poleName = (pid: string, dir: string) => D.pairs[pid][dir].name;
    const rnd = (v: number) => Math.round(v) || 0;

    /* ---- the drift model --------------------------------------------------
     * Net push p (signed, right positive, per month) sets an equilibrium
     * E = INERTIA × p; the value moves toward E at (E − v)/INERTIA per month
     * — full speed from 0, stalling as it nears E, with the engine's
     * 0.01/month floor carrying the last point. Provenance:
     * SOCIETAL_VALUE_INERTIA_SCALE = 100,
     * societal_value_min_scaling_monthly_move = 0.01, and the community-
     * confirmed "max = 100 × monthly change" rule.
     */
    const INERTIA = () => D.inertia || 100;
    const MIN_MOVE = 0.01;
    const eqOf = (p: number) => p * INERTIA();               // NOT clamped
    const capOf = (p: number) =>
      Math.max(-100, Math.min(100, Math.round(eqOf(p))));
    function monthsTo(v0: number, T: number, p: number): number {
      if (Math.abs(T - v0) < 1e-9) return 0;
      const E = eqOf(p);
      const toward = T > v0 ? 1 : -1;
      if ((E - v0) * toward <= 0) return Infinity;
      if ((E - T) * toward < 0) return Infinity;         // beyond the cap
      const edge = E - toward;                           // where the crawl starts
      if ((E - T) * toward >= 1) {
        return INERTIA() * Math.log((E - v0) / (E - T));
      }
      const expo = (edge - v0) * toward > 0
        ? INERTIA() * Math.log(((E - v0) * toward) / 1) : 0;
      const crawlFrom = (edge - v0) * toward > 0 ? edge : v0;
      return expo + Math.abs(T - crawlFrom) / MIN_MOVE;
    }
    const after = (v0: number, p: number, m: number) => {
      const E = eqOf(p);
      const v = E + (v0 - E) * Math.exp(-m / INERTIA());
      return Math.max(-100, Math.min(100, v));
    };
    /** The furthest point this push can actually reach: the equilibrium. */
    const reachOf = (p: number) =>
      Math.max(-100, Math.min(100, eqOf(p)));
    /** One point shy of the reach — past that is a decades-long crawl. */
    const shyOf = (p: number, s: number) => {
      const E = eqOf(p);                // signed equilibrium
      const r = Math.max(-100, Math.min(100, E));
      return Math.abs(E) > 100 ? r : r - s;
    };

    /* ---- targets ---------------------------------------------------------- */

    function dirOf(st: any, from: number): 'left' | 'right' {
      if (st.dir !== 'auto') return st.dir;
      return from < (st.at ?? 0) ? 'right' : 'left';
    }

    /* ---- ages ------------------------------------------------------------ */

    const ages = () => (D.ages && D.ages.length ? D.ages
      : [{ key: 'age_1_traditions', name: 'Traditions', year: START_YEAR }]);
    const ageIdx = (key: string) => ages().findIndex((x: any) => x.key === key);
    function ageAt(year: number) {
      let a = ages()[0];
      for (const x of ages()) if (year >= x.year) a = x;
      return a;
    }
    function nextAgeYear(year: number) {
      for (const x of ages()) if (x.year > year) return x.year;
      return Infinity;
    }

    /* ---- country context ------------------------------------------------- */

    const govOf = () =>
      govOverride || (country && (STARTS[country.t] || {}).type) || null;
    const startRec = () => (country && STARTS[country.t]) || null;

    function facts(ageKey: string) {
      const a = ages().find((x: any) => x.key === ageKey);
      const year = a ? a.year : START_YEAR;
      // No country picked: identity is UNKNOWN, not "everyone at once" —
      // country-specific content must come out conditional, never confirmed.
      if (!country) return { generic: true, cap: {}, cgrp: [], gov: govOf(),
                             age: ageKey, year, io: [], parl: null,
                             laws: new Set(), privs: new Set() };
      const rec = startRec() || {};
      return { ...country.f, cap: country.f.cap || {}, gov: govOf(),
               age: ageKey, year,
               io: rec.io || [], parl: rec.parliament || null,
               laws: new Set(Object.values(rec.laws || {})),
               privs: new Set(rec.privileges || []) };
    }

    /** Three-valued gate evaluation: true / false / null (conditional).
     *  Only a definite false hides a mover; null keeps it visible but OUT of
     *  the automatic picks — the player can confirm it in game. */
    function evalGate(e: any, f: any): boolean | null {
      if (!e) return true;
      const h = e[0];
      if (h === 'and') { let u = false; for (const s of e.slice(1)) { const v = evalGate(s, f); if (v === false) return false; if (v === null) u = true; } return u ? null : true; }
      if (h === 'or') { let u = false; for (const s of e.slice(1)) { const v = evalGate(s, f); if (v === true) return true; if (v === null) u = true; } return u ? null : false; }
      if (h === 'not') { const v = evalGate(e[1], f); return v === null ? null : !v; }
      if (h === '?' || h === 'var' || h === 'policy') return null;
      if (h === 'true') return true;
      if (h === 'false') return false;
      // with no country picked, who-you-are predicates are unknowable
      if (f.generic && (h === 'tag' || h === 'cul' || h === 'cgrp' ||
          h === 'lang' || h === 'rel' || h === 'rgrp' || h === 'cap')) return null;
      if (h === 'cap') return (f.cap || {})[e[1]] === e[2];
      if (h === 'cgrp') return (f.cgrp || []).includes(e[1]);
      if (h === 'tag') return f.tag === e[1];
      if (h === 'gov') return f.gov ? f.gov === e[1] : null;
      if (h === 'age') return f.age ? f.age === e[1] : null;
      if (h === 'age>=') { const i = ageIdx(f.age), j = ageIdx(e[1]); return i < 0 || j < 0 ? null : i >= j; }
      if (h === 'adv') return null;              // research it and you have it
      if (h === 'unl') {
        const g = (D.unlockGrants || {})[e[1]];
        if (!g) return null;                     // event/mission-granted
        const v = grantAvail(g, f);
        return v === false ? false : null;       // even "yours" still needs the research
      }
      if (h === 'iotype') return false;          // an IO-scope law, never a country's
      if (h === 'iomem') return (f.io || []).includes(e[1]) ? true : null;
      if (h === 'mrep') return f.gov === 'republic' ? null : false;
      if (h === 'ctype') return false;           // playable ≠ pop/building/army
      if (h === 'law') return f.laws && f.laws.has(e[1]) ? true : null;
      if (h === 'priv') return f.privs && f.privs.has(e[1]) ? true : null;
      if (h === 'reform') return null;
      if (h === 'parl') return f.parl ? f.parl === e[1] : null;
      return f[h] === e[1];
    }

    /** Three-valued OR over the advances that hand a thing out: is any of
     *  them (a) reached by the clock and (b) possibly this country's? */
    function grantAvail(grants: any[], f: any): boolean | null {
      let some = false;
      for (const g of grants) {
        if ((f.year ?? START_YEAR) < g.year) continue;   // not in this age yet
        const v = g.gate ? evalGate(g.gate, f) : true;
        if (v === true) return true;
        if (v === null) some = true;
      }
      return some ? null : false;
    }

    /** The axis itself can be locked: three axes carry an age, the special
     *  ones an allow trigger. */
    function pairOpen(pid: string, f: any): boolean | null {
      const p = D.pairs[pid];
      if (!p) return false;
      if (p.age && f) {
        const i = ageIdx(f.age), j = ageIdx(p.age);
        if (i >= 0 && j >= 0 && i < j) return false;
      }
      if (p.gate && f) return evalGate(p.gate, f);
      return true;
    }

    function startValues(): Record<string, number> {
      const rec = startRec();
      const out: Record<string, number> = {};
      for (const pid of Object.keys(D.pairs)) out[pid] = (rec?.values || {})[pid] ?? 0;
      return out;
    }
    /** Movers the country already runs at the bookmark. */
    function running(): Set<string> {
      const rec = startRec();
      if (!rec) return new Set<string>();
      const want = new Set([...(rec.privileges || []), ...Object.values(rec.laws || {})]);
      const out = new Set<string>();
      for (const m of D.movers) if (want.has(m.key)) out.add(uid(m));
      return out;
    }

    /* ---- push ------------------------------------------------------------ */

    /** Signed sustained push toward RIGHT on one axis. Temp effects (debates,
     *  mid-implementation) are excluded; estate-power-scaled effects count
     *  at half value since the tier is unknowable from the files. */
    function signedPush(m: any, pid: string): number {
      let v = 0;
      for (const e of m.effects) {
        if (e.pair !== pid || e.temp) continue;
        v += (e.perMonth ?? 0) * (e.dir === 'right' ? 1 : -1) * (e.scaled ? 0.5 : 1);
      }
      return v * (m.encourage ? cabEff : 1);
    }
    const pushOf = (m: any, pid: string, dir: string) =>
      signedPush(m, pid) * sign(dir);
    function nudgeOf(m: any, pid: string, dir: string) {
      let v = 0;
      for (const e of m.effects) {
        if (e.pair !== pid || !e.temp) continue;
        v += (e.perMonth ?? 0) * (e.dir === dir ? 1 : -1);
      }
      return v;
    }

    const byUid = new Map<string, any>();

    /* Availability per age is cached once per country/gov/efficiency change;
       everything downstream reads only these tables. */
    let AVAIL: Record<string, Map<string, boolean | null>> = {};
    let HCACHE = new Map<string, any>();
    function buildTable() {
      AVAIL = {};
      HCACHE.clear();
      byUid.clear();
      if (!D) return;
      for (const m of D.movers) byUid.set(uid(m), m);
      for (const a of ages()) {
        const f = facts(a.key);
        const tab = new Map<string, boolean | null>();
        for (const m of D.movers) {
          let v: boolean | null = evalGate(m.gate, f);
          if (v !== false && m.unlock) {
            const gv = grantAvail(m.unlock, f);
            if (gv === false) v = false;             // no advance grants it here
            else if (gv === null && v === true) v = null;  // maybe another country's
          }
          if (v === null && promoted.has(uid(m))) v = true;
          tab.set(uid(m), v);
        }
        AVAIL[a.key] = tab;
      }
    }
    const availOf = (m: any, ageKey: string) =>
      AVAIL[ageKey] ? AVAIL[ageKey].get(uid(m)) : true;

    /** What the planner may switch on by itself: the levers the player
     *  actually pulls from the government screen. Buildings, estates,
     *  employment systems, subject types, religious aspects and the rest
     *  depend on game state the files cannot see — they are listed, not
     *  planned. */
    const AUTO_SOURCES = new Set(['laws', 'government_reforms',
                                  'estate_privileges', 'cabinet_actions']);

    /** Helpers pushing `dir` on `pid` in one age, split by certainty. */
    function helpersFor(pid: string, dir: string, ageKey: string) {
      const ck = `${pid}|${dir}|${ageKey}`;
      const hit = HCACHE.get(ck);
      if (hit) return hit;
      const sure: any[] = [], maybe: any[] = [], manual: any[] = [];
      for (const m of D.movers) {
        const p = pushOf(m, pid, dir);
        if (p <= 0) continue;
        const v = availOf(m, ageKey);
        if (v === false) continue;
        if (!AUTO_SOURCES.has(m.folder)) manual.push({ m, push: p });
        else if (v === true) sure.push({ m, push: p });
        else maybe.push({ m, push: p });
      }
      sure.sort((x, y) => y.push - x.push);
      maybe.sort((x, y) => y.push - x.push);
      manual.sort((x, y) => y.push - x.push);
      const res = { sure, maybe, manual };
      HCACHE.set(ck, res);
      return res;
    }

    /** Does any later age bring a confirmed tool for this axis that today's
     *  age does not have? While it does, an open-ended target keeps waiting;
     *  once the toolbox is final, sitting at the current cap IS done. */
    function toolsImprove(pid: string, dir: string, ageKey: string): boolean {
      const ck = `TI|${pid}|${dir}|${ageKey}`;
      const hit = HCACHE.get(ck);
      if (hit !== undefined) return hit;
      let yes = false;
      const from = ageIdx(ageKey);
      for (const a2 of ages()) {
        if (ageIdx(a2.key) <= from) continue;
        if (helpersFor(pid, dir, a2.key).sure
            .some((c: any) => availOf(c.m, ageKey) !== true)) { yes = true; break; }
      }
      HCACHE.set(ck, yes);
      return yes;
    }

    /* ---- one running configuration for every target at once ---------------
     * Everything drifts simultaneously, so each decision point picks ONE
     * setup serving the whole wish-list: holds first (kept positions decay
     * without their push), then every active target by priority. Conflicts —
     * the single cabinet slot, one-policy-per-law-group, collateral pushes,
     * privilege and reform pacing — resolve by the list's order. Privileges
     * are one-way doors: granting and revoking both burn estate
     * satisfaction, so a grant stays unless it actively fights the plan,
     * and a revoked privilege is never re-granted.
     */
    type Hold = { pair: string; lo: number; hi: number; label: string; prio: number };
    const REVOCABLE = new Set(['laws', 'estate_privileges', 'cabinet_actions']);
    const revocable = (m: any) => REVOCABLE.has(m.folder);

    function netBy(on: Set<string>, pid: string): number {
      let v = 0;
      for (const u of on) { const m = byUid.get(u); if (m) v += signedPush(m, pid); }
      return v;
    }

    function configure(active: any[], holds: Hold[], ageKey: string,
                       prevOn: Set<string>, budgets: any, revoked: Set<string>) {
      const on = new Set(prevOn);
      const adds: any[] = [];
      const drops: any[] = [];
      let cabUsed = 0, majorOn = false;
      for (const u of on) {
        const m = byUid.get(u);
        if (m?.cabinet) cabUsed++;
        if (m?.major) majorOn = true;
      }

      const weight = new Map<any, number>();
      active.forEach((t: any) => weight.set(t, 1 / (1 + t.prio)));
      /** How much a mover serves the plan: its push toward every active
       *  target, priority-weighted. Permanent movers only count for targets
       *  that will be KEPT — a hold-at or released axis must stay undoable. */
      const score = (m: any) => {
        let sc = 0;
        for (const t of active) {
          const p = pushOf(m, t.st.pair, t.dirn);
          if (!p) continue;
          if (!revocable(m) && (t.st.dir === 'auto' || !t.st.keep)) continue;
          sc += p * weight.get(t)!;
        }
        return sc;
      };

      const viol = (h: Hold, n: number) => Math.max(0, h.lo - n, n - h.hi);
      const wouldBreak = (deltaBy: Map<string, number>) => {
        for (const h of holds) {
          const d = deltaBy.get(h.pair) ?? 0;
          if (d === 0) continue;
          const n = netBy(on, h.pair);
          if (viol(h, n + d) > viol(h, n) + 1e-9) return true;
        }
        return false;
      };
      const deltaOf = (m: any, removing = false): Map<string, number> => {
        const d = new Map<string, number>();
        for (const e of m.effects) {
          if (e.temp) continue;
          const v = (e.perMonth ?? 0) * (e.dir === 'right' ? 1 : -1)
            * (m.encourage ? cabEff : 1) * (e.scaled ? 0.5 : 1) * (removing ? -1 : 1);
          d.set(e.pair, (d.get(e.pair) ?? 0) + v);
        }
        return d;
      };

      // 1. reassess what is running. Laws swap cheaply; a privilege is only
      //    revoked when it meaningfully fights the plan (and that revoke is
      //    surfaced as a cost); the cabinet member is always reassignable.
      for (const u of [...on]) {
        const m = byUid.get(u);
        if (!m || !revocable(m)) continue;
        const sc = score(m);
        if (m.cabinet) {                    // freed for reassignment below
          if (wouldBreak(deltaOf(m, true))) continue;
          on.delete(u); cabUsed--;
          continue;
        }
        const isPriv = m.source === 'Estate privilege';
        if (sc >= (isPriv ? -0.045 : -1e-9)) continue;
        if (wouldBreak(deltaOf(m, true))) continue;
        on.delete(u);
        drops.push({ m, sc, cost: isPriv });
        if (isPriv) revoked.add(u);
      }

      const tryAdd = (m: any, forHold: string | null, allowCabinet = true): boolean => {
        const u = uid(m);
        if (on.has(u)) return false;
        if (m.source === 'Estate privilege' &&
            (revoked.has(u) || budgets.priv <= 0)) return false;
        if (m.source === 'Reform' && budgets.reform <= 0) return false;
        if (m.major && majorOn) return false;      // one major reform, ever
        if (m.cabinet && (!allowCabinet || cabUsed >= 1)) return false;
        let evicted: any = null;
        if (m.group) {
          for (const u2 of on) {
            const o = byUid.get(u2);
            if (o && o.group === m.group) { evicted = o; break; }
          }
          // a law swap has to be worth the churn
          if (evicted && score(m) < score(evicted) + 0.02) return false;
        }
        const d = deltaOf(m);
        if (evicted) {
          for (const [k, v] of deltaOf(evicted, true)) d.set(k, (d.get(k) ?? 0) + v);
        }
        if (!forHold && score(m) <= 1e-9) return false;
        if (forHold && (d.get(forHold) ?? 0) === 0) return false;
        if (wouldBreak(d)) return false;
        if (evicted) {
          on.delete(uid(evicted));
          drops.push({ m: evicted, swap: true });
        }
        on.add(u);
        if (m.source === 'Estate privilege') budgets.priv--;
        if (m.source === 'Reform') budgets.reform--;
        if (m.major) majorOn = true;
        if (m.cabinet) cabUsed++;
        adds.push({ m, forHold });
        return true;
      };

      // 2. fund the holds — kept positions decay without their push
      for (const h of holds) {
        let guard = 0;
        while (guard++ < 12) {
          const n = netBy(on, h.pair);
          if (n >= h.lo - 1e-9 && n <= h.hi + 1e-9) break;
          const needDir = n < h.lo ? 'right' : 'left';
          if (n > h.hi) {
            let dropped = false;
            for (const u of [...on]) {
              const m = byUid.get(u);
              if (!m || !revocable(m) || signedPush(m, h.pair) <= 0) continue;
              if (m.source === 'Estate privilege' && score(m) > 0.045) continue;
              const d = deltaOf(m, true);
              if (wouldBreak(d)) continue;
              on.delete(u);
              if (m.cabinet) cabUsed--;
              drops.push({ m, forHold: h.pair, cost: m.source === 'Estate privilege' });
              if (m.source === 'Estate privilege') revoked.add(u);
              dropped = true;
              break;
            }
            if (dropped) continue;
          }
          const { sure } = helpersFor(h.pair, needDir, ageKey);
          let added = false;
          // the cabinet member is contested by priority, not first-come —
          // holds repair with laws/privileges here, the slot is dealt below
          for (const cand of sure) if (tryAdd(cand.m, h.pair, false)) { added = true; break; }
          if (!added) break;                       // deficit shows in the bill
        }
      }

      // 3. everything else, best score first, across ALL active targets
      const seen = new Set<string>();
      const pool: { m: any; sc: number }[] = [];
      for (const t of active) {
        for (const cand of helpersFor(t.st.pair, t.dirn, ageKey).sure) {
          const u = uid(cand.m);
          if (seen.has(u) || cand.m.cabinet) continue;
          seen.add(u);
          pool.push({ m: cand.m, sc: score(cand.m) });
        }
      }
      pool.sort((a, b) => b.sc - a.sc);
      for (const x of pool) tryAdd(x.m, null);

      // 4. the ONE cabinet slot goes to the highest-priority demand — an
      //    underfunded hold or an active target, in the list's order
      if (cabUsed < 1) {
        const demands: { prio: number; pair: string; dir: string; hold: boolean }[] = [];
        for (const h of holds) {
          const n = netBy(on, h.pair);
          if (n < h.lo - 1e-9) demands.push({ prio: h.prio ?? 0, pair: h.pair, dir: 'right', hold: true });
          else if (n > h.hi + 1e-9) demands.push({ prio: h.prio ?? 0, pair: h.pair, dir: 'left', hold: true });
        }
        for (const t of active) demands.push({ prio: t.prio, pair: t.st.pair, dir: t.dirn, hold: false });
        demands.sort((a, b) => a.prio - b.prio);
        for (const d of demands) {
          const cands = helpersFor(d.pair, d.dir, ageKey).sure.filter((c: any) => c.m.cabinet);
          let took = false;
          for (const c of cands) if (tryAdd(c.m, d.hold ? d.pair : null)) { took = true; break; }
          if (took) break;
        }
      }

      const holdRows = holds.map((h) => {
        const n = netBy(on, h.pair);
        return { ...h, net: n, ok: n >= h.lo - 1e-9 && n <= h.hi + 1e-9 };
      });
      return { on, adds, drops, holdRows,
               net: (pid: string) => netBy(on, pid) };
    }

    /* ---- the schedule: everything at once, age by age --------------------- */

    function drift(pos: Record<string, number>, on: Set<string>, months: number) {
      if (months <= 0) return;
      for (const pid of Object.keys(D.pairs)) {
        pos[pid] = after(pos[pid] ?? 0, netBy(on, pid), months);
      }
    }

    const reqOk = (q: any, x: number) => q.op === '>' ? x > q.value : q.op === '>=' ? x >= q.value
      : q.op === '<' ? x < q.value : q.op === '<=' ? x <= q.value : x === q.value;
    function crossedUnlocks(pid: string, from: number, to: number) {
      const seen = new Set<string>();
      return D.requirements.filter((r: any) =>
        !seen.has(`${r.source}:${r.key}`) && seen.add(`${r.source}:${r.key}`) &&
        r.requires.some((q: any) => q.pair === pid && reqOk(q, to) && !reqOk(q, from)));
    }

    function plan(order = path) {
      const pos = startValues();
      let on = running();
      const holds: Hold[] = [];
      const events: any[] = [];
      const revoked = new Set<string>();
      const ts = order.map((st, i) => ({
        st, prio: i, state: 'pending', from: null as number | null,
        achieved: null as number | null, doneAt: null as number | null,
        startY: null as number | null, stalled: false, axisClosed: false,
        ranOut: false, dirn: 'right' as string, goal: null as number | null,
        openBest: null as number | null, bestReach: null as number | null,
        hopeless: false,
      }));
      let year = START_YEAR;
      let curAgeKey = '';
      const budgets = { priv: privBudget, reform: reformBudget };

      const holdFrom = (t: any, v: number) => {
        // An open-ended target that ran past 50 is only HELD at 50 — that is
        // the line focus reforms live or die on; every point above it costs
        // v/100 per month forever and gates nothing. An explicit target
        // holds exactly what was asked for.
        const thr = D.focusThreshold || 50;
        const anchor = t.st.at !== null ? v
          : Math.abs(v) > thr ? thr * Math.sign(v) : v;
        const h: Hold = t.st.dir === 'auto'
          ? { pair: t.st.pair, lo: ((t.st.at ?? 0) - HOLD_BAND) / INERTIA(),
              hi: ((t.st.at ?? 0) + HOLD_BAND) / INERTIA(), prio: t.prio,
              label: `hold ${poleName(t.st.pair, (t.st.at ?? 0) >= 0 ? 'right' : 'left')} at ${rnd(t.st.at ?? 0)}` }
          : t.dirn === 'right'
            ? { pair: t.st.pair, lo: anchor / INERTIA(), hi: Infinity, prio: t.prio,
                label: `hold ${poleName(t.st.pair, 'right')} ≥ ${rnd(anchor)}${anchor !== v ? ` (reached ${rnd(v)}; above ${rnd(anchor)} gates nothing)` : ''}` }
            : { pair: t.st.pair, lo: -Infinity, hi: anchor / INERTIA(), prio: t.prio,
                label: `hold ${poleName(t.st.pair, 'left')} ≥ ${rnd(-anchor)}${anchor !== v ? ` (reached ${rnd(-v)}; beyond ${rnd(-anchor)} gates nothing)` : ''}` };
        const i = holds.findIndex((x) => x.pair === t.st.pair);
        if (i >= 0) holds.splice(i, 1);
        holds.push(h);
      };
      const complete = (t: any, v: number) => {
        t.state = 'done';
        t.achieved = v;
        t.doneAt = year;
        pos[t.st.pair] = v;
        if (t.st.keep) holdFrom(t, v);
        events.push({ type: 'done', year, age: ageAt(year).key, t,
                      unlocks: crossedUnlocks(t.st.pair, t.from ?? 0, v) });
      };

      let guard = 0;
      while (year < END_YEAR - 1e-9 && guard++ < 400) {
        const a = ageAt(year);
        const f = facts(a.key);
        if (a.key !== curAgeKey) {
          curAgeKey = a.key;
          budgets.priv = privBudget;
          budgets.reform = reformBudget;
        }

        // activate what can start now: priority order, one target per axis
        // at a time (a reversal waits for its predecessor), `last` waits for
        // everything else, `after` waits for its year
        const nonLastOpen = ts.some((t) => !t.st.last && t.state !== 'done' && t.state !== 'stalled');
        // a "last" target waits for the rest — but starts no later than the
        // final age, or an open-ended climb would strand it entirely
        const finalAge = ages()[ages().length - 1].key;
        for (const t of ts) {
          if (t.state !== 'pending') continue;
          if (t.st.last && nonLastOpen && a.key !== finalAge) continue;
          if (t.st.after && year < t.st.after - 1e-9) continue;
          const j = ts.indexOf(t);
          if (ts.some((u, k) => k < j && u.st.pair === t.st.pair &&
                                u.state !== 'done' && u.state !== 'stalled')) continue;
          const open = pairOpen(t.st.pair, f);
          if (open === false) {
            // age-gated axes just wait; a country-gated axis may never open
            if (D.pairs[t.st.pair].gate && !D.pairs[t.st.pair].age &&
                evalGate(D.pairs[t.st.pair].gate, f) === false) {
              t.state = 'stalled'; t.axisClosed = true;
              events.push({ type: 'stall', year, age: a.key, t, reason: 'axis' });
            }
            continue;
          }
          t.state = 'active';
          t.from = pos[t.st.pair] ?? 0;
          t.startY = year;
          t.dirn = dirOf(t.st, t.from);
          const i = holds.findIndex((x) => x.pair === t.st.pair);
          if (i >= 0) holds.splice(i, 1);   // this target owns the axis now
          // how far can ANY age ultimately carry this axis (for open-ended)?
          if (t.st.at === null) {
            let best: number | null = null;
            for (const a2 of ages()) {
              if (a2.year < a.year) continue;
              const cfg2 = configure([t], holds, a2.key, on, { priv: privBudget, reform: reformBudget }, new Set(revoked));
              const shy2 = shyOf(cfg2.net(t.st.pair), sign(t.dirn));
              if (best === null || (shy2 - best) * sign(t.dirn) > 0) best = shy2;
            }
            t.openBest = best;
          }
        }
        const active = ts.filter((t) => t.state === 'active');
        if (!active.length && !ts.some((t) => t.state === 'pending')) break;

        // one configuration for everything, holds funded first
        const cfg = configure(active, holds, a.key, on, budgets, revoked);
        const changedOn = [...cfg.on].filter((u) => !on.has(u));
        const changedOff = [...on].filter((u) => !cfg.on.has(u));
        on = cfg.on;
        if (changedOn.length || changedOff.length || !events.some((e) => e.type === 'config')) {
          const entry = {
            type: 'config', year, age: a.key,
            adds: cfg.adds.filter((x) => changedOn.includes(uid(x.m))),
            drops: cfg.drops.filter((x) => changedOff.includes(uid(x.m)) || x.swap),
            holdRows: cfg.holdRows,
            pushing: active.map((t) => ({
              t, net: cfg.net(t.st.pair) * sign(t.dirn),
              cap: capOf(cfg.net(t.st.pair)),
            })),
          };
          // several re-plans in the same instant read as ONE to-do list
          const prev = events[events.length - 1];
          const prev2 = events[events.length - 2];
          const mergeInto = prev && prev.type === 'config' && Math.abs(prev.year - year) < 0.09 ? prev
            : prev2 && prev2.type === 'config' && Math.abs(prev2.year - year) < 0.09 && prev?.type === 'done' ? prev2
            : null;
          if (mergeInto) {
            const addU = new Set(mergeInto.adds.map((x: any) => uid(x.m)));
            for (const x of entry.adds) if (!addU.has(uid(x.m))) mergeInto.adds.push(x);
            const dropU = new Set(mergeInto.drops.map((x: any) => uid(x.m)));
            for (const x of entry.drops) if (!dropU.has(uid(x.m))) mergeInto.drops.push(x);
            // something switched on then off again in the same instant is noise
            mergeInto.adds = mergeInto.adds.filter((x: any) => !entry.drops.some((d: any) => uid(d.m) === uid(x.m)));
            mergeInto.holdRows = entry.holdRows;
            mergeInto.pushing = entry.pushing;
          } else {
            events.push(entry);
          }
        }

        // completions at the current instant
        let completedNow = false;
        for (const t of active) {
          const v = pos[t.st.pair] ?? 0;
          const s = sign(t.dirn);
          const netS = cfg.net(t.st.pair);
          const curShy = shyOf(netS, s);
          t.goal = t.st.at !== null ? t.st.at
            : t.openBest !== null && (t.openBest - curShy) * s > 2 ? t.openBest
            : curShy;
          // an open-ended target is also done when it sits at what THIS
          // configuration can sustain and no later age adds tools for its
          // axis — waiting further would change nothing
          const settled = t.st.at === null && t.st.dir !== 'auto' &&
            (curShy - v) * s <= 0.5 && !toolsImprove(t.st.pair, t.dirn, a.key);
          if (t.st.dir === 'auto' ? Math.abs(v - (t.st.at ?? 0)) <= 0.5
                                  : (t.goal - v) * s <= 0.5 || settled) {
            complete(t, t.st.dir === 'auto' ? (t.st.at ?? 0)
                        : t.st.at !== null ? t.st.at : v);
            completedNow = true;
          }
        }
        if (completedNow) continue;              // re-plan with the freed tools

        // explicit targets no age can ever fund stall now, without
        // consuming the clock — the player sees what it would have needed
        for (const t of active) {
          if (t.st.at === null || t.hopeless) continue;
          const s = sign(t.dirn);
          if (Number.isFinite(monthsTo(pos[t.st.pair] ?? 0, t.goal!, cfg.net(t.st.pair)))) continue;
          let best = reachOf(cfg.net(t.st.pair));
          let hopeful = false;
          for (const a2 of ages()) {
            if (a2.year <= a.year) continue;
            const cfg2 = configure([t], holds, a2.key, on, { priv: privBudget, reform: reformBudget }, new Set(revoked));
            const r2 = reachOf(cfg2.net(t.st.pair));
            best = (r2 - best) * s > 0 ? r2 : best;
            if ((t.goal! - r2) * s <= 0) { hopeful = true; break; }
          }
          t.bestReach = best;
          if (!hopeful) {
            t.hopeless = true;
            t.state = 'stalled';
            t.stalled = true;
            t.achieved = pos[t.st.pair] ?? 0;
            events.push({ type: 'stall', year, age: a.key, t, reason: 'push' });
          }
        }
        if (ts.some((t) => t.state === 'stalled' && !t.axisClosed &&
                           t.doneAt === null && t.stalled && !t.reported)) {
          for (const t of ts) if (t.state === 'stalled') (t as any).reported = true;
          continue;                              // re-plan without them
        }

        // advance to the next thing that changes the plan
        let next = Math.min(nextAgeYear(year), END_YEAR);
        for (const t of active) {
          const mTo = monthsTo(pos[t.st.pair] ?? 0, t.goal!, cfg.net(t.st.pair));
          if (Number.isFinite(mTo) && mTo > 0) next = Math.min(next, year + mTo / 12);
        }
        for (const t of ts) {
          if (t.state === 'pending' && t.st.after && t.st.after > year) next = Math.min(next, t.st.after);
        }
        if (next <= year + 1e-6) next = Math.min(nextAgeYear(year), END_YEAR);
        drift(pos, on, (next - year) * 12);
        year = next;
      }

      // the campaign ends: whatever is still moving reports where it got to
      for (const t of ts) {
        if (t.state === 'active') {
          t.achieved = pos[t.st.pair] ?? 0;
          if (t.st.at !== null && (t.st.at - t.achieved) * sign(t.dirn) > 0.5) {
            t.stalled = true; t.state = 'stalled';
          } else {
            t.state = 'done'; t.doneAt = year; t.ranOut = true;
          }
        } else if (t.state === 'pending') {
          t.stalled = true; t.state = 'stalled';
          t.achieved = pos[t.st.pair] ?? 0;
        }
      }
      return { ts, events, endYear: year, revokes: revoked.size, pos };
    }

    /** What an order costs: stalls dominate, then broken holds and costly
     *  revokes, then the last finish, then how early the rest land. */
    function score(order: any[]) {
      const { ts, events, revokes } = plan(order);
      let last = START_YEAR, sum = 0, stalls = 0, broken = 0;
      for (const t of ts) {
        if (t.stalled || t.axisClosed) { stalls++; sum += END_YEAR; continue; }
        last = Math.max(last, t.doneAt ?? END_YEAR);
        sum += t.doneAt ?? END_YEAR;
      }
      for (const e of events) if (e.type === 'config') broken = Math.max(broken, e.holdRows.filter((h: any) => !h.ok).length);
      return stalls * 1e7 + broken * 1e5 + revokes * 3e3 + last * 1e3 + sum;
    }

    /** Reorder the priorities for the earliest overall finish. Locked
     *  targets keep their exact slot; `last` stays last; two targets on the
     *  same axis keep their given order (a reversal is deliberate). */
    function bestOrder() {
      const n = path.length;
      if (n < 2) return;
      const lockedAt = new Map<number, any>();
      path.forEach((st, i) => { if (st.lock) lockedAt.set(i, st); });
      const rank = new Map<any, number>();
      const seen: Record<string, number> = {};
      for (const st of path) rank.set(st, (seen[st.pair] = (seen[st.pair] ?? -1) + 1));
      const ok = (order: any[]) => {
        const last: Record<string, number> = {};
        for (let i = 0; i < order.length; i++) {
          const st = order[i];
          if (lockedAt.size && lockedAt.get(i) !== undefined && lockedAt.get(i) !== st) return false;
          if (st.lock && lockedAt.get(i) !== st) return false;
          if (st.last && order.slice(i + 1).some((x: any) => !x.last)) return false;
          const r = rank.get(st)!;
          if (r < (last[st.pair] ?? -1)) return false;
          last[st.pair] = r;
        }
        return true;
      };

      const remaining = path.filter((st) => !st.lock);
      const order: any[] = new Array(n).fill(null);
      for (const [i, st] of lockedAt) order[i] = st;
      for (let slot = 0; slot < n; slot++) {
        if (order[slot]) continue;
        let best = -1, bestScore = Infinity;
        for (let i = 0; i < remaining.length; i++) {
          const cand = order.slice();
          cand[slot] = remaining[i];
          let k = 0;
          for (let j2 = 0; j2 < n; j2++) {
            if (cand[j2]) continue;
            while (k < remaining.length && (remaining[k] === remaining[i] || cand.includes(remaining[k]))) k++;
            cand[j2] = remaining[k++] ?? remaining[i];
          }
          if (!ok(cand)) continue;
          const sc = score(cand);
          if (sc < bestScore) { bestScore = sc; best = i; }
        }
        if (best < 0) best = 0;
        order[slot] = remaining.splice(best, 1)[0];
      }

      let cur = order, curScore = score(cur);
      for (let pass = 0; pass < 3; pass++) {
        let improved = false;
        for (let i = 0; i < n; i++) {
          if (cur[i].lock) continue;
          for (let j = 0; j < n; j++) {
            if (i === j || (cur[j] && cur[j].lock)) continue;
            const cand = cur.slice();
            cand.splice(j, 0, cand.splice(i, 1)[0]);
            if (!ok(cand)) continue;
            const sc = score(cand);
            if (sc < curScore - 1e-6) { cur = cand; curScore = sc; improved = true; }
          }
        }
        if (!improved) break;
      }
      path = cur;
    }

    /* ---- rendering ------------------------------------------------------- */

    const iconHtml = (m: any) => m.icon
      ? `<img class="eicon" src="${baseUrl}${m.icon}" alt="" width="16" height="16"
         loading="lazy" style="vertical-align:-3px;border-radius:2px;" />` : '';

    const gateWhy = (m: any) => (m.gateLabels || [])
      .filter((g: any) => ['var', 'unl', 'iomem', 'adv', 'law', 'priv', 'reform', 'policy', 'parl'].includes(g[1]))
      .map((g: any) => g[0]).slice(0, 3).join(', ');

    function moverLine(h: any, pid: string | null, cls: string, opts: any = {}) {
      const m = h.m;
      const cab = m.cabinet ? `<span class="pp-cab">cabinet</span>` : '';
      const perm = m.folder === 'government_reforms'
        ? `<span class="pp-cab" title="A reform cannot be un-taken — its pushes are with you for good">permanent${m.implMonths ? ` · ${Math.round(m.implMonths / 12)}y to implement` : ''}</span>` : '';
      const scaled = m.effects.some((e: any) => e.scaled)
        ? `<span class="pp-cab" title="Scales with estate power — counted at half here">estate power</span>` : '';
      const g0 = m.unlock && m.unlock[0];
      const gift = g0
        ? `<span class="pp-need">research: ${esc(g0.advance)} · ${esc(g0.age)}` +
          `${g0.who ? ` · ${esc(g0.who)}` : ''}` +
          `${m.unlock.length > 1 ? ` +${m.unlock.length - 1} more` : ''}</span>` : '';
      const why = opts.why ? `<span class="pp-need">needs: ${esc(opts.why)}</span>` : '';
      const costTag = h.cost
        ? `<span class="pp-costly" title="Revoking a privilege burns estate satisfaction — this plan only does it because the privilege fights the targets">REVOKE — costly</span>` : '';
      const promo = opts.promote
        ? `<label class="pp-have"><input type="checkbox" data-promote="${esc(uid(m))}"${promoted.has(uid(m)) ? ' checked' : ''}/> I have this</label>` : '';
      const where = m.groupName ? esc(m.groupName) : esc(m.source);
      // signed effect summary across the axes it moves
      const eff = m.effects.filter((e: any) => !e.temp).slice(0, 3).map((e: any) =>
        `${esc(poleName(e.pair, e.dir))} +${((e.perMonth ?? 0) * (m.encourage ? cabEff : 1) * (e.scaled ? 0.5 : 1)).toFixed(2)}`).join(' · ');
      return `<div class="pp-mover ${cls}">${iconHtml(m)}` +
        `<span class="pp-mover__n">${esc(m.name)}</span>` +
        `<span class="pp-mover__s">${where}</span>${cab}${perm}${scaled}${costTag}${gift}${why}${promo}` +
        `<span class="pp-mover__p">${eff}</span></div>`;
    }

    const SOURCE_ORDER = ['Cabinet action', 'Reform', 'Estate privilege', 'Law'];
    function groupBySource(list: any[], cls: string) {
      const buckets = new Map<string, any[]>();
      for (const h of list) {
        if (!buckets.has(h.m.source)) buckets.set(h.m.source, []);
        buckets.get(h.m.source)!.push(h);
      }
      const keys = [...buckets.keys()].sort((a, b) => {
        const ia = SOURCE_ORDER.indexOf(a), ib = SOURCE_ORDER.indexOf(b);
        return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b);
      });
      return keys.map((k) =>
        `<div class="pp-kind">${esc(k)}${k === 'Law' ? ' — enact (one policy per group)'
          : k === 'Estate privilege' ? ' — grant (costs estate satisfaction; granted once, kept)'
          : k === 'Cabinet action' ? ' — assign your cabinet member'
          : k === 'Reform' ? ' — take (permanent)' : ''}</div>` +
        buckets.get(k)!.map((h) => moverLine(h, null, cls)).join('')).join('');
    }

    const goalText = (t: any) => {
      const p = D.pairs[t.st.pair];
      return t.st.dir === 'auto'
        ? `${esc(p.left.name)} / ${esc(p.right.name)} at ${t.st.at ?? 0}`
        : t.st.at === null ? `${esc(poleName(t.st.pair, t.st.dir))} — as far as it goes`
        : `${esc(poleName(t.st.pair, t.st.dir))} ${t.st.at > 0 ? '+' : ''}${t.st.at}`;
    };

    function renderPath() {
      const host = $('[data-pp-path]');
      if (!path.length) { host.innerHTML = ''; return; }
      const axisOptions = (sel: string) => Object.entries(D.pairs).map(([pid, p]: any) =>
        `<option value="${esc(pid)}"${pid === sel ? ' selected' : ''}>` +
        `${esc(p.left.name)} ←→ ${esc(p.right.name)}</option>`).join('');
      host.innerHTML =
        `<h2 class="vp-h">Your targets <small>${path.length} — order = priority when tools conflict; pin 🔒, or let “Best order” arrange the unpinned</small></h2>` +
        `<ol class="pp-path">` + path.map((st, i) => {
          const p = D.pairs[st.pair];
          return `<li class="pp-row">
            <span class="pp-num">${i + 1}</span>
            <select data-edit="pair:${i}">${axisOptions(st.pair)}</select>
            <select data-edit="dir:${i}">
              <option value="right"${st.dir === 'right' ? ' selected' : ''}>→ ${esc(p.right.name)}</option>
              <option value="left"${st.dir === 'left' ? ' selected' : ''}>← ${esc(p.left.name)}</option>
              <option value="auto"${st.dir === 'auto' ? ' selected' : ''}>⇄ hold at</option>
            </select>
            <label class="pp-until">until
              <input type="number" step="5" min="-100" max="100" placeholder="max"
                data-edit="at:${i}" value="${st.at === null ? '' : st.at}" />
            </label>
            <label class="pp-until" title="Keep this position afterwards — the plan reserves the push to hold it">
              <input type="checkbox" data-edit="keep:${i}"${st.keep ? ' checked' : ''} /> keep
            </label>
            <label class="pp-until" title="Hold off until this year, whatever else is done">
              not before <input type="number" step="10" min="1337" max="1837" placeholder="—"
                class="pp-year" data-edit="after:${i}" value="${st.after ?? ''}" />
            </label>
            <label class="pp-until" title="Start this only after every other target is done — the reversal leg">
              <input type="checkbox" data-edit="last:${i}"${st.last ? ' checked' : ''} /> last
            </label>
            <label class="pp-until" title="Pin this target to exactly this priority — Best order will not move it">
              <input type="checkbox" data-edit="lock:${i}"${st.lock ? ' checked' : ''} /> 🔒
            </label>
            <span class="pp-mv">
              <button type="button" data-mv="${i}:-1" title="Higher priority">↑</button>
              <button type="button" data-mv="${i}:1" title="Lower priority">↓</button>
              <button type="button" data-rm="${i}" title="Remove">✕</button>
            </span>
          </li>`;
        }).join('') + `</ol>`;
    }

    function render() {
      if (!D) return;
      renderContext();
      renderPath();
      if (!path.length) {
        $('[data-pp-out]').innerHTML =
          '<div class="pl-empty" style="margin-top:18px;">No targets yet — add one above, ' +
          'or load the example path.</div>';
        syncUrl();
        return;
      }
      const { ts, events, revokes } = plan();
      const rec = startRec();
      const govLabel = (GOVS.find((g) => g[0] === govOf()) || ['', 'country'])[1].toLowerCase();
      const head = country
        ? `<p class="pp-note">Starting from <b>${esc(country.n)}</b>'s 1337 setup` +
          (rec ? ` — ${Object.keys(rec.values || {}).length} axes placed, ` +
                 `${(rec.privileges || []).length} privileges and ` +
                 `${Object.keys(rec.laws || {}).length} laws already running` : '') +
          `, as a ${esc(govLabel)}.` +
          (revokes ? ` This plan revokes ${revokes} privilege${revokes > 1 ? 's' : ''} — each one costs estate satisfaction.` : ' No privilege is ever revoked.') + `</p>`
        : '<p class="pp-note">Pick a country to start from its real 1337 position, ' +
          'granted privileges and laws. Without one every axis starts at 0 and only ' +
          'generic (non-country-specific) tools are planned.</p>';

      // ---- summary: every target, where it lands, when --------------------
      const summary = `<div class="pp-summary">` + ts.map((t: any, i: number) => {
        const status = t.axisClosed
          ? `<span class="pp-bad">axis never opens for this country</span>`
          : t.stalled
            ? `<span class="pp-bad">stalls at ${rnd(t.achieved ?? 0)}${t.st.at !== null ? ` — ${t.st.at} needs ${(Math.abs(t.st.at) / 100).toFixed(2)}/mo held${t.bestReach !== null ? `; best any age manages ≈${rnd(t.bestReach)}` : ''}` : ''}</span>`
            : t.ranOut
              ? ((t.achieved ?? 0) - (t.from ?? 0)) * sign(t.dirn) < -0.5
                ? `<span class="pp-bad">slips to ${rnd(t.achieved ?? 0)} — the start position needs ${(Math.abs(t.from ?? 0) / 100).toFixed(2)}/mo just to hold, more than the plan can spare</span>`
                : `<span class="pp-when">reaches ${rnd(t.achieved ?? 0)} — campaign ends mid-push</span>`
              : `<span class="pp-ok">✓ ${rnd(t.achieved ?? 0)} by ${Math.round(t.doneAt ?? END_YEAR)}</span>`;
        return `<div class="pp-sumrow"><span class="pp-num">${i + 1}</span>` +
          `<b>${goalText(t)}</b>` +
          `<span class="pp-from">${rnd(t.from ?? (startValues()[t.st.pair] ?? 0))} →</span> ${status}` +
          (t.st.keep ? `<span class="pp-hold">kept</span>` : `<span class="pp-rel">released</span>`) +
          `</div>`;
      }).join('') + `</div>`;

      // ---- the age-by-age checklist ---------------------------------------
      const buckets = new Map<string, any[]>();
      for (const e of events) {
        if (!buckets.has(e.age)) buckets.set(e.age, []);
        buckets.get(e.age)!.push(e);
      }
      const sections = ages().filter((a: any) => buckets.has(a.key)).map((a: any) => {
        const items = buckets.get(a.key)!;
        const firstInAge = a.year <= START_YEAR;
        const body = items.map((e: any) => {
          if (e.type === 'config') {
            const adds = e.adds.filter((x: any) => !x.forHold);
            const holdAdds = e.adds.filter((x: any) => x.forHold);
            const research = [...new Set(e.adds
              .map((x: any) => x.m.unlock && x.m.unlock[0] ? x.m.unlock[0].advance : null)
              .filter(Boolean))];
            if (!e.adds.length && !e.drops.length) return '';
            return `<div class="pp-cfg">
              <div class="pp-cfg__h">${Math.round(e.year)} — ${e.year <= START_YEAR + 1e-6 ? 'set up' : 'adjust'}${research.length ? ` <span class="pp-need">research first: ${esc(research.join(' · '))}</span>` : ''}</div>` +
              (e.drops.length ? `<div class="pp-sub">Switch off</div>` +
                e.drops.map((x: any) => moverLine(x, null, x.cost ? 'drop' : 'swapoff')).join('') : '') +
              (adds.length ? `<div class="pp-sub">Switch on</div>` + groupBySource(adds, 'add') : '') +
              (holdAdds.length ? `<div class="pp-sub">Switched on to fund a held position</div>` +
                holdAdds.map((x: any) => moverLine(x, null, 'keep')).join('') : '') +
              (e.pushing.length ? `<div class="pp-net">now pushing: ` + e.pushing.map((p: any) =>
                `${esc(poleName(p.t.st.pair, p.t.dirn))} <b>${p.net > 0 ? '+' : ''}${p.net.toFixed(2)}</b>/mo (stalls at ${Math.abs(p.cap)})`).join(' · ') + `</div>` : '') +
              (e.holdRows.length ? `<div class="pp-sub">Standing bill — held positions</div>` +
                e.holdRows.map((h: any) =>
                  `<div class="pp-mover ${h.ok ? 'keep' : 'drop'}">` +
                  `<span class="pp-mover__n">${esc(h.label)}</span>` +
                  `<span class="pp-mover__s">needs ${h.lo === -Infinity ? '≤ ' + h.hi.toFixed(2) : h.hi === Infinity ? '≥ ' + h.lo.toFixed(2) : `${h.lo.toFixed(2)}…${h.hi.toFixed(2)}`}/mo</span>` +
                  (h.ok ? '' : h.net < h.lo
                    ? `<span class="pp-bad" style="font-size:11px;">UNDERFUNDED — will erode</span>`
                    : `<span class="pp-bad" style="font-size:11px;">OVERSHOOTING — permanent pushes drift it past the hold point</span>`) +
                  `<span class="pp-mover__p">${h.net > 0 ? '+' : ''}${h.net.toFixed(2)}/mo</span></div>`).join('') : '') +
            `</div>`;
          }
          if (e.type === 'done') {
            const gains = e.unlocks.length
              ? e.unlocks.map((u: any) => {
                  const hold = u.requires.some((q: any) => q.hold);
                  return `<div class="pp-mover ${hold ? 'hold' : 'bank'}">` +
                    (u.icon ? `<img class="eicon" src="${baseUrl}${u.icon}" alt="" width="16" height="16" loading="lazy" style="vertical-align:-3px;border-radius:2px;" />` : '') +
                    `<span class="pp-mover__n">${esc(u.name)}</span>` +
                    `<span class="pp-mover__s">${esc(u.source)}</span>` +
                    `<span class="pp-mover__p">${hold
                      ? `needs the value HELD at ${Math.round(Math.abs(u.requires.find((q: any) => q.hold).value))} — lost if it drops`
                      : u.source === 'Reform' ? 'allow-gated — probably banks (verify in game)'
                      : 'only while you hold this'}</span></div>`; }).join('')
              : '';
            return `<div class="pp-mile">
              <span class="pp-mile__y">${Math.round(e.year)}</span>
              <span class="pp-ok">✓ ${goalText(e.t)} reached (${rnd(e.t.achieved)})</span>
              ${e.t.st.keep ? '<span class="pp-hold">held from here on</span>' : '<span class="pp-rel">released — will drift back</span>'}
            </div>${gains}`;
          }
          if (e.type === 'stall') {
            return `<div class="pp-mile">
              <span class="pp-mile__y">${Math.round(e.year)}</span>
              <span class="pp-bad">${e.reason === 'axis'
                ? `${goalText(e.t)} — this axis never opens for this country`
                : `${goalText(e.t)} — no age can fund ${e.t.st.at}: it needs ${(Math.abs(e.t.st.at ?? 0) / 100).toFixed(2)}/mo held${e.t.bestReach !== null ? `; the best any age manages is ≈${rnd(e.t.bestReach)}` : ''}`}</span>
            </div>`;
          }
          return '';
        }).join('');

        // what this age cannot verify / cannot plan — one collapsed list each
        const activeAxes = new Map<string, string>();
        for (const e of items) {
          if (e.type !== 'config') continue;
          for (const p of e.pushing) activeAxes.set(p.t.st.pair, p.t.dirn);
        }
        const maybeAll: any[] = [], manualAll: any[] = [];
        const seenM = new Set<string>();
        for (const [pid, dirn] of activeAxes) {
          const { maybe, manual } = helpersFor(pid, dirn, a.key);
          for (const c of maybe) if (!seenM.has(uid(c.m))) { seenM.add(uid(c.m)); maybeAll.push(c); }
          for (const c of manual) if (!seenM.has(uid(c.m))) { seenM.add(uid(c.m)); manualAll.push(c); }
        }
        const maybes = maybeAll.length
          ? `<details class="pp-maybe"><summary>${maybeAll.length} more this age we cannot verify from the files — check in game</summary>` +
            maybeAll.slice(0, 16).map((h: any) => moverLine(h, null, 'temp',
              { why: gateWhy(h.m) || 'a scripted trigger', promote: true })).join('') + `</details>` : '';
        const manuals = manualAll.length
          ? `<details class="pp-maybe"><summary>${manualAll.length} other levers this age — buildings, aspects, estates, subjects (game-state dependent, not auto-planned)</summary>` +
            manualAll.slice(0, 16).map((h: any) => moverLine(h, null, 'temp')).join('') + `</details>` : '';

        return `<section class="pp-agesec">
          <h2 class="pp-ageh">${esc(a.name)} <small>${a.year}${firstInAge ? ' — game start' : ''}</small></h2>
          ${body}${maybes}${manuals}
        </section>`;
      }).join('');

      $('[data-pp-out]').innerHTML = head + summary + sections + `<p class="pp-note">
        Every axis drifts at once toward <em>100 × its net monthly push</em>
        (slowing on the way; the engine stops below 0.01/mo), so this is one
        running setup per age, not a queue of one-axis pushes. Your target
        order is the tie-breaker where tools conflict — the one cabinet
        member, one policy per law group, movers whose side-effects pull a
        higher-priority axis the wrong way. Privileges are granted at most
        ${privBudget}/age and never churned: a grant stays until it actively
        fights the plan, and a revoke is shown as the cost it is. "Kept"
        targets are billed forward — their hold shows in every age's standing
        bill. One-off nudges (parliament debates, agendas, events) can pierce
        a cap temporarily, and estate satisfaction — the real bound on
        privileges — is not in the files: the budgets above are yours to set
        honestly.
      </p>`;
      syncUrl();
    }

    function renderContext() {
      $('[data-pp-context]').innerHTML = country
        ? `<span class="chip">${esc(country.n)}</span>` +
          `<span class="chip">${esc(country.cu)}</span>` +
          `<span class="chip">${esc(country.re)}</span>`
        : '';
      const sel = $('[data-pp-gov]') as HTMLSelectElement;
      const cur = govOf();
      sel.innerHTML = GOVS.map(([k, label]) =>
        `<option value="${k}"${k === cur ? ' selected' : ''}>${label}</option>`).join('');
    }

    /* ---- url ------------------------------------------------------------- */

    function syncUrl() {
      const qs = new URLSearchParams();
      if (country) qs.set('c', country.t);
      if (govOverride) qs.set('g', govOverride);
      if (cabEff !== 0.4) qs.set('e', String(cabEff));
      if (privBudget !== 4) qs.set('b', String(privBudget));
      if (reformBudget !== 3) qs.set('r', String(reformBudget));
      if (promoted.size) qs.set('h', [...promoted].join('~'));
      if (path.length) {
        qs.set('p', path.map((s) => {
          const flags = `${s.last ? 'L' : ''}${s.keep ? '' : 'R'}${s.lock ? 'P' : ''}`;
          const tail = (s.after || flags)
            ? `:${s.at ?? ''}:${s.after ?? ''}${flags ? ':' + flags : ''}`
            : (s.at === null ? '' : ':' + s.at);
          return `${s.pair}:${s.dir}${tail}`;
        }).join(','));
      }
      history.replaceState(null, '', `${location.pathname}${qs.toString() ? '?' + qs : ''}`);
    }

    /* ---- wiring ---------------------------------------------------------- */

    function wirePicker(sel: string, search: (q: string) => any[], onPick: (k: string) => void) {
      const wrap = $(sel);
      const input = wrap.querySelector('input') as HTMLInputElement;
      const results = wrap.querySelector('.hdr-search__results') as HTMLElement;
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { results.hidden = true; return; }
        const hits = search(q).slice(0, 12);
        results.innerHTML = hits.map((h) =>
          `<a href="#" data-key="${esc(h.key)}"><span>${esc(h.label)}</span>` +
          `<small>${esc(h.small)}</small></a>`).join('') || '<div class="pl-empty">No match.</div>';
        results.hidden = false;
      });
      results.addEventListener('click', (e) => {
        e.preventDefault();
        const a = (e.target as HTMLElement).closest('[data-key]') as HTMLElement | null;
        if (!a) return;
        onPick(a.dataset.key!);
        input.value = ''; results.hidden = true;
        render();
      });
      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) results.hidden = true;
      });
    }

    Promise.all([
      fetch(`${baseUrl}values.json`).then((r) => r.json()),
      fetch(`${baseUrl}country-start.json`).then((r) => r.json()).catch(() => ({})),
    ]).then(([data, starts]) => {
      D = data;
      STARTS = starts;

      ($('[data-pp-axis]') as HTMLSelectElement).innerHTML =
        Object.entries(D.pairs).map(([pid, p]: any) =>
          `<option value="${esc(pid)}">${esc(p.left.name)} ←→ ${esc(p.right.name)}</option>`).join('');

      wirePicker('[data-pp-country]',
        (q) => D.countries.filter((c: any) => c.n.toLowerCase().includes(q) || c.t.toLowerCase() === q)
          .map((c: any) => ({ key: c.t, label: c.n, small: `${c.cu} · ${c.re}` })),
        (tag) => {
          country = D.countries.find((c: any) => c.t === tag) || null;
          govOverride = null;
          buildTable();
        });

      const qs = new URLSearchParams(location.search);
      country = D.countries.find((c: any) => c.t === qs.get('c')) || null;
      const g = qs.get('g');
      if (g && GOVS.some(([k]) => k === g)) govOverride = g;
      const e = parseFloat(qs.get('e') || '');
      if (Number.isFinite(e)) { cabEff = e; ($('[data-pp-eff]') as HTMLInputElement).value = String(e); }
      const b = parseInt(qs.get('b') || '', 10);
      if (Number.isFinite(b)) { privBudget = b; ($('[data-pp-pb]') as HTMLInputElement).value = String(b); }
      const rb = parseInt(qs.get('r') || '', 10);
      if (Number.isFinite(rb)) { reformBudget = rb; ($('[data-pp-rb]') as HTMLInputElement).value = String(rb); }
      for (const h of (qs.get('h') || '').split('~').filter(Boolean)) promoted.add(h);
      for (const bit of (qs.get('p') || '').split(',').filter(Boolean)) {
        const [pair, dir, at, aft, flags] = bit.split(':');
        if (pair in D.pairs && (dir === 'left' || dir === 'right' || dir === 'auto')) {
          const fl = flags || '';
          path.push({ pair, dir: dir as any,
                      at: at === undefined || at === '' ? null : parseFloat(at),
                      after: aft === undefined || aft === '' ? null : parseInt(aft, 10),
                      last: fl.includes('L'),
                      keep: !fl.includes('R'),
                      lock: fl.includes('P') });
        }
      }
      buildTable();
      render();
    });

    ($('[data-pp-gov]') as HTMLSelectElement).addEventListener('change', (e) => {
      govOverride = (e.target as HTMLSelectElement).value;
      buildTable();
      render();
    });
    $('[data-pp-eff]').addEventListener('change', (e) => {
      const v = parseFloat((e.target as HTMLInputElement).value);
      if (Number.isFinite(v)) { cabEff = Math.max(0, Math.min(1, v)); buildTable(); render(); }
    });
    $('[data-pp-pb]').addEventListener('change', (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      if (Number.isFinite(v)) { privBudget = Math.max(0, v); render(); }
    });
    $('[data-pp-rb]').addEventListener('change', (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      if (Number.isFinite(v)) { reformBudget = Math.max(0, v); render(); }
    });
    $('[data-pp-push]').addEventListener('click', () => {
      const pair = ($('[data-pp-axis]') as HTMLSelectElement).value;
      const dir = ($('[data-pp-goal]') as HTMLSelectElement).value as any;
      const raw = ($('[data-pp-at]') as HTMLInputElement).value.trim();
      path.push({ pair, dir, at: raw === '' ? null : parseFloat(raw),
                  after: null, last: false, keep: true, lock: false });
      render();
    });
    $('[data-pp-example]').addEventListener('click', () => {
      path = EXAMPLE.map(([pair, dir, at, after, last]) =>
        ({ pair, dir, at, after: after ?? null, last: !!last, keep: true, lock: false }));
      render();
    });
    $('[data-pp-order]').addEventListener('click', () => {
      const b = $('[data-pp-order]');
      b.textContent = '… working';
      setTimeout(() => { bestOrder(); render(); b.textContent = '✦ Best order'; }, 10);
    });
    $('[data-pp-clear]').addEventListener('click', () => { path = []; render(); });
    $('[data-pp-copy]').addEventListener('click', () => {
      syncUrl();
      navigator.clipboard.writeText(location.href);
      const b = $('[data-pp-copy]'); b.textContent = '✓ Copied';
      setTimeout(() => (b.textContent = '⧉ Copy link'), 1200);
    });
    $('[data-pp-path]').addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.dataset.edit) return;
      const [field, idx] = el.dataset.edit.split(':');
      const st = path[parseInt(idx, 10)];
      if (!st) return;
      if (field === 'pair') st.pair = el.value;
      else if (field === 'dir') st.dir = el.value as any;
      else if (field === 'last') st.last = el.checked;
      else if (field === 'keep') st.keep = el.checked;
      else if (field === 'lock') st.lock = el.checked;
      else if (field === 'after') st.after = el.value.trim() === '' ? null : parseInt(el.value, 10);
      else st.at = el.value.trim() === '' ? null : parseFloat(el.value);
      render();
    });
    $('[data-pp-path]').addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest('[data-mv],[data-rm]') as HTMLElement | null;
      if (!el) return;
      if (el.dataset.rm !== undefined) {
        path.splice(parseInt(el.dataset.rm, 10), 1);
      } else {
        const [i, d] = el.dataset.mv!.split(':').map(Number);
        const j = i + d;
        if (j < 0 || j >= path.length) return;
        [path[i], path[j]] = [path[j], path[i]];
      }
      render();
    });
    $('[data-pp-out]').addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.dataset.promote) return;
      if (el.checked) promoted.add(el.dataset.promote);
      else promoted.delete(el.dataset.promote);
      buildTable();
      render();
    });
  </script>

  <style is:global>
    .pp-add select, .pl-toggle select {
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 6px 10px; font-size: 13px; font-family: var(--font-ui);
    }
    .pl-toggle select { padding: 4px 8px; font-size: 12.5px; }
    .pl-toggle input[type=number] {
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: 3px; padding: 3px 6px; font-family: var(--font-mono); font-size: 12px;
    }
    .pp-add input[type=number] {
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 5px 8px; font-family: var(--font-mono); font-size: 12px;
    }
    .pp-note { max-width: 820px; color: var(--text-dim); font-size: 12.5px; margin: 14px 0; }

    .pp-path { list-style: none; margin: 6px 0 4px; padding: 0;
      display: flex; flex-direction: column; gap: 4px; }
    .pp-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      padding: 5px 10px; border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-elev); }
    .pp-row select {
      background: var(--bg-elev-2); color: var(--text); border: 1px solid var(--border);
      border-radius: 3px; padding: 3px 7px; font-size: 12.5px; font-family: var(--font-ui);
    }
    .pp-row .pp-until { font-size: 12px; color: var(--text-faint); }
    .pp-row input[type=number] {
      width: 62px; background: var(--bg-elev-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 3px; padding: 2px 6px;
      font-family: var(--font-mono); font-size: 12px;
    }
    .pp-row input.pp-year { width: 58px; }
    .pp-row input[type=checkbox] { accent-color: var(--gold); }
    .pp-mv { margin-left: auto; display: flex; gap: 4px; }
    .pp-mv button { background: var(--bg-elev); color: var(--text-dim); border: 1px solid var(--border);
      border-radius: 3px; font-size: 11px; padding: 1px 7px; cursor: pointer; }
