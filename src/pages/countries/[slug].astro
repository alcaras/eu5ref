---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/countries.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
const base = import.meta.env.BASE_URL;

// Content the game gates to this tag — derived from the compiled `potential`
// triggers, so it is the same rule the planner filters on.
const UNIQUE_SECTIONS: [string, string][] = [
  ['advances', 'Unique advances'],
  ['units', 'Unique units'],
  ['buildings', 'Unique buildings'],
  ['reforms', 'Unique government reforms'],
  ['events', 'Flavour events'],
];
const unique = entity.data.unique || {};
const uniqueTotal = Object.values(unique).reduce((n: number, v: any) => n + v.length, 0);
// A big tag can have 200+ flavour events — show a readable slice and send
// the rest to the events browser.
const CAP = 40;
---
<Base title={entity.name} active="countries" eyebrow={`Country · ${entity.data.tag}`}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    {uniqueTotal > 0 && (
      <div class="panel">
        <h3>Unique content ({uniqueTotal})</h3>
        {UNIQUE_SECTIONS.map(([key, label]) =>
          unique[key]?.length > 0 && (
            <div class="uniq">
              <span class="uniq__label">{label}</span>
              <div class="uniq__items">
                {unique[key].slice(0, CAP).map((x: any) => (
                  <a class="uitem" href={`${base}${x.page}/${x.slug}`}>
                    <span class="uitem__n">{x.name}</span>
                    {x.fx?.length > 0 && (
                      <span class="uitem__fx">{x.fx.join(' · ')}</span>
                    )}
                  </a>
                ))}
                {unique[key].length > CAP && (
                  <a class="uitem"
                     href={`${base}${unique[key][0].page}?q=${encodeURIComponent(entity.name)}`}>
                    <span class="uitem__n">… and {unique[key].length - CAP} more</span>
                    <span class="uitem__fx">see all {entity.name} {key}</span>
                  </a>
                )}
              </div>
            </div>
          )
        )}
      </div>
    )}
    <Fragment slot="aside">
      <div class="panel">
        <h3>At the 1337 start</h3>
        <div class="kv">
          <span class="k">Capital</span><span class="v">{entity.data.capital ?? '—'}</span>
          <span class="k">Culture</span><span class="v">{entity.facets.culture}</span>
          <span class="k">Religion</span><span class="v">{entity.facets.religion}</span>
          <span class="k">Rank</span><span class="v">{entity.facets.rank}</span>
          <span class="k">Difficulty</span><span class="v">{entity.data.difficulty ?? '—'}</span>
          <span class="k">Court language</span><span class="v">{entity.data.court_language ?? '—'}</span>
          {entity.data.dynasty.length > 0 && (
            <Fragment><span class="k">Dynasty</span><span class="v">{entity.data.dynasty.join(', ')}</span></Fragment>
          )}
        </div>
      </div>
      <div class="panel">
        <h3>Plan this country</h3>
        <p style="margin:0; font-size:13px;">
          <a href={`${base}advance-planner?c=${entity.data.tag}`}>Open the tech planner →</a>
        </p>
      </div>
    </Fragment>
  </EntityDetail>
</Base>

<style>
  .uniq { margin-bottom: 16px; }
  .uniq__label {
    display: block; font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;
  }
  /* Each entry shows what it does inline — the point is to read a country's
     bespoke content without clicking or hovering through it. */
  .uniq__items {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 4px 14px;
  }
  a.uitem {
    display: flex; flex-direction: column; gap: 1px; padding: 4px 8px;
    border-left: 2px solid var(--border-strong); border-radius: 0 3px 3px 0;
    color: inherit; background: var(--bg-elev-2);
  }
  a.uitem:hover { text-decoration: none; border-left-color: var(--gold); background: var(--bg-elev-3); }
  .uitem__n { font-size: 12.5px; color: var(--text-soft); font-weight: 600; }
  .uitem__fx { font-size: 11.5px; color: var(--text-dim); }
  a.chip:hover { border-color: var(--gold-deep); color: var(--gold); text-decoration: none; }
</style>
