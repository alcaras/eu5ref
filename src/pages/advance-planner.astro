---
import Base from '../layouts/Base.astro';
---
<Base title="Tech Planner" active="advance-planner" pageMark="🧭" eyebrow="Tools"
  description="Interactive Europa Universalis V advance planner — the in-game tech tree, filtered to your country, with a shareable plan.">

  <p class="pl-intro">
    The advances screen: <b>age tabs</b>, then one pane per tree, laid out
    top-down like the game — each prerequisite tier is a row, and what it
    leads to sits underneath. Same trees, tiers, edges and left-to-right
    order as in game, so nothing needs mentally rotating. A dashed edge
    marks an advance whose files declare no prerequisite: the game slots it
    into a tree when it loads, and that placement is reproduced here from
    the game files and checked against the tech screen. The <b>age focus</b>
    buttons are the pick you make at each age change — the trees show the
    focus you chose, with its advances marked ◈ where the game draws them.
    Click a pane header to collapse it.
    Pick a country and everything that can never apply to it disappears —
    usually about two thirds of the 3,178 advances.
    <b>Hover</b> to light up an advance's whole prerequisite chain,
    <b>click</b> to plan it (its prerequisites come along),
    <b>right-click</b> to mark it already researched,
    <b>⌥-click</b> to open its reference page. The URL always holds your plan.
  </p>

  <div class="pl" data-pl>
    <div class="pl-controls">
      <div class="pl-picker" data-pl-country>
        <input type="search" placeholder="Pick a country…" autocomplete="off" />
        <div class="hdr-search__results" hidden></div>
      </div>
      <button type="button" class="csv-btn" data-pl-facts-toggle
        title="Everything the gates test — culture, religion, capital, government, subject status, and the things you can acquire">⚙ Your country</button>
      <span class="chips" data-pl-context></span>
      <span class="pl-spacer"></span>
      <label class="pl-toggle" title="Which advances to draw: yours + conditional (default), only the certain ones, or every country’s">
        show <select data-pl-show>
          <option value="">yours + conditional</option>
          <option value="sure">yours only</option>
          <option value="all">everything</option>
        </select>
      </label>
      <label class="pl-toggle" title="Show what each advance does, without hovering">
        <input type="checkbox" data-pl-expand /> expanded
      </label>
      <div class="pl-zoom">
        <button type="button" data-zoom="-">−</button>
        <span data-zoom-label>100%</span>
        <button type="button" data-zoom="+">+</button>
      </div>
      <button type="button" class="csv-btn" data-pl-undo title="Undo (⌘Z)" disabled>↶</button>
      <button type="button" class="csv-btn" data-pl-redo title="Redo (⇧⌘Z)" disabled>↷</button>
      <button type="button" class="csv-btn" data-pl-copy>⧉ Copy link</button>
      <button type="button" class="csv-btn" data-pl-clear>✕ Clear plan</button>
    </div>

    <div class="pl-facts" data-pl-facts hidden></div>

    <div class="pl-ages" data-pl-ages></div>

    <div class="pl-legend">
      <span><i class="sw k1"></i> unlocks buildings, units, laws</span>
      <span><i class="sw k2"></i> unlocks diplomacy</span>
      <span><i class="sw k0"></i> modifiers only</span>
      <span><i class="sw st-planned"></i> planned</span>
      <span><i class="sw st-res"></i> researched</span>
      <span><i class="sw st-cond"></i> conditional — needs something you can still acquire</span>
      <span data-pl-count></span>
    </div>

    <div class="pl-choices" data-pl-choices></div>
    <div class="pl-panes" data-pl-panes></div>
    <div class="pl-tip" data-pl-tip hidden></div>
  </div>

  <style is:global>
    .pl-intro { max-width: 760px; color: var(--text-soft); }
    .pl-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 16px; }
    .pl-zoom { display: flex; align-items: center; gap: 2px; }
    .pl-zoom button {
      border: 1px solid var(--border); background: var(--bg-elev); color: var(--text-dim);
      border-radius: var(--radius-sm); width: 26px; height: 24px; cursor: pointer; font-size: 14px;
      font-family: var(--font-ui); line-height: 1;
    }
    .pl-zoom button:hover { color: var(--text); border-color: var(--border-strong); }
    .pl-zoom span { font-size: 11px; color: var(--text-faint); font-family: var(--font-mono); width: 40px; text-align: center; }

    /* age tabs — the game's secondary tab bar */
    .pl-ages { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
    .pl-ages button {
      display: flex; align-items: center; gap: 6px;
      border: 1px solid var(--border); background: var(--bg-elev); color: var(--text-dim);
      border-radius: var(--radius); padding: 5px 12px 5px 8px; font-size: 12.5px;
      cursor: pointer; font-family: var(--font-ui);
    }
    .pl-ages button img { width: 20px; height: 20px; object-fit: contain; }
    .pl-ages button.on { background: var(--gold-glow); border-color: var(--gold-deep); color: var(--gold); }
    .pl-ages button b { font-weight: 600; color: var(--gold); }

    .pl-legend {
      display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
      margin-top: 12px; font-size: 11.5px; color: var(--text-faint);
    }
    .pl-legend span { display: flex; align-items: center; gap: 5px; }
    .pl-legend i.sw { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    .sw.k0 { background: var(--good); } .sw.k1 { background: var(--accent-2); } .sw.k2 { background: var(--bad); }
    .sw.st-planned { background: var(--gold); }
    .sw.st-res { background: var(--gold-deep); }
    .sw.st-cond { border: 1px dashed var(--text-dim); }

    /* One pane per root branch: each is only as wide as its own depth, so a
       short branch never inherits the widest branch's scrollbar, and the page
       itself only ever scrolls vertically. */
    .pl-panes { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
    .pl-pane {
      border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-elev); overflow: hidden;
    }
    .pl-pane__head {
      display: flex; align-items: baseline; gap: 8px; cursor: pointer;
      padding: 8px 12px; border-bottom: 1px solid var(--border-faint);
      font-family: var(--font-display); font-size: 15px; color: var(--gold-soft);
      user-select: none;
    }
    .pl-pane__head:hover { background: var(--bg-elev-2); }
    .pl-pane__head small { font-family: var(--font-ui); font-size: 11px; color: var(--text-faint); }
    .pl-pane__head .caret { margin-left: auto; color: var(--text-faint); font-size: 11px; }
    .pl-pane__body { overflow-x: auto; overflow-y: hidden; }
    .pl-pane__body::-webkit-scrollbar { height: 9px; }
    .pl-pane.collapsed .pl-pane__body { display: none; }
    .pl-board { position: relative; transform-origin: 0 0; }

    /* age focus picks — a choice per age, so they sit above the trees */
    .pl-choices { margin-top: 14px; }
    .pl-choices__bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .pl-choices__label {
      font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--text-faint);
    }
    .pl-choices__bar button {
      border: 1px solid var(--border); background: var(--bg-elev); color: var(--text-dim);
      border-radius: 999px; padding: 3px 12px; font-size: 12px; cursor: pointer;
      font-family: var(--font-ui);
    }
    .pl-choices__bar button.on { background: var(--gold-glow); border-color: var(--gold-deep); color: var(--gold); }
    .pl-choices__hint { font-size: 11.5px; color: var(--text-faint); margin-left: 4px; }
    .pnode .sp { color: var(--gold-soft); font-size: 10px; flex: none; margin-left: auto; }

    .pl-branch-head {
      position: absolute; font-family: var(--font-display); font-size: 14px;
      color: var(--gold-soft); letter-spacing: 0.03em; white-space: nowrap;
    }
    .pl-branch-head small { color: var(--text-faint); font-family: var(--font-ui); font-size: 11px; margin-left: 7px; }
    .pl-branch-head.sub {
      font-family: var(--font-ui); font-size: 10.5px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim);
    }
    .pl-band-rule { position: absolute; height: 1px; background: var(--border-faint); }
    /* a fact the player asserted over the 1337 start (or the save) */
    .chip.shifted { cursor: pointer; border-color: var(--gold-deep); color: var(--gold-soft); }
    .chip.shifted:hover { border-color: var(--gold); }

    /* "your country" panel — one row per kind of fact the gates test */
    .pl-facts {
      margin-top: 12px; padding: 10px 14px; border: 1px solid var(--border);
      border-radius: var(--radius); background: var(--bg-elev);
      display: grid; grid-template-columns: max-content 1fr; gap: 8px 14px; align-items: start;
    }
    .pl-facts__k {
      font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--text-faint); padding-top: 5px; white-space: nowrap;
    }
    .pl-facts__v { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; min-height: 26px; }
    .pl-facts__v select {
      border: 1px solid var(--border); background: var(--bg-elev-2); color: var(--text);
      border-radius: var(--radius-sm); padding: 3px 6px; font-size: 12px; font-family: var(--font-ui);
    }
    .pl-facts__v .pl-picker input { min-width: 220px; }
    .pl-facts__v .cur { font-size: 12px; color: var(--text-soft); }
    .pl-facts__v .cur small { color: var(--text-faint); margin-left: 6px; }
    .pl-facts__v .reset {
      border: 0; background: none; color: var(--gold-soft); cursor: pointer; font-size: 12px; padding: 0 4px;
    }
    .pl-facts__v .reset:hover { color: var(--gold); }
    .pl-facts__v .fchip {
      border: 1px solid var(--border); background: var(--bg-elev-2); color: var(--text-dim);
      border-radius: 999px; padding: 2px 10px; font-size: 11.5px; cursor: pointer;
      font-family: var(--font-ui); display: inline-flex; gap: 5px; align-items: center;
    }
    .pl-facts__v .fchip small { color: var(--text-faint); font-family: var(--font-mono); font-size: 10px; }
    .pl-facts__v .fchip:hover { border-color: var(--border-strong); color: var(--text); }
    .pl-facts__v .fchip.yes { background: var(--gold-glow); border-color: var(--gold-deep); color: var(--gold); }
    .pl-facts__v .fchip.no { border-color: var(--bad); color: var(--bad); text-decoration: line-through; }
    .pl-facts__v .fchip.base { border-style: dashed; }
    .pl-facts__v .more { font-size: 11.5px; color: var(--text-faint); cursor: pointer; border: 0; background: none; font-family: var(--font-ui); }
    .pl-facts__v .more:hover { color: var(--text); }
    .pl-facts__hint { grid-column: 1 / -1; font-size: 11.5px; color: var(--text-faint); }
    .pl-facts__hint b { color: var(--text-dim); font-weight: 600; }

    /* node card — compact row: icon + name, tier column packing */
    .pnode {
      position: absolute; width: 138px; height: 26px; box-sizing: border-box;
      display: flex; align-items: center; gap: 5px; padding: 0 6px 0 5px;
      background: var(--bg-elev-2); border: 1px solid var(--border);
      border-left: 3px solid var(--border-strong);
      border-radius: 4px; font-size: 11px; color: var(--text-soft);
      cursor: pointer; user-select: none; overflow: hidden;
    }
    .pnode img { width: 17px; height: 17px; object-fit: contain; flex: none; }
    .pnode .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.15; }
    .pnode.k0 { border-left-color: var(--good); }
    .pnode.k1 { border-left-color: var(--accent-2); }
    .pnode.k2 { border-left-color: var(--bad); }
    .pnode:hover { border-color: var(--gold-soft); z-index: 6; }
    .pnode.planned { background: color-mix(in oklab, var(--gold) 20%, var(--bg-elev-2)); border-color: var(--gold); color: var(--text); }
    .pnode.researched { background: color-mix(in oklab, var(--gold-deep) 18%, var(--bg-elev-2)); border-color: var(--gold-deep); opacity: .8; }
    .pnode.conditional { border-style: dashed; }
    .pnode.foreign { opacity: .38; filter: grayscale(1); }
    .pnode .badge {
      margin-left: auto; font-size: 9px; color: var(--gold-soft); flex: none;
      font-family: var(--font-mono);
    }
    .pnode .qn {
      margin-left: auto; font-size: 10px; font-family: var(--font-mono);
      color: var(--gold); flex: none;
    }
    /* expanded card: name on top, what it does underneath */
    .pnode.wide {
      width: 208px; height: 70px; flex-direction: column; align-items: stretch;
      gap: 2px; padding: 5px 7px 6px 6px;
    }
    .pnode.wide .hd { display: flex; align-items: center; gap: 5px; }
    .pnode.wide .hd .nm { font-weight: 600; color: var(--text); }
    .pnode.wide .fx {
      display: flex; flex-direction: column; gap: 0;
      font-size: 10px; line-height: 1.35; color: var(--text-dim); overflow: hidden;
    }
    .pnode.wide .fx span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pnode.wide .fx .none { color: var(--text-faint); font-style: italic; }

    /* hovering an advance lights its whole prerequisite chain */
    .pl-board.focus .pnode { opacity: .22; }
    .pl-board.focus .pnode.lit { opacity: 1; border-color: var(--gold-soft); }
    .pl-board.focus svg.pl-edges path { opacity: .08; }
    .pl-board.focus svg.pl-edges path.lit { opacity: 1; stroke: var(--gold-soft); stroke-width: 2; }

    svg.pl-edges { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
    svg.pl-edges path { stroke: var(--border-strong); stroke-width: 1.4; fill: none; opacity: .45; }
    svg.pl-edges path.hot { stroke: var(--gold); opacity: 1; stroke-width: 2; }
    svg.pl-edges path.slot { stroke-dasharray: 4 4; }

    .pl-tip {
      position: fixed; z-index: 90; max-width: 330px; padding: 9px 12px;
      background: var(--bg-elev-3); border: 1px solid var(--border-strong);
      border-radius: var(--radius); font-size: 12px; color: var(--text-soft);
      box-shadow: var(--shadow-sm); line-height: 1.4;
    }
    .pl-tip b.t { display: block; color: var(--text); font-size: 13px; margin-bottom: 3px; }
    .pl-tip .lit { color: var(--text-soft); }
    .pl-tip .lit.ok { color: var(--good); }
    .pl-tip .lit.no { color: var(--bad); }
    .pl-tip .lit button {
      border: 1px solid var(--gold-deep); background: var(--gold-glow); color: var(--gold);
      border-radius: 999px; padding: 0 7px; font-size: 10.5px; cursor: pointer; margin-left: 6px;
      font-family: var(--font-ui); line-height: 1.5;
    }
    .pl-tip .lit button:hover { border-color: var(--gold); }
    .pl-tip .gate { color: var(--gold-soft); }
    .pl-tip .unl { color: var(--accent-2); }
    .pl-tip .hint { color: var(--text-faint); margin-top: 5px; font-size: 11px; }
    .pl-empty { padding: 40px; color: var(--text-faint); text-align: center; }
  </style>

  <script>
    import { evalGate as evalGateG, literals, applyOverrides, baseFacts,
             overridesToParams, overridesFromParams } from '../lib/facts';
    import type { Facts, KindDef, Overrides, SetFacts } from '../lib/facts';
    import { activeSeat, saveFacts, seatLabel, loadSnapshot, loadPref, setPref, onSaveChange } from '../lib/save-store';
    const root = document.querySelector('[data-pl]')!;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;

    type Node = {
      n: string; s: string; a: number; b: string; bo?: number; o?: number; d: number; r: string[];
      p?: string;   // drawn under this node in game without it being a prerequisite
      k: number; i?: string; g?: any; gl?: [string, string, string][];
      m?: [string, string, string][]; u?: string[]; sp?: string; rs?: string[];
    };
    type Country = { t: string; n: string; col: string | null; cu: string; re: string; f: Record<string, any> };
    type Data = { version: string; vhash: string; order: string[];
                  ages: { n: string; i: string | null }[];
                  nodes: Record<string, Node>; countries: Country[];
                  kinds: KindDef[]; modkeys: Record<string, string>;
                  formables: Record<string, any> };

    let D: Data;
    const idx = new Map<string, number>();
    let country: Country | null = null;
    let seeded: { c: string; r: string; age: string | null } | null = null;   // what the save filled in
    let formables: Record<string, any> = {};   // tag → who may form it
    // Facts = 1337 setup ⊕ save snapshot ⊕ your overrides. You can
    // culture-shift, convert, move your capital, reform your government,
    // take a reform, unify a culture… — every kind of fact a gate tests is
    // overridable once a country is picked, and the URL carries the
    // overrides (never the save), so a link reproduces the view.
    let overrides: Overrides = {};
    const planned = new Set<string>();
    const researched = new Set<string>();
    // '' = yours + conditional · 'sure' = yours only · 'all' = everything
    let showMode = '';
    const showOther = () => showMode === 'all';
    let expanded = false;
    let ageIx = 0;
    let zoom = 1;
    // the focus picked at each age change (adm / dip / mil), like in game
    const FOCUS: [string, string][] = [['adm', 'Administrative'], ['dip', 'Diplomatic'], ['mil', 'Military']];
    const focusOf = new Map<number, string>();
    const focusAt = (a: number) => focusOf.get(a) || 'adm';
    const collapsedPanes = new Set<string>();   // per-branch collapse state

    // Geometry. The game draws each branch as a top-down tidy tree, which
    // is why its own screen sprawls: centring a parent over a wide subtree
    // opens huge gaps, and deep-but-sparse branches leave dead space. We
    // keep the game's *semantics* (branch, tier, prerequisite edges) but
    // turn each tier into a COLUMN and pack it vertically — depth is only
    // 8–10, so an age fits the viewport width and every name stays legible.
    // NW/NH are the card; COLW is the sideways step between siblings in a
    // tier and ROWH the vertical pitch between tiers. Cards are narrower
    // than the horizontal layout used, because width is now the scarce axis.
    let NW = 138, NH = 26, COLW = 146, ROWH = 56;
    const BRANCH_GAP = 30, TOP = 26;
    /** Expanded cards carry their effects, so they need room. */
    function setGeometry() {
      if (expanded) { NW = 208; NH = 70; COLW = 216; ROWH = 100; }
      else { NW = 138; NH = 26; COLW = 146; ROWH = 56; }
    }

    // ── gate evaluation (shared: src/lib/facts.ts) ─────────────
    // TRUE = available to this country, FALSE = never, null = depends on
    // something you can still acquire (asserted in the "your country" panel).
    const evalGate = (e: any, f: Facts) => evalGateG(e, f, formables);
    /** The country's 1337 facts (or the save's) with your overrides applied. */
    let factsCache: Facts | null = null;
    /** Where the facts start before your overrides: the imported save's
     *  view of this country when one is in use, else the 1337 setup. */
    const baselineOf = (c: Country): Record<string, any> => saveFacts(c.t) || c.f;
    function effectiveFacts(): Facts | null {
      if (!country) return null;
      if (!factsCache) factsCache = applyOverrides(baseFacts(baselineOf(country)), overrides, D.kinds);
      return factsCache;
    }
    const invalidateFacts = () => { factsCache = null; };
    // 'common' | 'yours' | 'conditional' | 'other'
    function statusOf(id: string): string {
      const n = D.nodes[id];
      if (!n.g) return 'common';
      const f = effectiveFacts();
      if (!f) return 'conditional';
      const v = evalGate(n.g, f);
      return v === true ? 'yours' : v === null ? 'conditional' : 'other';
    }
    const kindDef = (k: string) => D.kinds.find((d) => d.k === k);
    const kindLabel = (k: string, v: string) => kindDef(k)?.values.find((x) => x.v === v)?.l || v;
    /** Assert a set-kind atom (true / false / null = back to unknown). */
    function assertAtom(kind: string, atom: string, val: boolean | null) {
      const cur = { ...((overrides[kind] as SetFacts) || {}) };
      if (val === null) delete cur[atom]; else cur[atom] = val;
      if (Object.keys(cur).length) overrides[kind] = cur; else delete overrides[kind];
      invalidateFacts();
    }
    function setOne(kind: string, v: string | null) {
      if (v) overrides[kind] = v; else delete overrides[kind];
      invalidateFacts();
    }

    // ── URL state ──────────────────────────────────────────────
    const enc = (s: Set<string>) => [...s].map((id) => idx.get(id)!.toString(36)).join('.');
    function dec(v: string | null, into: Set<string>) {
      if (!v) return;
      for (const p of v.split('.')) { const id = D.order[parseInt(p, 36)]; if (id) into.add(id); }
    }
    function syncUrl() {
      const p = new URLSearchParams();
      p.set('v', D.vhash);
      if (country) p.set('c', country.t);
      overridesToParams(overrides, p);
      if (ageIx) p.set('age', String(ageIx));
      if (showMode) p.set('show', showMode);
      if (expanded) p.set('x', '1');
      const fo = D.ages.map((_, i) => focusAt(i));
      if (fo.some((f) => f !== 'adm')) p.set('f', fo.join('.'));
      if (planned.size) p.set('p', enc(planned));
      if (researched.size) p.set('r', enc(researched));
      history.replaceState(null, '', p.toString() ? '?' + p.toString() : location.pathname);
    }

    // ── planning ───────────────────────────────────────────────
    /** What has to come first: the declared `requires`, plus — for an
     *  advance that declares none — the node the game draws it under.
     *  In game that node has to be researched first exactly like a
     *  declared prerequisite; the files just don't say so. */
    function reqOf(id: string): string[] {
      const n = D.nodes[id];
      return n.r.length ? n.r : (n.p ? [n.p] : n.r);
    }
    function addWithPrereqs(id: string) {
      const stack = [id];
      while (stack.length) {
        const cur = stack.pop()!;
        if (planned.has(cur) || researched.has(cur)) continue;
        planned.add(cur);
        for (const r of reqOf(cur)) stack.push(r);
      }
    }
    function removeWithDependents(id: string) {
      planned.delete(id);
      let changed = true;
      while (changed) {
        changed = false;
        for (const pid of [...planned]) {
          if (reqOf(pid).some((r) => !planned.has(r) && !researched.has(r))) {
            planned.delete(pid); changed = true;
          }
        }
      }
    }

    // ── undo / redo ────────────────────────────────────────────
    // History covers what you *decided* — the plan, and the country /
    // culture / religion it is for — not view state like the age tab, zoom
    // or a collapsed pane. Undo should never move you somewhere else.
    type Snap = { c: string | null; ov: string; p: string[]; r: string[] };
    // NB: not `history` — that shadows window.history and breaks syncUrl().
    let undoStack: Snap[] = [];
    let histIx = -1;
    let restoring = false;

    const snap = (): Snap => ({
      c: country?.t ?? null, ov: JSON.stringify(overrides), p: [...planned], r: [...researched],
    });
    const sameSnap = (a: Snap, b: Snap) =>
      a.c === b.c && a.ov === b.ov &&
      a.p.length === b.p.length && a.r.length === b.r.length &&
      a.p.every((x, i) => x === b.p[i]) && a.r.every((x, i) => x === b.r[i]);

    function pushHistory() {
      if (restoring) return;
      const s = snap();
      if (histIx >= 0 && sameSnap(undoStack[histIx], s)) return;
      undoStack = undoStack.slice(0, histIx + 1);
      undoStack.push(s);
      if (undoStack.length > 100) undoStack.shift();
      histIx = undoStack.length - 1;
      updateHistoryButtons();
    }
    function applySnap(s: Snap) {
      restoring = true;
      country = s.c ? D.countries.find((c) => c.t === s.c) || null : null;
      overrides = JSON.parse(s.ov);
      invalidateFacts();
      planned.clear(); for (const x of s.p) planned.add(x);
      researched.clear(); for (const x of s.r) researched.add(x);
      restoring = false;
      render();
      updateHistoryButtons();
    }
    const undo = () => { if (histIx > 0) { histIx--; applySnap(undoStack[histIx]); } };
    const redo = () => { if (histIx < undoStack.length - 1) { histIx++; applySnap(undoStack[histIx]); } };
    function updateHistoryButtons() {
      ($('[data-pl-undo]') as HTMLButtonElement).disabled = histIx <= 0;
      ($('[data-pl-redo]') as HTMLButtonElement).disabled = histIx >= undoStack.length - 1;
    }
    /** Mutate the plan, redraw, and record the step. */
    function mutate(fn: () => void) { fn(); render(); pushHistory(); }

    // ── visible set + tidy top-down layout ─────────────────────
    function visibleIds(): string[] {
      const out: string[] = [];
      for (const [id, n] of Object.entries(D.nodes)) {
        if (n.a !== ageIx) continue;
        const st = statusOf(id);
        if (st === 'other' && !showOther()) continue;
        if (st === 'conditional' && showMode === 'sure' && !planned.has(id) && !researched.has(id)) continue;
        // an age shows one focus's advances — the one you picked — but a
        // plan that already holds one of another focus keeps it visible
        if (n.sp && n.sp !== focusAt(n.a) && !planned.has(id) && !researched.has(id)) continue;
        out.push(id);
      }
      return out;
    }

    /** Lay ONE branch out the way the game does: each prerequisite tier is
     *  a ROW, and the advances in it spread left to right, ordered by their
     *  parent's position so children sit under the parent they came from.
     *  Same orientation as the in-game screen, so nothing needs mentally
     *  rotating — the cost is width, which the pane scrolls. */
    function layoutBranch(list: string[], parentOf: Map<string, string | null>) {
      const local = new Set(list);
      const minTier = Math.min(...list.map((id) => D.nodes[id].d));
      const byTier = new Map<number, string[]>();
      for (const id of list) {
        const t = D.nodes[id].d - minTier;
        if (!byTier.has(t)) byTier.set(t, []);
        byTier.get(t)!.push(id);
      }
      const slotOf = new Map<string, number>();     // position within a tier
      const pos = new Map<string, { x: number; y: number }>();
      let widest = 0, maxTier = 0;
      for (const t of [...byTier.keys()].sort((a, b) => a - b)) {
        const row = byTier.get(t)!;
        row.sort((a, b) => {
          const pa = parentOf.get(a), pb = parentOf.get(b);
          const sa = pa && local.has(pa) && slotOf.has(pa) ? slotOf.get(pa)! : -1;
          const sb = pb && local.has(pb) && slotOf.has(pb) ? slotOf.get(pb)! : -1;
          return sa - sb || (D.nodes[a].o ?? 0) - (D.nodes[b].o ?? 0) || D.nodes[a].n.localeCompare(D.nodes[b].n);
        });
        row.forEach((id, slot) => {
          slotOf.set(id, slot);
          pos.set(id, { x: 12 + slot * COLW, y: 12 + t * ROWH });
        });
        widest = Math.max(widest, row.length);
        maxTier = Math.max(maxTier, t);
      }
      return { pos,
               width: 24 + Math.max(widest, 1) * COLW,
               height: 24 + (maxTier + 1) * ROWH };
    }

    /** Group the visible advances of this age into branches. */
    function branchesOf(ids: string[]) {
      const vis = new Set(ids);
      const parentOf = new Map<string, string | null>();
      for (const id of ids) {
        const n = D.nodes[id];
        // prerequisite first; else the slot the game's layout gave an orphan
        const p = n.r.find((r) => vis.has(r) && D.nodes[r].b === n.b)
          ?? (n.p && vis.has(n.p) && D.nodes[n.p].b === n.b ? n.p : null);
        parentOf.set(id, p);
      }
      const byBranch = new Map<string, string[]>();
      for (const id of ids) {
        const b = D.nodes[id].b;
        if (!byBranch.has(b)) byBranch.set(b, []);
        byBranch.get(b)!.push(id);
      }
      // same left-to-right order as the in-game tab
      const trees = [...byBranch.entries()].filter(([, l]) => l.length > 1)
        .sort((a, b) => (D.nodes[a[0]]?.bo ?? 99) - (D.nodes[b[0]]?.bo ?? 99) || b[1].length - a[1].length);
      const loners = [...byBranch.entries()].filter(([, l]) => l.length === 1)
        .flatMap(([, l]) => l)
        .sort((a, b) => D.nodes[a].n.localeCompare(D.nodes[b].n));
      return { trees, loners, parentOf };
    }

    // ── render ─────────────────────────────────────────────────
    function render() {
      setGeometry();
      renderAges(); renderContext(); renderBoard(); syncUrl();
    }

    function renderAges() {
      const counts = new Map<number, number>();
      for (const id of planned) counts.set(D.nodes[id].a, (counts.get(D.nodes[id].a) || 0) + 1);
      $('[data-pl-ages]').innerHTML = D.ages.map((a, i) =>
        `<button class="${i === ageIx ? 'on' : ''}" data-age="${i}">` +
        (a.i ? `<img src="${baseUrl}${a.i}" alt=""/>` : '') +
        `${a.n.replace('Age of ', '')}${counts.get(i) ? ` <b>${counts.get(i)}</b>` : ''}</button>`).join('');
    }

    function renderContext() {
      let html = '';
      const seat = activeSeat();
      if (seat) {
        html += `<span class="chip save" title="${seat.snap.file} — facts and researched advances start from your save">` +
          `save: ${seatLabel(seat)} <button type="button" data-save-toggle="off" title="ignore the save on this page">off</button></span>`;
      } else if (loadSnapshot()) {
        html += `<span class="chip save dim" title="a save is imported but not in use">save off ` +
          `<button type="button" data-save-toggle="on">use it</button></span>`;
      }
      if (country) {
        html += `<span class="chip" style="border-color:${country.col ?? 'var(--border)'}">${country.n}</span>`;
        for (const [k, val] of Object.entries(overrides)) {
          const def = kindDef(k);
          if (!def) continue;
          if (typeof val === 'string') {
            html += `<span class="chip shifted" data-reset="${k}" title="back to the start value">${def.l}: ${kindLabel(k, val)} ✕</span>`;
          } else {
            const parts = Object.entries(val).map(([a, b]) => `${b ? '✓' : '✗'} ${kindLabel(k, a)}`);
            html += `<span class="chip shifted" data-reset="${k}" title="forget these">${parts.join(' · ')} ✕</span>`;
          }
        }
      } else {
        html += `<span class="chip">no country — showing everything</span>`;
      }
      $('[data-pl-context]').innerHTML = html;
      renderFacts();
    }

    // The "your country" panel is built from the kinds table alone: one row
    // per kind of fact the gates test. `one` kinds show the effective value
    // and let you change it; `set` kinds are tri-state chips over the
    // values some gate actually tests (unknown → ✓ → ✗), so nothing
    // acquirable is ever hidden until you say you can't have it.
    const factsShowAll = new Set<string>();
    function renderFacts() {
      const panel = $('[data-pl-facts]');
      if (panel.hidden) return;
      const f = effectiveFacts();
      if (!f) { panel.innerHTML = '<div class="pl-facts__hint">Pick a country first.</div>'; return; }
      const base = baseFacts(baselineOf(country!));
      let html = '';
      for (const def of D.kinds) {
        const ov = overrides[def.k];
        html += `<div class="pl-facts__k">${def.l}</div><div class="pl-facts__v" data-kind="${def.k}">`;
        if (def.mode === 'one') {
          const cur = (def.k === 'cap' ? f.cap?.area : (f as any)[def.k]) as string | undefined;
          const curV = def.values.find((x) => x.v === cur);
          const shown = curV ? curV.l + (curV.p ? `<small>${curV.p}</small>` : '') : (cur || '—');
          if (def.values.length <= 8) {
            html += `<select data-one="${def.k}">` + def.values.map((x) =>
              `<option value="${x.v}"${x.v === cur ? ' selected' : ''}>${x.l}${x.n ? ` (${x.n})` : ''}</option>`).join('') + '</select>';
          } else {
            html += `<span class="cur">${shown}</span>` +
              `<div class="pl-picker" data-one-pick="${def.k}"><input type="search" placeholder="change…" autocomplete="off" />` +
              `<div class="hdr-search__results" hidden></div></div>`;
          }
          if (ov) html += `<button type="button" class="reset" data-reset="${def.k}" title="back to the start value">✕ reset</button>`;
        } else {
          const all = factsShowAll.has(def.k);
          const vals = all ? def.values : def.values.slice(0, 8);
          for (const x of vals) {
            const o = ov && typeof ov === 'object' ? (ov as SetFacts)[x.v] : undefined;
            const b = (base as any)[def.k]?.[x.v] as boolean | undefined;
            const st = o ?? b;
            const cls = ['fchip', st === true ? 'yes' : st === false ? 'no' : '', o === undefined && b !== undefined ? 'base' : ''].filter(Boolean).join(' ');
            html += `<button type="button" class="${cls}" data-atom="${x.v}" title="${st === true ? 'you have this — click to say you can\'t' : st === false ? 'you can\'t — click to forget' : 'unknown — click to say you have it'}">` +
              `${st === true ? '✓ ' : st === false ? '✗ ' : ''}${x.l}<small>${x.n}</small></button>`;
          }
          if (def.values.length > 8) html += `<button type="button" class="more" data-more="${def.k}">${all ? 'fewer' : `+${def.values.length - 8} more`}</button>`;
        }
        html += '</div>';
      }
      html += `<div class="pl-facts__hint">The number is how many advances test that value. ` +
        `<b>Dashed</b> chips come from the 1337 setup (or your imported save); a ✓ or ✗ you set travels in the link. ` +
        `Picking another country resets everything here.</div>`;
      panel.innerHTML = html;
      for (const def of D.kinds) {
        if (def.mode !== 'one' || def.values.length <= 8) continue;
        wirePicker(`[data-one-pick="${def.k}"]`,
          (q) => def.values.filter((x) => x.l.toLowerCase().includes(q) || x.v.includes(q) || (x.p || '').toLowerCase().includes(q))
            .sort((a, b) => b.n - a.n || a.l.localeCompare(b.l))
            .map((x) => ({ key: x.v, label: x.l, small: x.p || (x.n ? `${x.n} advances` : '') })),
          (v) => setOne(def.k, v));
      }
    }

    function nodeHtml(id: string, pos?: { x: number; y: number }) {
      const n = D.nodes[id];
      const st = statusOf(id);
      const order = [...planned];
      const cls = ['pnode', 'k' + n.k,
        planned.has(id) ? 'planned' : '',
        researched.has(id) ? 'researched' : '',
        st === 'conditional' ? 'conditional' : '',
        st === 'other' ? 'foreign' : ''].filter(Boolean).join(' ');
      const qn = planned.has(id) ? `<span class="qn">${order.indexOf(id) + 1}</span>` : '';
      const badge = !qn && st !== 'common' && n.gl?.length ? '<span class="badge">◆</span>' : '';
      const sp = n.sp ? `<span class="sp" title="${FOCUS.find(([k]) => k === n.sp)?.[1]} focus">◈</span>` : '';
      const style = pos ? ` style="left:${pos.x}px; top:${pos.y}px"` : '';
      const icon = n.i ? `<img src="${baseUrl}${n.i}" loading="lazy" alt=""/>` : '';
      if (!expanded) {
        return `<div class="${cls}"${style} data-id="${id}">${icon}` +
          `<span class="nm">${n.n}</span>${sp}${qn}${badge}</div>`;
      }
      const fx = [...(n.m || []).slice(0, 3).map(modLine), ...(n.u || []).slice(0, 2)];
      return `<div class="${cls} wide"${style} data-id="${id}">` +
        `<div class="hd">${icon}<span class="nm">${n.n}</span>${sp}${qn}${badge}</div>` +
        (fx.length ? `<div class="fx">${fx.map((x: string) => `<span>${x}</span>`).join('')}</div>`
                   : `<div class="fx"><span class="none">no direct effects</span></div>`) +
        `</div>`;
    }

    const modLine = ([k, v]: [string, string, string]) => `${v} ${D.modkeys[k] || k}`;

    function paneHtml(label: string, count: number, list: string[],
                      parentOf: Map<string, string | null>, key: string) {
      const { pos, width, height } = layoutBranch(list, parentOf);
      let paths = '';
      for (const [id, pt] of pos) {
        const n = D.nodes[id];
        // declared prerequisite edges, plus — dashed — the edge to the node
        // the game draws an undeclared advance under (see reqOf)
        const edges: [string, boolean][] = n.r.map((r) => [r, false] as [string, boolean]);
        if (!n.r.length && n.p) edges.push([n.p, true]);
        for (const [r, slot] of edges) {
          const rp = pos.get(r);
          if (!rp) continue;
          // leave the prerequisite's bottom edge, enter the dependant's top
          const x1 = rp.x + NW / 2, y1 = rp.y + NH, x2 = pt.x + NW / 2, y2 = pt.y;
          const my = (y1 + y2) / 2;
          const hot = planned.has(id) && (planned.has(r) || researched.has(r));
          paths += `<path class="${hot ? 'hot' : ''}${slot ? ' slot' : ''}" data-a="${r}" data-b="${id}" ` +
            `d="M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}"/>`;
        }
      }
      let inner = `<svg class="pl-edges" width="${width}" height="${height}">${paths}</svg>`;
      for (const [id, pt] of pos) inner += nodeHtml(id, pt);
      const collapsed = collapsedPanes.has(key) ? ' collapsed' : '';
      return `<section class="pl-pane${collapsed}" data-pane="${key}">` +
        `<header class="pl-pane__head" data-pane-toggle>${label}<small>${count}</small>` +
        `<span class="caret">${collapsed ? '▸' : '▾'}</span></header>` +
        `<div class="pl-pane__body"><div class="pl-board" style="width:${width}px;height:${height}px;` +
        `transform:scale(${zoom})">${inner}</div></div></section>`;
    }

    function renderBoard() {
      const ids = visibleIds();
      const panes = $('[data-pl-panes]');
      const choices = $('[data-pl-choices]');
      if (!ids.length) {
        panes.innerHTML = '<div class="pl-empty">Nothing in this age for that filter.</div>';
        choices.innerHTML = '';
        return;
      }

      // Each age change offers one focus pick — administrative, diplomatic
      // or military — and only that focus's advances appear in the trees.
      // The bar is that pick; the advances themselves sit where the game
      // draws them.
      const hasFocus = Object.entries(D.nodes).some(([, n]) => n.a === ageIx && n.sp);
      if (hasFocus) {
        const cur = focusAt(ageIx);
        const countOf = (k: string) => Object.entries(D.nodes).filter(([id, n]) =>
          n.a === ageIx && n.sp === k && (showOther() || statusOf(id) !== 'other')).length;
        choices.innerHTML =
          `<div class="pl-choices__bar"><span class="pl-choices__label">Age focus</span>` +
          FOCUS.map(([k, lab]) =>
            `<button data-focus="${k}" class="${k === cur ? 'on' : ''}">${lab}` +
            `<small> ${countOf(k)}</small></button>`).join('') +
          `<span class="pl-choices__hint">◈ marks this focus's advances in the trees</span></div>`;
      } else {
        choices.innerHTML = '';
      }

      const rest = ids;
      const { trees, loners, parentOf } = branchesOf(rest);
      childIndex = new Map();
      for (const id of rest) {
        for (const r of reqOf(id)) {
          if (!childIndex.has(r)) childIndex.set(r, []);
          childIndex.get(r)!.push(id);
        }
      }

      let html = '';
      for (const [bid, list] of trees) {
        html += paneHtml(D.nodes[bid]?.n ?? 'Branch', list.length, list, parentOf, bid);
      }
      if (loners.length) {
        const per = Math.max(3, Math.floor(($('[data-pl-panes]').clientWidth - 40) / COLW) || 5);
        const fake = new Map<string, string | null>();
        // lay the one-offs out as a plain grid by faking tiers
        const pos = new Map<string, { x: number; y: number }>();
        loners.forEach((id, k) => pos.set(id, {
          x: 12 + (k % per) * COLW, y: 12 + Math.floor(k / per) * ROWH,
        }));
        const w = 12 + Math.min(loners.length, per) * COLW;
        const h = 24 + Math.ceil(loners.length / per) * ROWH;
        let inner = '';
        for (const [id, pt] of pos) inner += nodeHtml(id, pt);
        const collapsed = collapsedPanes.has('__loners') ? ' collapsed' : '';
        html += `<section class="pl-pane${collapsed}" data-pane="__loners">` +
          `<header class="pl-pane__head" data-pane-toggle>Standalone<small>${loners.length}</small>` +
          `<span class="caret">${collapsed ? '▸' : '▾'}</span></header>` +
          `<div class="pl-pane__body"><div class="pl-board" style="width:${w}px;height:${h}px;` +
          `transform:scale(${zoom})">${inner}</div></div></section>`;
      }
      panes.innerHTML = html;

      const total = Object.values(D.nodes).filter((n) => n.a === ageIx).length;
      $('[data-pl-count]').textContent =
        `${ids.length} of ${total} shown in this age · ${planned.size} planned · ${researched.size} researched`;
      ($('[data-zoom-label]') as HTMLElement).textContent = Math.round(zoom * 100) + '%';
    }

    // ── tooltip ────────────────────────────────────────────────
    // Stays open while hovered, because a conditional advance lists what it
    // needs with an "assume ✓" for anything you can still acquire.
    const tip = $('[data-pl-tip]');
    let tipFor: string | null = null;
    let tipHide: number | undefined;
    function showTip(e: MouseEvent, id: string) {
      clearTimeout(tipHide);
      if (tipFor === id && !tip.hidden) return;
      tipFor = id;
      const n = D.nodes[id];
      const st = statusOf(id);
      const reqs = n.r.map((r) => D.nodes[r]?.n).filter(Boolean);
      let html = `<b class="t">${n.n}</b>`;
      const f = effectiveFacts();
      if (n.g && f) {
        // every literal the gate tests, with how it stands for you. Another
        // country's tag never qualifies (a formable's does — Poland can
        // become the PLC), so those are left out.
        const labels: Record<string, string> = {};
        for (const [lab, kind, v] of n.gl || []) labels[`${kind}:${v}`] = lab;
        const lits = literals(n.g, f, formables, labels).filter((l) =>
          l.kind !== 'tag' || l.v === country!.t || (l.v in formables && l.value !== false));
        if (lits.length) {
          const verb = st === 'other' ? 'Only for' : st === 'conditional' ? 'Needs' : 'Your unique';
          html += `<div class="gate">${verb}:</div>`;
          for (const l of lits.slice(0, 8)) {
            const label = l.label || kindLabel(l.kind, l.v);
            const def = kindDef(l.kind);
            let act = '';
            if (l.value === null && def?.mode === 'set') act = `<button type="button" data-assume="${l.kind}" data-atom="${l.v}">assume ✓</button>`;
            else if (l.value === false && def?.mode === 'one' && def.values.some((x) => x.v === l.v))
              act = `<button type="button" data-as="${l.kind}" data-atom="${l.v}">as ${label}</button>`;
            else if (l.kind === 'tag' && l.value === null) act = ` <small>(formable)</small>`;
            html += `<div class="lit ${l.value === true ? 'ok' : l.value === false ? 'no' : ''}">` +
              `${l.value === true ? '✓' : l.value === false ? '✗' : '?'} ${label}${act}</div>`;
          }
        }
      } else if (n.gl?.length) {
        html += `<div class="gate">Only for: ${n.gl.slice(0, 6).map((l) => l[0]).join(', ')}</div>`;
      }
      for (const rs of n.rs || []) html += `<div class="gate">Requires: ${rs}</div>`;
      for (const m of n.m || []) html += `<div>${modLine(m)}</div>`;
      for (const u of n.u || []) html += `<div class="unl">${u}</div>`;
      if (reqs.length) html += `<div class="hint">after: ${reqs.join(', ')}</div>`;
      else if (n.p && D.nodes[n.p]) html += `<div class="hint">after: ${D.nodes[n.p].n} (drawn there in game; the files declare no prerequisite)</div>`;
      html += `<div class="hint">click to plan · right-click researched · ⌥-click opens page</div>`;
      tip.innerHTML = html;
      tip.hidden = false;
      const r = tip.getBoundingClientRect();
      tip.style.left = Math.min(e.clientX + 14, innerWidth - r.width - 12) + 'px';
      tip.style.top = Math.min(e.clientY + 14, innerHeight - r.height - 12) + 'px';
    }
    function hideTipSoon() {
      clearTimeout(tipHide);
      tipHide = window.setTimeout(() => { if (!tip.matches(':hover')) { tip.hidden = true; tipFor = null; } }, 180);
    }
    tip.addEventListener('mouseleave', hideTipSoon);
    tip.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button') as HTMLElement | null;
      if (!b) return;
      if (b.dataset.assume) mutate(() => assertAtom(b.dataset.assume!, b.dataset.atom!, true));
      else if (b.dataset.as) mutate(() => setOne(b.dataset.as!, b.dataset.atom!));
      tip.hidden = true; tipFor = null;
    });

    // ── pickers ────────────────────────────────────────────────
    function wirePicker(sel: string,
                        items: (q: string) => { key: string; label: string; small?: string }[],
                        onPick: (key: string) => void) {
      const wrap = $(sel);
      const input = wrap.querySelector('input') as HTMLInputElement;
      const results = wrap.querySelector('.hdr-search__results') as HTMLElement;
      const refresh = () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { results.hidden = true; return; }
        const hits = items(q).slice(0, 12);
        results.innerHTML = hits.map((h) =>
          `<a href="#" data-key="${h.key}"><span>${h.label}</span><small>${h.small || ''}</small></a>`).join('');
        results.hidden = hits.length === 0;
      };
      input.addEventListener('input', refresh);
      input.addEventListener('focus', refresh);
      results.addEventListener('click', (e) => {
        e.preventDefault();
        const a = (e.target as HTMLElement).closest('[data-key]') as HTMLElement | null;
        if (!a) return;
        input.value = ''; results.hidden = true;
        mutate(() => onPick(a.dataset.key!));
      });
    }
    // one listener closes every picker's dropdown — the facts panel re-creates
    // its pickers on each render, so they must not each register their own
    document.addEventListener('click', (e) => {
      for (const w of root.querySelectorAll<HTMLElement>('.pl-picker')) {
        if (!w.contains(e.target as Node)) (w.querySelector('.hdr-search__results') as HTMLElement).hidden = true;
      }
    });

    function wirePickers() {
      wirePicker('[data-pl-country]',
        (q) => D.countries.filter((c) => c.n.toLowerCase().includes(q) || c.t.toLowerCase() === q)
          .map((c) => ({ key: c.t, label: c.n, small: `${c.cu} · ${c.re}` })),
        (tag) => {
          country = D.countries.find((c) => c.t === tag) || null;
          overrides = {};   // a new country resets every assertion
          invalidateFacts();
        });
      $('[data-pl-context]').addEventListener('click', (e) => {
        const tog = (e.target as HTMLElement).closest('[data-save-toggle]') as HTMLElement | null;
        if (tog) { setPref({ enabled: tog.dataset.saveToggle === 'on' }); return; }
        const chip = (e.target as HTMLElement).closest('[data-reset]') as HTMLElement | null;
        if (!chip) return;
        mutate(() => { delete overrides[chip.dataset.reset!]; invalidateFacts(); });
      });
      $('[data-pl-facts-toggle]').addEventListener('click', () => {
        const panel = $('[data-pl-facts]');
        panel.hidden = !panel.hidden;
        $('[data-pl-facts-toggle]').classList.toggle('on', !panel.hidden);
        renderFacts();
      });
      const panel = $('[data-pl-facts]');
      panel.addEventListener('change', (e) => {
        const sel = (e.target as HTMLElement).closest('[data-one]') as HTMLSelectElement | null;
        if (sel) mutate(() => setOne(sel.dataset.one!, sel.value));
      });
      panel.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const reset = t.closest('[data-reset]') as HTMLElement | null;
        if (reset) { mutate(() => { delete overrides[reset.dataset.reset!]; invalidateFacts(); }); return; }
        const more = t.closest('[data-more]') as HTMLElement | null;
        if (more) {
          const k = more.dataset.more!;
          if (factsShowAll.has(k)) factsShowAll.delete(k); else factsShowAll.add(k);
          renderFacts(); return;
        }
        const chip = t.closest('[data-atom]') as HTMLElement | null;
        if (chip) {
          const kind = (chip.closest('[data-kind]') as HTMLElement).dataset.kind!;
          const atom = chip.dataset.atom!;
          // unknown → ✓ → ✗ → unknown (a setup ✓ cycles to ✗ first)
          const cur = (effectiveFacts() as any)?.[kind]?.[atom] as boolean | undefined;
          const next = cur === undefined ? true : cur === true ? false : null;
          mutate(() => assertAtom(kind, atom, next));
        }
      });
    }

    // ── zoom (panes scroll on their own; no canvas dragging needed) ──
    function wireZoom() {
      for (const b of root.querySelectorAll<HTMLElement>('[data-zoom]')) {
        b.addEventListener('click', () => setZoom(b.dataset.zoom === '+' ? zoom * 1.15 : zoom / 1.15));
      }
    }
    function setZoom(z: number) {
      zoom = Math.min(1.4, Math.max(0.5, z));
      applyZoom();
    }
    function applyZoom() {
      for (const board of root.querySelectorAll<HTMLElement>('.pl-board')) {
        const w = parseFloat(board.style.width), h = parseFloat(board.style.height);
        board.style.transform = `scale(${zoom})`;
        board.style.marginRight = `${Math.max(0, w * zoom - w)}px`;
        board.style.marginBottom = `${Math.max(0, h * zoom - h)}px`;
      }
      ($('[data-zoom-label]') as HTMLElement).textContent = Math.round(zoom * 100) + '%';
    }

    /** children of an advance, across the whole age (index built per render) */
    let childIndex = new Map<string, string[]>();
    function kidsOf(id: string): string[] { return childIndex.get(id) || []; }

    // ── boot ───────────────────────────────────────────────────
    fetch(`${baseUrl}planner.json`).then((r) => r.json()).then((data) => {
      D = data;
      D.order.forEach((id, i) => idx.set(id, i));
      formables = D.formables || {};

      const p = new URLSearchParams(location.search);
      if (p.get('v') && p.get('v') !== D.vhash) {
        $('[data-pl-count]').textContent = '⚠ this link was made on another game version — the plan may have shifted.';
      }
      country = D.countries.find((c) => c.t === p.get('c')) || null;
      // An imported save is the default view: its seat, its researched
      // advances and its age fill in whatever the link does not say.
      const seat = activeSeat();
      if (seat) {
        if (!p.get('c')) country = D.countries.find((c) => c.t === seat.tag) || null;
        if (!p.get('r')) for (const k of seat.seat.researched) { const id = `advance:${k}`; if (D.nodes[id]) researched.add(id); }
        if (!p.get('age')) { const m = /age_(\d+)/.exec(seat.snap.age || ''); if (m) p.set('age', String(parseInt(m[1], 10) - 1)); }
        seeded = { c: seat.tag, r: enc(researched), age: p.get('age') };
      }
      onSaveChange(() => {
        // The save changed under us (toggled, re-imported, other tab):
        // drop what it seeded and reload so the new baseline applies.
        const q = new URLSearchParams(location.search);
        if (seeded && q.get('c') === seeded.c) q.delete('c');
        if (seeded && q.get('r') === seeded.r) q.delete('r');
        if (seeded && q.get('age') === seeded.age) q.delete('age');
        location.href = q.toString() ? `?${q}` : location.pathname;
      });
      overrides = overridesFromParams(p, D.kinds);   // also reads the old cu/re/g params
      showMode = p.get('all') === '1' ? 'all' : (p.get('show') || '');
      if (!['', 'sure', 'all'].includes(showMode)) showMode = '';
      ($('[data-pl-show]') as HTMLSelectElement).value = showMode;
      expanded = p.get('x') === '1';
      ($('[data-pl-expand]') as HTMLInputElement).checked = expanded;
      ageIx = Math.max(0, Math.min(D.ages.length - 1, parseInt(p.get('age') || '0', 10) || 0));
      (p.get('f') || '').split('.').forEach((f, i) => { if (FOCUS.some(([k]) => k === f)) focusOf.set(i, f); });
      dec(p.get('p'), planned);
      dec(p.get('r'), researched);

      wirePickers(); wireZoom();

      ($('[data-pl-show]') as HTMLSelectElement).addEventListener('change', (e) => {
        showMode = (e.target as HTMLSelectElement).value; render();
      });
      ($('[data-pl-expand]') as HTMLInputElement).addEventListener('change', (e) => {
        expanded = (e.target as HTMLInputElement).checked; render();
      });
      $('[data-pl-copy]').addEventListener('click', () => {
        navigator.clipboard.writeText(location.href);
        const b = $('[data-pl-copy]'); b.textContent = '✓ Copied';
        setTimeout(() => (b.textContent = '⧉ Copy link'), 1200);
      });
      $('[data-pl-clear]').addEventListener('click', () =>
        mutate(() => { planned.clear(); researched.clear(); }));
      $('[data-pl-ages]').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('[data-age]') as HTMLElement | null;
        if (b) { ageIx = +b.dataset.age!; render(); }
      });

      const board = $('[data-pl-panes]');
      board.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest('[data-id]') as HTMLElement | null;
        if (!el) return;
        const id = el.dataset.id!;
        if ((e as MouseEvent).altKey) { location.href = `${baseUrl}advances/${D.nodes[id].s}`; return; }
        mutate(() => { if (planned.has(id)) removeWithDependents(id); else addWithPrereqs(id); });
      });
      board.addEventListener('contextmenu', (e) => {
        const el = (e.target as HTMLElement).closest('[data-id]') as HTMLElement | null;
        if (!el) return;
        e.preventDefault();
        const id = el.dataset.id!;
        mutate(() => {
          if (researched.has(id)) researched.delete(id);
          else { researched.add(id); planned.delete(id); }
        });
      });
      // pane headers collapse their branch
      board.addEventListener('click', (e) => {
        const h = (e.target as HTMLElement).closest('[data-pane-toggle]') as HTMLElement | null;
        if (!h) return;
        const key = (h.closest('[data-pane]') as HTMLElement).dataset.pane!;
        if (collapsedPanes.has(key)) collapsedPanes.delete(key); else collapsedPanes.add(key);
        render();
      });
      // the age-focus picks are interactive too
      const choicesEl = $('[data-pl-choices]');
      choicesEl.addEventListener('click', (e) => {
        const f = (e.target as HTMLElement).closest('[data-focus]') as HTMLElement | null;
        if (f) { focusOf.set(ageIx, f.dataset.focus!); render(); }
      });

      let lit: string | null = null;
      board.addEventListener('mousemove', (e) => {
        const el = (e.target as HTMLElement).closest('[data-id]') as HTMLElement | null;
        if (el) { showTip(e as MouseEvent, el.dataset.id!); focusChain(el.dataset.id!); }
        else { hideTipSoon(); focusChain(null); }
      });
      board.addEventListener('mouseleave', () => { hideTipSoon(); focusChain(null); });

      /** Light up an advance's whole prerequisite chain (and what it leads
       *  to) and dim the rest — the fastest way to read "what do I need
       *  for this" off a dense board. */
      function focusChain(id: string | null) {
        if (id === lit) return;
        lit = id;
        const board = $('[data-pl-panes]');
        for (const el of board.querySelectorAll('.lit')) el.classList.remove('lit');
        if (!id) { board.classList.remove('focus'); return; }
        const chain = new Set<string>([id]);
        const up = [id];
        while (up.length) {
          const cur = up.pop()!;
          for (const r of D.nodes[cur] ? reqOf(cur) : []) if (!chain.has(r)) { chain.add(r); up.push(r); }
        }
        const down = [id];
        while (down.length) {
          const cur = down.pop()!;
          for (const c of kidsOf(cur)) if (!chain.has(c)) { chain.add(c); down.push(c); }
        }
        board.classList.add('focus');
        for (const cid of chain) {
          board.querySelector(`[data-id="${cid}"]`)?.classList.add('lit');
        }
        for (const path of board.querySelectorAll<SVGPathElement>('path[data-a]')) {
          if (chain.has(path.dataset.a!) && chain.has(path.dataset.b!)) path.classList.add('lit');
        }
      }

      $('[data-pl-undo]').addEventListener('click', undo);
      $('[data-pl-redo]').addEventListener('click', redo);
      document.addEventListener('keydown', (e) => {
        if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'z') {
          if (!((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'y')) return;
        }
        const t = e.target as HTMLElement;
        if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement) return;
        e.preventDefault();
        (e.shiftKey || e.key.toLowerCase() === 'y') ? redo() : undo();
      });

      render();
      pushHistory();          // baseline: whatever the URL asked for
    });
  </script>
</Base>
