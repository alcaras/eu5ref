---
import Base from '../layouts/Base.astro';
import ConceptLede from '../components/ConceptLede.astro';

import SectionTable from '../components/SectionTable.astro';
import data from '../data/missions.json';

const tasks = data.entities.reduce((n, e) => n + e.data.tasks.length, 0);
---
<Base title="Missions" active="missions" pageMark="📌" eyebrow="World"
  pageStats={[
    { label: 'mission packs', value: data.entities.length },
    { label: 'tasks', value: tasks },
    { label: 'offered at a time', value: 10 },
  ]}
  description="Every mission pack in Europa Universalis V and its tasks.">
  <ConceptLede slug="mission" />
  <SectionTable data={data} pagePrefix="missions" columns={[
    { key: 'name', label: 'Mission Pack', kind: 'name' },
    { key: 'playstyle', label: 'Playstyle', kind: 'facet' },
    { key: 'repeatable', label: 'Repeatable', kind: 'facet' },
    { key: 'chance', label: 'Chance', kind: 'num' },
    { key: 'task_names', label: 'Tasks', kind: 'chips' },
  ]} placeholder="Filter mission packs…" />
</Base>
