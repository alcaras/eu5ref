---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/events.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
const d = entity.data;
---
<Base title={entity.name} active="events" eyebrow={`Event · ${d.event_id}`}
  description={`${entity.name} — Europa Universalis V event options and outcomes.`}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    {d.options.length > 0 && (
      <div class="panel">
        <h3>Options</h3>
        <ul class="pairs">
          {d.options.map((o: any) => (
            <li style="display:block; margin-bottom:8px;">
              <div style="color: var(--text); font-weight: 600;">{o.name}</div>
              {o.effects.length > 0 && (
                <span class="chips" style="margin-top:3px;">
                  {o.effects.map((x: string) => <span class="chip">{x}</span>)}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
    <Fragment slot="aside">
      <div class="panel">
        <h3>Fires when</h3>
        <div class="kv">
          {d.gate_labels?.length > 0 && (
            <Fragment><span class="k">For</span><span class="v">{d.gate_labels.join(', ')}</span></Fragment>
          )}
          {d.years && (
            <Fragment><span class="k">Years</span><span class="v">{d.years.from || '?'} – {d.years.to || '?'}</span></Fragment>
          )}
          <span class="k">Once only</span><span class="v">{d.once ? 'yes' : 'no'}</span>
          {d.major && (<Fragment><span class="k">Major</span><span class="v">yes</span></Fragment>)}
        </div>
        {d.trigger?.length > 0 && (
          <ul style="margin: 8px 0 0; padding-left: 16px; font-size: 12.5px; color: var(--text-dim);">
            {d.trigger.map((t: string) => <li>{t}</li>)}
          </ul>
        )}
      </div>
    </Fragment>
  </EntityDetail>
</Base>
