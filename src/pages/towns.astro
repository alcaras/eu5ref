---
import Base from '../layouts/Base.astro';
import SectionTable from '../components/SectionTable.astro';
import ranks from '../data/location-ranks.json';
import rights from '../data/town-rights.json';

const base = import.meta.env.BASE_URL;
---
<Base title="Towns & Settlements" active="towns" pageMark="🏘️" eyebrow="Economy"
  pageStats={[
    { label: 'location ranks', value: ranks.entities.length },
    { label: 'town rights', value: rights.entities.length },
  ]}
  description="Location ranks and town rights in Europa Universalis V.">
  <SectionTable title="Location Ranks" data={ranks} columns={[
    { key: 'name', label: 'Rank', kind: 'name' },
    { key: 'mods', label: 'Modifiers', kind: 'mods' },
    { key: 'desc', label: 'Description', kind: 'rich' },
  ]} placeholder="Filter ranks…" />
  <p class="towns-note">
    <a href={`${base}urban-rights`}>Urban Rights →</a>
  </p>
</Base>

<style>
  .towns-note { margin-top: 26px; font-size: 13px; color: var(--text-dim); }
</style>
