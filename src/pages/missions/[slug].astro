---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/missions.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
---
<Base title={entity.name} active="missions" eyebrow="Mission Pack" iconSrc={entity.icon}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    <div class="panel">
      <h3>Tasks ({entity.data.tasks.length})</h3>
      <ul class="pairs">
        {entity.data.tasks.map((t: any) => (
          <li style="display:block; margin-bottom:6px;">
            <span style="color: var(--text); font-weight: 600;">{t.name}</span>
            {t.final && <span class="chip" style="margin-left:6px;">final</span>}
            {t.requires.length > 0 && (
              <span style="color: var(--text-faint); font-size:12px;"> · after {t.requires.join(', ')}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
    <Fragment slot="aside">
      <div class="panel">
        <h3>Data</h3>
        <div class="kv">
          <span class="k">Playstyle</span><span class="v">{entity.facets.playstyle ?? '—'}</span>
          <span class="k">Repeatable</span><span class="v">{entity.facets.repeatable}</span>
          <span class="k">Chance</span><span class="v">{entity.data.chance ?? '—'}</span>
        </div>
        {entity.data.requires_state?.length > 0 && (
          <ul style="margin: 8px 0 0; padding-left: 16px; font-size: 12.5px; color: var(--text-dim);">
            {entity.data.requires_state.map((r: string) => <li>{r}</li>)}
          </ul>
        )}
      </div>
    </Fragment>
  </EntityDetail>
</Base>
