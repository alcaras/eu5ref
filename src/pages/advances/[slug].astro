---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import Term from '../../components/Term.astro';
import data from '../../data/advances.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
const base = import.meta.env.BASE_URL;
// `for = adm|dip|mil` in the files: this advance only appears if you took that
// age focus at the start of the age.
const FOCUS_NAME: Record<string, string> = {
  adm: 'Administrative Focus', dip: 'Diplomatic Focus', mil: 'Military Focus',
};
const focus = FOCUS_NAME[(entity.data as any).specialization as string];

// Which tree the advance sits on, and whether that tree's root is an
// institution you must embrace or one of the ages' "always-available free
// trees" (the files' own words: Surgery, Pharmacology, Sanitation…).
// An advance with no `requires`, no `depth` and no `in_tree_of` is placed
// on no tree by the files — that is reported as such, not guessed at. Its
// gate is knowable either way: with no parent it can inherit no
// institution, and it declares no `allow` of its own.
const byId: Record<string, any> = Object.fromEntries(data.entities.map((e: any) => [e.id, e]));
const root = byId[(entity.data as any).branch_id];
const rootIsSelf = !root || root.id === entity.id;
const rootInstitution = !rootIsSelf && (root.data.requires_state || [])
  .some((r: string) => r.startsWith('has embraced institution: '));
const treeLabel = rootIsSelf
  ? 'not declared · no institution'
  : `${root.facets.branch} · ${rootInstitution ? 'institution' : 'free tree'}`;
---
<Base title={entity.name} active="advances" eyebrow={`Advance · ${entity.facets.age}`} iconSrc={entity.icon}>
  <EntityDetail entity={entity} backlinks={backlinks} modsTitle="Effects">
    {entity.data.unlocks?.length > 0 && (
      <div class="panel">
        <h3>Unlocks</h3>
        <div class="kv">
          {entity.data.unlocks.map((u: any) => (
            <Fragment>
              <span class="k">{u.label}</span>
              <span class="v">
                {u.items.map((it: any, i: number) => (
                  <Fragment>{i > 0 && ', '}{it.id ? <Term id={it.id} label={it.label} showIcon={false} /> : it.label}</Fragment>
                ))}
              </span>
            </Fragment>
          ))}
        </div>
      </div>
    )}
    <Fragment slot="aside">
      {(focus || entity.data.gate_labels?.length > 0 || entity.data.requires_state?.length > 0) && (
        <div class="panel">
          <h3>Availability</h3>
          <div class="kv">
            {focus && (
              <Fragment>
                <span class="k">Age focus</span>
                <span class="v"><a href={`${base}focuses`}>{focus}</a></span>
              </Fragment>
            )}
            {entity.data.gate_labels?.length > 0 && (
              <Fragment><span class="k">Only for</span><span class="v">{entity.data.gate_labels.join(', ')}</span></Fragment>
            )}
            {entity.data.requires_state?.map((rs: string) => (
              <Fragment><span class="k">Requires</span><span class="v">{rs}</span></Fragment>
            ))}
          </div>
        </div>
      )}
      {(
        <div class="panel">
          <h3>Position</h3>
          <div class="kv">
            {entity.data.requires.length > 0 && (
              <Fragment>
                <span class="k">Requires</span>
                <span class="v">{entity.data.requires.map((r: any, i: number) => (
                  <Fragment>{i > 0 && ', '}<Term id={r.id} label={r.label} showIcon={false} /></Fragment>
                ))}</span>
              </Fragment>
            )}
            <Fragment><span class="k">Tree</span><span class="v">{treeLabel}</span></Fragment>
            {entity.data.countries.length > 0 && (
              <Fragment><span class="k">Countries</span><span class="v">{entity.data.countries.join(', ')}</span></Fragment>
            )}
          </div>
        </div>
      )}
    </Fragment>
  </EntityDetail>
</Base>
