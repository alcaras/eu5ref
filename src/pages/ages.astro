---
import Base from '../layouts/Base.astro';
import SectionTable from '../components/SectionTable.astro';
import raw from '../data/ages.json';
import ConceptLede from '../components/ConceptLede.astro';


const base = import.meta.env.BASE_URL;

// The first age declares `year = 1` — i.e. it is already running at the
// campaign start — so it shows as the 1337 start date.
const data = {
  ...raw,
  entities: raw.entities.map((e: any) => ({
    ...e, data: { ...e.data, year: e.data.year === 1 ? 1337 : e.data.year },
  })),
};
---
<Base title="Ages" active="ages" pageMark="⏳" eyebrow="Ages & Advances"
  pageStats={[{ label: 'ages', value: data.entities.length }]}
  description="The ages of Europa Universalis V — start years, age modifiers, and advance efficiency.">
  <ConceptLede slug="age" />
  <SectionTable data={data} columns={[
    { key: 'name', label: 'Age', kind: 'name' },
    { key: 'year', label: 'Starts', kind: 'num' },
    { key: 'efficiency', label: 'Efficiency', kind: 'num' },
    { key: 'mods', label: 'Modifiers', kind: 'mods' },
    { key: 'desc', label: 'Description', kind: 'rich' },
  ]} defaultSort={{ key: 'year' }} placeholder="Filter ages…" />
</Base>

<style>
</style>
