---
import Base from '../layouts/Base.astro';
import { TABS, SECTIONS } from '../data/tabs';
const base = import.meta.env.BASE_URL;

const built = TABS.filter((t) => t.status === 'built').length;
const planned = TABS.filter((t) => t.status === 'placeholder').length;
---
<Base
  title="EU5 Reference"
  eyebrow="Europa Universalis V"
  pageStats={[
    { label: 'pages live', value: built },
    { label: 'pages planned', value: planned },
    { label: 'game version', value: '1.3.11' },
  ]}
>

  <div class="catalog">
    {SECTIONS.map((section) => {
      const tabs = TABS.filter((t) => t.section === section && t.status !== 'skipped');
      if (tabs.length === 0) return null;
      return (
        <section>
          <h2>{section}</h2>
          <div class="cards">
            {tabs.map((t) =>
              t.status === 'built' ? (
                <a class="card built" href={`${base}${t.slug}`}>
                  <span class="card-title">{t.icon} {t.label} <span class="badge">live</span></span>
                  <span class="card-sum">{t.summary}</span>
                </a>
              ) : (
                <a class="card placeholder" href={`${base}${t.slug}`}>
                  <span class="card-title">{t.icon} {t.label} <span class="badge">planned</span></span>
                  <span class="card-sum">{t.summary}</span>
                </a>
              )
            )}
          </div>
        </section>
      );
    })}
  </div>
</Base>
