---
import Base from '../layouts/Base.astro';
import EntityTable from '../components/EntityTable.astro';
import FilterBar from '../components/FilterBar.astro';
import data from '../data/advances.json';

// Flatten unlocks to chip labels for the table column.
const entities = data.entities.map((e) => ({
  ...e,
  data: {
    ...e.data,
    unlock_names: (e.data.unlocks || []).flatMap((u: any) => u.items.map((i: any) => i.label)).slice(0, 6),
  },
}));
const facets = data.facets;
const AGE_ORDER = ['Traditions','Renaissance','Discovery','Reformation','Absolutism','Revolutions'];
const columns = [
  { key: 'name', label: 'Advance', kind: 'name' },
  { key: 'age', label: 'Age', kind: 'facet' },
  { key: 'requires', label: 'Requires', kind: 'refs' },
  { key: 'mods', label: 'Effects', kind: 'mods' },
  { key: 'unlock_names', label: 'Unlocks', kind: 'chips' },
  { key: 'gate_labels', label: 'Only for', kind: 'chips' },
] as const;
---
<Base
  title="Advances"
  active="advances"
  pageMark="🔬"
  eyebrow="Ages & Advances"
  pageStats={[
    { label: 'advances', value: entities.length },
    { label: 'general', value: entities.filter((e) => e.facets.scope === 'general').length },
    { label: 'national / cultural', value: entities.filter((e) => e.facets.scope === 'national').length },
  ]}
  description="Every advance in Europa Universalis V — age, prerequisites, and effects."
>
  <div data-filter-scope>
    <FilterBar facets={facets} placeholder="Filter advances…" />
    <EntityTable entities={entities} columns={columns as any} pagePrefix="advances" defaultSort={{ key: "age" }} sortOrder={{ age: AGE_ORDER }} />
  </div>
</Base>
