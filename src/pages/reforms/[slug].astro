---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/reforms.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
---
<Base title={entity.name} active="government" eyebrow="Government Reform" iconSrc={entity.icon}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    <Fragment slot="aside">
      {entity.data.requires?.length > 0 && (
        <div class="panel">
          <h3>Requires</h3>
          <ul class="reqlist">
            {entity.data.requires.map((r: string) => <li>{r}</li>)}
          </ul>
        </div>
      )}
      <div class="panel">
        <h3>Availability</h3>
        <div class="kv">
          <Fragment><span class="k">Government</span><span class="v">{entity.facets.government || 'Any'}</span></Fragment>
          <Fragment><span class="k">Age</span><span class="v">{entity.facets.age}</span></Fragment>
          {entity.data.major && (
            <Fragment><span class="k">Major</span><span class="v">one per country, ever</span></Fragment>
          )}
          {entity.data.gate_labels?.length > 0 && (
            <Fragment><span class="k">Only for</span><span class="v">{entity.data.gate_labels.join(', ')}</span></Fragment>
          )}
        </div>
      </div>
    </Fragment>
  </EntityDetail>
</Base>
