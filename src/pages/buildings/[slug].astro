---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/buildings.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
---
<Base title={entity.name} active="buildings" eyebrow={`Building · ${entity.facets.category}`} iconSrc={entity.icon}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    {entity.data.production_methods.length > 0 && (
      <div class="panel">
        <h3>Production methods</h3>
        {[...new Set(entity.data.production_methods.map((pm: any) => pm.slot ?? 0))].map((slot) => (
          <div style="margin-bottom: 10px;">
            <div style="font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-faint); margin-bottom:4px;">
              Slot {(slot as number) + 1} — choose one
            </div>
            <ul class="pairs">
              {entity.data.production_methods.filter((pm: any) => (pm.slot ?? 0) === slot).map((pm: any) => (
                <li style="display:block; margin-bottom:3px;">
                  <span style="color: var(--text); font-weight:600;">{pm.name}</span>
                  <span style="color: var(--text-dim);">
                    {' — '}
                    {pm.inputs.map((i: any) => `${i.amount} ${i.good}`).join(' + ') || 'no inputs'}
                    {pm.output ? ` → ${pm.output.amount} ${pm.output.good}` : ''}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
    <Fragment slot="aside">
      <div class="panel">
        <h3>Data</h3>
        <div class="kv">
          <span class="k">Max levels</span><span class="v">{entity.data.max_levels ?? '—'}</span>
          <span class="k">Settlements</span><span class="v">{entity.data.settlements.join(', ') || '—'}</span>
          <span class="k">Special</span><span class="v">{entity.data.special ? 'yes' : 'no'}</span>
        </div>
      </div>
    </Fragment>
  </EntityDetail>
</Base>
