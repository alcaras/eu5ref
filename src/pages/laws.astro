---
import Base from '../layouts/Base.astro';
import EntityTable from '../components/EntityTable.astro';
import FilterBar from '../components/FilterBar.astro';
import CountryLens from '../components/CountryLens.astro';
import data from '../data/laws.json';

const entities = data.entities;
const facets = data.facets;
const columns = [
  { key: 'name', label: 'Law', kind: 'name' },
  { key: 'category', label: 'Category', kind: 'facet' },
  { key: 'government', label: 'Government', kind: 'facet' },
  { key: 'policy_names', label: 'Policies', kind: 'chips' },
  { key: 'requires', label: 'Requires', kind: 'lines' },
  { key: 'excludes', label: 'Conflicts with', kind: 'lines' },
] as const;
---
<Base
  title="Laws & Policies"
  active="laws"
  pageMark="⚖️"
  eyebrow="Government & Laws"
  pageStats={[
    { label: 'law groups', value: entities.length },
    { label: 'policies', value: entities.reduce((n, e) => n + e.data.policies.length, 0) },
  ]}
  description="Every law group and its selectable policies in Europa Universalis V."
>
  <div data-filter-scope>
    <CountryLens placeholder="Show what a country can pass…" />
    <FilterBar facets={facets} placeholder="Filter laws…" />
    <EntityTable entities={entities} columns={columns as any} pagePrefix="laws" />
  </div>
</Base>
