---
import Base from '../layouts/Base.astro';
---
<Base title="Battle Simulator" active="battle-simulator" pageMark="⚔️" eyebrow="Tools"
  description="Build two land armies — levies or regulars — pick the terrain, and Monte-Carlo the battle with the game's own combat constants.">

  <p style="max-width: 780px; color: var(--text-soft);">
    Build two armies out of the game's actual unit types, set the battlefield,
    and this simulates the battle hour by hour the way the engine describes it:
    a d10 dice phase every 5 hours, initiative rolls to engage, d20 combat-speed
    rolls to leave the reserves, four sections per side, flanking, combined
    arms, and the levy-vs-regular efficiency gap. Every constant comes from the
    game's defines; run it a few hundred times and read the distribution.
  </p>
  <p style="max-width: 780px; color: var(--text-dim); font-size: 13px;">
    <b>Honesty note:</b> the phase structure, engagement chances and every
    multiplier in the damage chain are the game's own (defines + concept text +
    the battle tooltip's factor list). What the files do <em>not</em> give is
    the exact composition of those multipliers, section frontage splitting, and
    target selection — those follow the most reasonable reading and are
    labelled in the model notes below. Treat outcomes as a strong estimate, not
    a replay of the engine.
  </p>

  <div class="bs" data-bs>
    <div class="bs-controls">
      <label class="bs-lbl">Topography
        <select data-bs-topo></select>
      </label>
      <label class="bs-lbl">Vegetation
        <select data-bs-veg></select>
      </label>
      <label class="bs-lbl">Attacker
        <select data-bs-atk>
          <option value="A">Army A attacks</option>
          <option value="B">Army B attacks</option>
        </select>
      </label>
      <label class="bs-lbl">Crossing
        <select data-bs-cross>
          <option value="">none</option>
          <option value="river">river (−1 dice)</option>
          <option value="strait">strait (−2 dice)</option>
          <option value="sea">sea landing (−1 dice)</option>
        </select>
      </label>
      <span class="chips" data-bs-frontage></span>
      <span class="pl-spacer"></span>
      <label class="bs-lbl">runs <input type="number" data-bs-runs value="500" min="50" max="5000" step="50" class="bs-num" style="width:64px" /></label>
      <label class="bs-lbl">seed <input type="number" data-bs-seed value="1337" class="bs-num" style="width:70px" /></label>
      <button type="button" class="csv-btn" data-bs-copy>⧉ Copy link</button>
      <button type="button" class="csv-btn" data-bs-clear>✕ Reset</button>
    </div>

    <div class="bs-grid">
      <section class="bs-pane" data-bs-side="A"></section>
      <section class="bs-pane" data-bs-side="B"></section>
    </div>

    <section class="bs-pane bs-results">
      <h2 class="bs-h">Outcome <small data-bs-runinfo></small></h2>
      <div data-bs-out><p class="bs-empty">Add regiments to both armies to run the simulation.</p></div>
      <details class="bs-log-wrap"><summary>Inspect one battle (first run)</summary>
        <div class="bs-log" data-bs-log></div>
      </details>
    </section>

    <details class="bs-notes">
      <summary>Model notes — what is exact, what is inferred</summary>
      <div data-bs-notes></div>
    </details>
  </div>

  <style is:global>
    .bs-controls { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 16px; }
    .bs-lbl { display: inline-flex; gap: 6px; align-items: center; font-size: 12px; color: var(--text-dim); }
    .bs select, .bs input[type="number"], .bs input[type="search"] {
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: var(--radius-sm, 4px); padding: 4px 8px; font-size: 12.5px; font-family: var(--font-ui);
    }
    .bs select:focus, .bs input:focus { outline: none; border-color: var(--gold-deep); }
    .bs-num { font-family: var(--font-mono) !important; }
    .bs-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 22px; margin-top: 14px; }
    @media (max-width: 980px) { .bs-grid { grid-template-columns: 1fr; } }
    .bs-pane { min-width: 0; border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; background: var(--bg-elev); }
    .bs-h { font-size: 15px; color: var(--gold-soft, var(--gold)); margin-bottom: 8px; }
    .bs-h small { font-family: var(--font-ui); font-size: 11px; color: var(--text-faint); margin-left: 8px; font-weight: 400; }
    .bs-addrow { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin: 8px 0; }
    .bs-addrow select { max-width: 260px; }
    .bs-regs { display: flex; flex-direction: column; gap: 2px; margin: 6px 0; }
    .bs-reg { display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 3px 6px; border-radius: 4px; background: var(--bg-elev-2); }
    .bs-reg .nm { color: var(--text); }
    .bs-reg .meta { color: var(--text-faint); font-size: 11px; }
    .bs-reg .cnt { margin-left: auto; display: inline-flex; gap: 4px; align-items: center; font-family: var(--font-mono); font-size: 12px; }
    .bs-reg button { background: none; border: 1px solid var(--border); color: var(--text-dim); border-radius: 3px; cursor: pointer; font-size: 11px; padding: 0 6px; line-height: 18px; }
    .bs-reg button:hover { color: var(--gold); border-color: var(--gold-deep); }
    .bs-src-levy { color: #d9a066; } .bs-src-reg { color: #7fb069; }
    .bs-sum { font-size: 12px; color: var(--text-dim); margin: 6px 0; display: flex; gap: 14px; flex-wrap: wrap; }
    .bs-sum b { color: var(--text); font-family: var(--font-mono); font-weight: 500; }
    .bs-modgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px 12px; margin-top: 6px; }
    .bs-modgrid label { display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 11.5px; color: var(--text-dim); }
    .bs-modgrid input { width: 62px; text-align: right; font-family: var(--font-mono); font-size: 11.5px; padding: 2px 5px; }
    .bs-traits { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
    .bs-trait { font-size: 11px; padding: 2px 8px; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; color: var(--text-dim); background: var(--bg-elev-2); }
    .bs-trait.on { color: var(--gold); border-color: var(--gold-deep); background: var(--gold-glow, rgba(200,160,60,.12)); }
    .bs-trait.gated { opacity: .45; }
    .bs details { margin-top: 8px; }
    .bs details summary { cursor: pointer; font-size: 12px; color: var(--text-dim); }
    .bs-results { margin-top: 22px; }
    .bs-empty { color: var(--text-faint); font-size: 13px; }
    .bs-bar { display: flex; height: 26px; border-radius: 5px; overflow: hidden; margin: 8px 0; font-size: 12px; font-family: var(--font-mono); }
    .bs-bar div { display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; color: #10131c; font-weight: 600; }
    .bs-bar .wa { background: #7fb069; } .bs-bar .wb { background: #c66b5a; } .bs-bar .wd { background: #8a8fa3; }
    .bs-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin-top: 10px; }
    .bs-stat { border: 1px solid var(--border); border-radius: var(--radius); padding: 8px 10px; background: var(--bg-elev-2); font-size: 12px; color: var(--text-dim); }
    .bs-stat b { display: block; font-family: var(--font-mono); font-size: 15px; color: var(--text); font-weight: 500; margin-top: 2px; }
    .bs-log-wrap { margin-top: 12px; }
    .bs-log { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); max-height: 320px; overflow-y: auto; margin-top: 8px; line-height: 1.55; white-space: pre-wrap; }
    .bs-notes { margin-top: 20px; max-width: 900px; }
    .bs-notes table { font-size: 12px; border-collapse: collapse; margin-top: 8px; }
    .bs-notes td, .bs-notes th { border: 1px solid var(--border); padding: 3px 9px; text-align: left; color: var(--text-dim); }
    .bs-notes th { color: var(--text-soft); font-weight: 600; }
    .bs-notes code { font-size: 11px; }
    .bs-notes .inf { color: #d9a066; }
  </style>

  <script>
    import {
      simulate, mulberry32, blankSide, MOD_DEFAULTS, combinedArms,
      terrainFrontage, defenderDice, crossDice,
      type SideSpec, type BattleConfig,
    } from '../lib/battle-engine';

    const root = document.querySelector('[data-bs]')!;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const baseUrl = document.querySelector('.site-title a')!.getAttribute('href')!;
    const esc = (t: any) => String(t).replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);

    let D: any = null;         // battle.json
    const AGE_ORDER = ['age_1_traditions','age_2_renaissance','age_3_discovery',
                       'age_4_reformation','age_5_absolutism','age_6_revolutions'];

    // ── state ────────────────────────────────────────────────────────────
    const MOD_DEFS: [string, string, string][] = [
      ['disc',  'discipline %',      'Sum of country discipline modifiers. Levy regiments get a further −10% (is_army_levy).'],
      ['tact',  'military tactics',  'Flat, base 1.0 (country_base_values). Reduces damage taken.'],
      ['mor',   'land morale %',     'land_morale_modifier — max morale is 3.0 × (1 + this).'],
      ['init',  'army initiative %', 'army_initiative — scales unit initiative for the engage roll.'],
      ['cspd',  'combat speed %',    'combat_speed_modifier — scales the d20 reserve roll.'],
      ['front', 'frontage %',        'possible_frontage_modifier.'],
      ['levy',  'levy efficiency %', 'levy_combat_efficiency_modifier — on top of the 0.75 base.'],
      ['exp',   'experience',        '0–100. Damage taken ×(1 − exp/100 × 0.5).'],
      ['powInf','infantry power %',  'army_light/heavy_infantry_power (applied to both).'],
      ['powCav','cavalry power %',   'army_light/heavy_cavalry_power (applied to both).'],
      ['powArt','artillery power %', 'army_artillery_power.'],
      ['dice',  'general dice bonus','commander_combat_bonus — flat on every phase dice. Traits add on top.'],
    ];
    const S: Record<string, SideSpec> = { A: blankSide(), B: blankSide() };
    let topo = 'flatland', veg = 'grasslands', attacker: 'A' | 'B' = 'A';
    let crossing: BattleConfig['crossing'] = '';
    let runs = 500, seed = 1337;
    const cfg = (): BattleConfig => ({ topo, veg, attacker, crossing });

    // ── url state ────────────────────────────────────────────────────────
    function encSide(s: SideSpec) {
      const parts = [s.regs.map(r => `${r.u}.${r.n}`).join('~') || '-'];
      const mods = MOD_DEFS.filter(([k]) => s.mods[k] !== MOD_DEFAULTS[k])
        .map(([k]) => `${k}_${s.mods[k]}`).join('~');
      parts.push(mods || '-');
      parts.push(s.traits.join('~') || '-');
      parts.push(s.formation);
      parts.push(String(s.retreat));
      return parts.join('!');
    }
    function decSide(str: string): SideSpec {
      const s = blankSide();
      const [regs, mods, traits, formation, retreat] = str.split('!');
      if (regs && regs !== '-') s.regs = regs.split('~').map(p => {
        const i = p.lastIndexOf('.');
        return { u: p.slice(0, i), n: Math.max(1, parseInt(p.slice(i + 1)) || 1) };
      }).filter(r => D.units[r.u]);
      if (mods && mods !== '-') for (const m of mods.split('~')) {
        const i = m.indexOf('_');
        const k = m.slice(0, i), v = parseFloat(m.slice(i + 1));
        if (k in s.mods && isFinite(v)) s.mods[k] = v;
      }
      if (traits && traits !== '-') s.traits = traits.split('~').filter(t => D.traits.some((x: any) => x.key === t));
      if (formation && D.formations[formation]) s.formation = formation;
      const r = parseFloat(retreat); if (isFinite(r)) s.retreat = r;
      return s;
    }
    function syncUrl() {
      const p = new URLSearchParams();
      if (topo !== 'flatland') p.set('t', topo);
      if (veg !== 'grasslands') p.set('v', veg);
      if (attacker !== 'A') p.set('atk', attacker);
      if (crossing) p.set('x', crossing);
      if (runs !== 500) p.set('n', String(runs));
      if (seed !== 1337) p.set('s', String(seed));
      if (S.A.regs.length || S.B.regs.length) { p.set('a', encSide(S.A)); p.set('b', encSide(S.B)); }
      history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
    }
    function readUrl() {
      const p = new URLSearchParams(location.search);
      if (p.get('t') && D.terrain.topography[p.get('t')!]) topo = p.get('t')!;
      if (p.get('v') && D.terrain.vegetation[p.get('v')!]) veg = p.get('v')!;
      if (p.get('atk') === 'B') attacker = 'B';
      if (['river','strait','sea'].includes(p.get('x') || '')) crossing = p.get('x') as any;
      const n = parseInt(p.get('n') || ''); if (n >= 50 && n <= 5000) runs = n;
      const sd = parseInt(p.get('s') || ''); if (isFinite(sd)) seed = sd;
      if (p.get('a')) S.A = decSide(p.get('a')!);
      if (p.get('b')) S.B = decSide(p.get('b')!);
    }

    // ── monte carlo + results ────────────────────────────────────────────
    let runTimer: any = null;
    function scheduleRun() { clearTimeout(runTimer); runTimer = setTimeout(runAll, 180); syncUrl(); }
    function runAll() {
      const out = $('[data-bs-out]');
      renderFrontage();
      if (!S.A.regs.length || !S.B.regs.length) {
        out.innerHTML = '<p class="bs-empty">Add regiments to both armies to run the simulation.</p>';
        $('[data-bs-log]').textContent = '';
        $('[data-bs-runinfo]').textContent = '';
        return;
      }
      const t0 = performance.now();
      const res: any[] = [];
      const firstLog: string[] = [];
      for (let i = 0; i < runs; i++) {
        const rand = mulberry32(seed + i * 7919);
        res.push(simulate(D, cfg(), S as any, rand, i === 0 ? firstLog : undefined));
      }
      const ms = performance.now() - t0;
      const n = res.length;
      const wA = res.filter(r => r.winner === 'A').length;
      const wB = res.filter(r => r.winner === 'B').length;
      const wd = n - wA - wB;
      const pct = (x: number) => `${(100 * x / n).toFixed(1)}%`;
      const qs = (arr: number[], q: number) => {
        const s2 = [...arr].sort((a, b) => a - b);
        return s2[Math.min(s2.length - 1, Math.floor(q * s2.length))];
      };
      const hrs = res.map(r => r.hours);
      const lostA = res.map(r => r.lost.A), lostB = res.map(r => r.lost.B);
      const avg = (a: number[]) => a.reduce((t, x) => t + x, 0) / a.length;
      const men = (x: number) => Math.round(x).toLocaleString();
      const startA = res[0].start.A, startB = res[0].start.B;
      out.innerHTML = `
        <div class="bs-bar">
          ${wA ? `<div class="wa" style="flex:${wA}">A ${pct(wA)}</div>` : ''}
          ${wd ? `<div class="wd" style="flex:${wd}">${pct(wd)}</div>` : ''}
          ${wB ? `<div class="wb" style="flex:${wB}">B ${pct(wB)}</div>` : ''}
        </div>
        <div class="bs-stats">
          <div class="bs-stat">Battle length<b>${avg(hrs).toFixed(0)} h avg · ${qs(hrs,0.1)}–${qs(hrs,0.9)} h</b></div>
          <div class="bs-stat">Army A losses (of ${men(startA)})<b>${men(avg(lostA))} avg · ${men(qs(lostA,0.1))}–${men(qs(lostA,0.9))}</b></div>
          <div class="bs-stat">Army B losses (of ${men(startB)})<b>${men(avg(lostB))} avg · ${men(qs(lostB,0.1))}–${men(qs(lostB,0.9))}</b></div>
        </div>`;
      $('[data-bs-runinfo]').textContent = `${n} runs · seed ${seed} · ${ms.toFixed(0)} ms`;
      $('[data-bs-log]').textContent = firstLog.join('\n');
    }

    // ── ui ───────────────────────────────────────────────────────────────
    function renderFrontage() {
      const f = terrainFrontage(D, cfg());
      const dd = defenderDice(D, cfg());
      $('[data-bs-frontage]').innerHTML =
        `<span class="chip">frontage ${f}</span>` +
        (dd ? `<span class="chip">defender +${dd} dice</span>` : '') +
        (crossing ? `<span class="chip">attacker ${crossDice(D, cfg())} dice</span>` : '');
    }

    function unitLabel(key: string) {
      const u = D.units[key];
      const age = u.age && D.ages[u.age] ? D.ages[u.age].name : '—';
      return `${u.name} (${D.categories[u.cat]?.name || u.cat}, ${age})`;
    }

    function renderSide(sd: string) {
      const pane = root.querySelector(`[data-bs-side="${sd}"]`) as HTMLElement;
      const s = S[sd];
      const men = s.regs.reduce((t, r) => t + (D.units[r.u].stats.max_strength || 0) * D.defines.REGIMENT_SIZE * r.n, 0);
      const fr = s.regs.reduce((t, r) => t + (D.units[r.u].stats.frontage || 1) * r.n, 0);
      const ca = combinedArms(D, s);
      const regRows = s.regs.map((r, i) => {
        const u = D.units[r.u];
        return `<div class="bs-reg">
          <span class="nm">${esc(u.name)}</span>
          <span class="meta">${esc(D.categories[u.cat]?.name || '')} · <span class="${u.levy ? 'bs-src-levy' : 'bs-src-reg'}">${u.levy ? 'levy' : 'regular'}</span>${u.gate ? ` · ${esc(u.gate.join(', '))}` : ''}</span>
          <span class="cnt">
            <button data-a="dec" data-i="${i}">−</button>×${r.n}<button data-a="inc" data-i="${i}">+</button>
            <button data-a="del" data-i="${i}" title="remove">✕</button>
          </span>
        </div>`;
      }).join('') || '<p class="bs-empty">No regiments yet.</p>';

      const ageOpts = ['', ...AGE_ORDER].map(a =>
        `<option value="${a}">${a ? D.ages[a].name : 'all ages'}</option>`).join('');
      const modInputs = MOD_DEFS.map(([k, label, title]) =>
        `<label title="${esc(title)}">${esc(label)}
          <input type="number" step="any" data-mod="${k}" value="${s.mods[k]}" ${s.mods[k] !== MOD_DEFAULTS[k] ? 'style="border-color:var(--gold-deep)"' : ''} />
        </label>`).join('');
      const traitChips = D.traits.map((t: any) => {
        const on = s.traits.includes(t.key);
        const gated = t.needs && !t.needs.some((cat: string) => s.regs.some(r => D.units[r.u].cat === cat));
        const mods = Object.entries(t.mods).map(([k, v]) => `${k} ${v}`).join(', ');
        return `<span class="bs-trait ${on ? 'on' : ''} ${gated ? 'gated' : ''}" data-trait="${t.key}"
          title="${esc(mods)}${t.needs ? ` — needs ${t.needs.join(' or ')} in the army` : ''}">${esc(t.name)}</span>`;
      }).join('');
      const formOpts = Object.keys(D.formations).map(f2 =>
        `<option value="${f2}" ${s.formation === f2 ? 'selected' : ''}>${f2.replace(/_/g, ' ')}</option>`).join('');

      pane.innerHTML = `
        <h2 class="bs-h">Army ${sd} <small><b>${Math.round(men).toLocaleString()}</b> men · ${s.regs.reduce((t, r) => t + r.n, 0)} regiments · frontage need ${fr.toFixed(1)}${ca ? ` · combined arms +${(ca * 100).toFixed(1)}%` : ''}</small></h2>
        <div class="bs-addrow">
          <select data-add-age>${ageOpts}</select>
          <select data-add-unit></select>
          <input type="number" data-add-n value="5" min="1" max="200" class="bs-num" style="width:56px" />
          <button type="button" class="csv-btn" data-add>+ Add</button>
        </div>
        <div class="bs-regs">${regRows}</div>
        <details open><summary>Country &amp; general modifiers</summary>
          <div class="bs-modgrid">${modInputs}
            <label title="Auto-retreat when average front-line morale drops below this (after the 24 h lock). 0 = fight to collapse.">retreat below morale %
              <input type="number" data-retreat value="${s.retreat}" min="0" max="90" step="5" />
            </label>
          </div>
          <div class="bs-traits">${traitChips}</div>
          <label class="bs-lbl" style="margin-top:8px">formation <select data-formation>${formOpts}</select></label>
        </details>`;

      const unitSel = pane.querySelector('[data-add-unit]') as HTMLSelectElement;
      const ageSel = pane.querySelector('[data-add-age]') as HTMLSelectElement;
      const fillUnits = () => {
        const age = ageSel.value;
        const groups: Record<string, string[]> = { 'Levies': [], 'Regulars': [] };
        for (const [key, u] of Object.entries(D.units) as [string, any][]) {
          if (age && u.age !== age) continue;
          groups[u.levy ? 'Levies' : 'Regulars'].push(key);
        }
        unitSel.innerHTML = Object.entries(groups).map(([g, keys]) =>
          `<optgroup label="${g}">${keys.sort((a, b) => D.units[a].name.localeCompare(D.units[b].name))
            .map(k => `<option value="${k}">${esc(unitLabel(k))}</option>`).join('')}</optgroup>`).join('');
      };
      ageSel.value = 'age_1_traditions'; fillUnits();
      ageSel.addEventListener('change', fillUnits);
      pane.querySelector('[data-add]')!.addEventListener('click', () => {
        const u = unitSel.value; if (!u) return;
        const n = Math.max(1, parseInt((pane.querySelector('[data-add-n]') as HTMLInputElement).value) || 1);
        const ex = s.regs.find(r => r.u === u);
        if (ex) ex.n += n; else s.regs.push({ u, n });
        renderSide(sd); scheduleRun();
      });
      pane.querySelectorAll('.bs-reg button').forEach(b => b.addEventListener('click', () => {
        const i = parseInt((b as HTMLElement).dataset.i!);
        const a = (b as HTMLElement).dataset.a;
        if (a === 'inc') s.regs[i].n++;
        else if (a === 'dec') { s.regs[i].n--; if (s.regs[i].n <= 0) s.regs.splice(i, 1); }
        else s.regs.splice(i, 1);
        renderSide(sd); scheduleRun();
      }));
      pane.querySelectorAll('[data-mod]').forEach(inp => inp.addEventListener('change', () => {
        const k = (inp as HTMLElement).dataset.mod!;
        s.mods[k] = parseFloat((inp as HTMLInputElement).value) || 0;
        scheduleRun();
      }));
      pane.querySelector('[data-retreat]')!.addEventListener('change', (e) => {
        s.retreat = parseFloat((e.target as HTMLInputElement).value) || 0; scheduleRun();
      });
      pane.querySelectorAll('[data-trait]').forEach(el => el.addEventListener('click', () => {
        const k = (el as HTMLElement).dataset.trait!;
        const i = s.traits.indexOf(k);
        if (i >= 0) s.traits.splice(i, 1); else s.traits.push(k);
        renderSide(sd); scheduleRun();
      }));
      pane.querySelector('[data-formation]')!.addEventListener('change', (e) => {
        s.formation = (e.target as HTMLSelectElement).value; scheduleRun();
      });
    }

    function renderNotes() {
      const d = D.defines;
      const rows: [string, string, string][] = [
        ['Dice', `d${d.COMBAT_DICE_SIDE}, base ${d.COMBAT_BASE}, capped ${d.COMBAT_MAX}, re-rolled every ${d.HOURS_PER_PHASE} h`, 'exact (NCombat)'],
        ['Damage scale', `dice × ${d.COMBAT_DAMAGE_MULT} × combat power × strength; ×${d.LAND_STRENGTH_DAMAGE_MODIFIER} strength, ×${d.LAND_MORALE_DAMAGE_MODIFIER} morale`, 'exact (NCombat)'],
        ['Levy efficiency', `${d.LAND_LEVY_COMBAT_IMPACT} × (1 + levy efficiency mod); regulars deal 1/eff vs levies. Levies also get ${D.sources.levy.discipline} discipline`, 'exact (defines + tooltip + is_army_levy)'],
        ['Engagement', `d100 < ${d.INITIATIVE_BASE_CHANCE} + min(init × ${d.INITIATIVE_CHANCE_EACH}, ${d.INITIATIVE_CHANCE_MAX}) + hours × ${d.INITIATIVE_CHANCE_HOURS}`, 'exact (concept text + defines)'],
        ['Reserves', `d20 vs combat speed (${d.COMBAT_SPEED_SCALE}/point per hour), highest combat power first`, 'exact (concept text)'],
        ['Frontage', `base ${D.baseFrontage} + terrain, floor ${d.MIN_FRONTAGE_AFTER_TERRAIN}, × (1 + possible_frontage_modifier)`, 'exact (location_base_values + terrain)'],
        ['Section split', 'side frontage ÷ 3 per front section, × the formation\'s 1.25 overstack', '<span class="inf">inferred</span>'],
        ['Multiplier chain', 'the tooltip\'s factor list (discipline, tactics, powers, terrain, flanking, secure flanks, experience, combined arms, not-engaged) applied multiplicatively', '<span class="inf">inferred composition</span> of exact factors'],
        ['Morale scale', 'damage × attacker morale / max morale', '<span class="inf">inferred</span> (listed as "Morale vs Base Morale")'],
        ['Target pick', 'random engaged regiment in the mirror section; adjacent section (with flanking bonus) when it is empty', '<span class="inf">inferred</span> (concept text gives the structure, not the pick)'],
        ['Commander', 'flat dice bonus input (+ traits). The engine also has a martial-difference "shock" term whose scaling is not in the files — fold it into the dice bonus yourself', '<span class="inf">not modelled</span>'],
        ['Collapse / retreat', `regiment breaks at ${d.MORALE_COLLAPSE_THRESHOLD * 100}% morale or 0 men; retreat locked ${d.MINIMUM_COMBAT_DURATION} h; loser takes ${d.RETREAT_STRENGTH_DAMAGE * 100}% retreat losses`, 'exact (NCombat)'],
        ['Morale attrition', `engaged units lose ${d.COMBAT_HOURLY_MORALE_TICK}/h`, 'exact constant, <span class="inf">inferred targeting</span>'],
        ['Not simulated', 'mercenaries, reinforcement mid-battle from outside, war-score/prestige effects, assault/siege, naval', '—'],
      ];
      $('[data-bs-notes]').innerHTML = `<table><tr><th>Piece</th><th>Model</th><th>Provenance</th></tr>
        ${rows.map(([a, b, c]) => `<tr><td>${a}</td><td>${b}</td><td>${c}</td></tr>`).join('')}</table>`;
    }

    function syncControlValues() {
      ($('[data-bs-topo]') as HTMLSelectElement).value = topo;
      ($('[data-bs-veg]') as HTMLSelectElement).value = veg;
      ($('[data-bs-atk]') as HTMLSelectElement).value = attacker;
      ($('[data-bs-cross]') as HTMLSelectElement).value = crossing;
      ($('[data-bs-runs]') as HTMLInputElement).value = String(runs);
      ($('[data-bs-seed]') as HTMLInputElement).value = String(seed);
    }
    function renderControls() {
      const topoSel = $('[data-bs-topo]') as HTMLSelectElement;
      const vegSel = $('[data-bs-veg]') as HTMLSelectElement;
      topoSel.innerHTML = Object.entries(D.terrain.topography)
        .filter(([k]) => !['ocean', 'inland_sea', 'narrows', 'atoll'].includes(k))
        .map(([k, t]: any) => `<option value="${k}">${esc(t.name)}${t.defender ? ` (+${t.defender} def)` : ''}${t.frontage ? ` (${t.frontage} frontage)` : ''}</option>`).join('');
      vegSel.innerHTML = Object.entries(D.terrain.vegetation)
        .map(([k, t]: any) => `<option value="${k}">${esc(t.name)}${t.defender ? ` (+${t.defender} def)` : ''}${t.frontage ? ` (${t.frontage} frontage)` : ''}</option>`).join('');
      syncControlValues();
      topoSel.addEventListener('change', () => { topo = topoSel.value; scheduleRun(); });
      vegSel.addEventListener('change', () => { veg = vegSel.value; scheduleRun(); });
      $('[data-bs-atk]').addEventListener('change', (e) => { attacker = (e.target as HTMLSelectElement).value as any; scheduleRun(); });
      $('[data-bs-cross]').addEventListener('change', (e) => { crossing = (e.target as HTMLSelectElement).value as any; scheduleRun(); });
      $('[data-bs-runs]').addEventListener('change', (e) => { runs = Math.max(50, Math.min(5000, parseInt((e.target as HTMLInputElement).value) || 500)); scheduleRun(); });
      $('[data-bs-seed]').addEventListener('change', (e) => { seed = parseInt((e.target as HTMLInputElement).value) || 1337; scheduleRun(); });
      $('[data-bs-copy]').addEventListener('click', () => {
        syncUrl(); navigator.clipboard?.writeText(location.href);
        ($('[data-bs-copy]') as HTMLElement).textContent = '✓ Copied';
        setTimeout(() => { ($('[data-bs-copy]') as HTMLElement).textContent = '⧉ Copy link'; }, 1200);
      });
      $('[data-bs-clear]').addEventListener('click', () => {
        S.A = blankSide(); S.B = blankSide();
        topo = 'flatland'; veg = 'grasslands'; attacker = 'A'; crossing = '';
        syncControlValues(); renderSide('A'); renderSide('B'); scheduleRun();
      });
    }

    fetch(`${baseUrl}battle.json`).then(r => r.json()).then(data => {
      D = data;
      readUrl();
      renderControls();
      renderSide('A'); renderSide('B');
      renderNotes();
      runAll();
    });
  </script>
</Base>
