---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import data from '../../data/religions.json';
import backlinksData from '../../data/backlinks.json';

export function getStaticPaths() {
  return data.entities.map((e) => ({ params: { slug: e.slug }, props: { entity: e } }));
}
const { entity } = Astro.props;
const backlinks = (backlinksData as Record<string, any[]>)[entity.id] || [];
---
<Base title={entity.name} active="religions" eyebrow={`Religion · ${entity.facets.group}`}>
  <EntityDetail entity={entity} backlinks={backlinks}>
    <Fragment slot="aside">
      {entity.data.mechanics.length > 0 && (
        <div class="panel">
          <h3>Mechanics</h3>
          <span class="chips">
            {entity.data.mechanics.map((m: string) => <span class="chip">{m.replace(/_/g, ' ')}</span>)}
          </span>
        </div>
      )}
    </Fragment>
  </EntityDetail>
</Base>
